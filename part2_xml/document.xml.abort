<table id="_752af9c2-1708-2562-d240-ae84e0bd10b8" width="100%"><colgroup><col width="19%"/><col width="81%"/></colgroup><thead><tr id="_ef19da3e-432e-c9c7-05f9-190459723980"><th id="_54f3575e-2ab5-0de6-2ed1-6189fd8d1379" valign="middle" align="left"><strong>Requirements Class</strong></th>
<th id="_2cdb2274-72eb-4c6f-80e2-8757eee72de6" valign="middle" align="left"/></tr></thead>
<tbody><tr id="_85cdec77-fc7d-9ed2-1d12-4212eb44b747"><td id="_d51b4816-137c-1ffd-5448-479a2b4f2d8d" valign="middle" align="left">/req/gsml4xsd-lite</td>
<td id="_d8e0e366-8e1f-c6e6-c8de-6441c7da4779" valign="middle" align="left"/></tr><tr id="_7c528c41-f020-8906-c875-3e10e8747614"><td id="_ca2becdd-93b3-8970-c358-a6c2649af9ed" valign="middle" align="left"><strong>Target type</strong></td>
<td id="_3950b65c-d06c-6690-fe71-6002df60c3c5" valign="middle" align="left">Data instance</td>
</tr><tr id="_79713055-a5e1-fd8e-6929-6ead131c1020"><td id="_05314fd8-1664-1a95-6c4e-134b94ec3ee1" valign="middle" align="left"><strong>Dependency</strong></td>
