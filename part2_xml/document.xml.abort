<title type="title-main" format="text/plain" language="en" script="Latn">OGC® IndoorGML</title>

  
<title type="main" format="text/plain" language="en" script="Latn">OGC® IndoorGML</title>

  <uri type="src">http://www.opengis.net/doc/IS/indoorgml/1.0.0</uri>
  <uri type="html">https://docs.ogc.org/is/14-005r3/14-005r3.html</uri>
  <docidentifier type="OGC" primary="true">14-005r3</docidentifier>
  <date type="published">
