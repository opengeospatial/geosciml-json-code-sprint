</tr><tr id="_1503a59a-a8c5-d9f8-3615-2e07c2960cd5" semx-id="_1503a59a-a8c5-d9f8-3615-2e07c2960cd5"><td id="_f945578d-84f6-2e50-f6de-e8c23895044d" valign="middle" align="center" semx-id="_f945578d-84f6-2e50-f6de-e8c23895044d"><strong>positionalAccuracy</strong></td>
<td id="_8125921d-1681-b137-5919-6e70a8dac871" valign="middle" align="center" semx-id="_8125921d-1681-b137-5919-6e70a8dac871">metadataProperty:(…):DQ_PositionalAccuracy <sup>1</sup></td>
</tr><tr id="_29c2ded3-bcad-5d7b-695d-c5f1ef2142ac" semx-id="_29c2ded3-bcad-5d7b-695d-c5f1ef2142ac"><td id="_ea4eb31c-a4cb-b36e-236a-48946e0004f0" valign="middle" align="center" semx-id="_ea4eb31c-a4cb-b36e-236a-48946e0004f0"><strong>samplingTime</strong></td>
