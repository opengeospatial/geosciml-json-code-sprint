general" semx-id="_a860196b-1a11-88c3-7966-e82869cc2370" autonum="7-5" original-id="_a860196b-1a11-88c3-7966-e82869cc2370"> <identifier id="_4562c6e2-f4f3-4706-b039-cacb4e3112f2">/req/gsml-borehole/interval-1D</identifier></requirement><requirement model="ogc" type="general" semx-id="_0dcd54af-c399-042a-1529-85f450a24867" autonum="7-6" original-id="_0dcd54af-c399-042a-1529-85f450a24867"> <identifier id="_9b5ae426-8a15-45f7-a8fd-dffbd4d68af3">/req/gsml-borehole/interval-1D-CRS</identifier></requirement><requirement model="ogc" type="general" semx-id="_9866c837-f0c9-4ae5-a62c-e6fe358d4bdd" autonum="7-7" original-id="_9866c837-f0c9-4ae5-a62c-e6fe358d4bdd"> <identifier id="_748b4b87-3902-42a5-b81a-74a8ef751c89">/req/gsml-borehole/borehole-3d</identifier></requirement><requirement model="ogc" type="general" semx-id="_7adab720-9097-4ea7-1b28-e9805abd6ac6" autonum="7-8" original-id="_7adab720-9097-4ea7-1b28-e9805abd6ac6"> <identifier id="_22fafcd4-17c3-4ceb-acab-b386a0db7cf1">/req/gsml-borehole/borehole-elevation-dim</identifier></requirement><requirement model="ogc" type="general" semx-id="_2dadbe73-0d8e-26c7-9e8f-20c6967a0cfe" autonum="7-9" original-id="_2dadbe73-0d8e-26c7-9e8f-20c6967a0cfe"> <identifier id="_a0374eef-dfef-41d0-a9a6-d1e561f625e3">/req/gsml-borehole/borehole-elevation-CRS</identifier></requirement>

<fmt-provision id="_32ac5f6e-d8cc-682c-3a51-04b55498d17c"><table id="req_class_gsml-borehole" type="recommendclass" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_f56b7ef2-72e0-6806-314c-48d67bcf33f1"><span class="fmt-caption-label"><span class="fmt-element-name">Requirements class</span> 7<span class="fmt-caption-delim">: </span>Requirements Class ‘GeoSciML Borehole’</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>{spec-part1-uri}/req/gsml-borehole</tt></td>
</tr><tr><th>Target type</th><td>Encoding</td></tr><tr><th>Prerequisites</th><td>/req/gsml-core<br/>ISO 19103 Conceptual Model Language<br/>ISO 19107 Spatial Schema<br/>ISO-19156 Observations and Measurements (OGC Topic 20)<br/>SWE Common 2.0 08-094r1 Clause 7<br/>ISO 19108 Temporal Schema<br/>ISO 19115-3 Citation</td></tr><tr><th>Normative statements</th><td><bookmark id="_bbbac506-bbaa-4519-e95f-ffba95494de0"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 24: <tt><xref style="id" target="req_gsml-borehole_value-intervalBegin" id="_5068fe35-fa78-114e-ad11-bf96f576e3bb">/req/gsml-borehole/value-intervalBegin</xref><fmt-xref style="id" target="req_gsml-borehole_value-intervalBegin">/req/gsml-borehole/value-intervalBegin</fmt-xref></tt></span><br/><bookmark id="_2ebef591-ed9c-72ac-f1fa-995aa3d7755d"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 25: <tt><xref style="id" target="req_gsml-borehole_drill-interval-1D" id="_a9cba4e9-4082-5a22-906a-7500b130ae8f">/req/gsml-borehole/drill-interval-1D</xref><fmt-xref style="id" target="req_gsml-borehole_drill-interval-1D">/req/gsml-borehole/drill-interval-1D</fmt-xref></tt></span><br/><bookmark id="_ea9f3b2e-6f55-c1a9-efce-5a7c39cf5161"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 26: <tt><xref style="id" target="req_gsml-borehole_drill-interval-1D-CRS" id="_6666dd10-16f3-325d-4cd8-6e10e9889a4c">/req/gsml-borehole/drill-interval-1D-CRS</xref><fmt-xref style="id" target="req_gsml-borehole_drill-interval-1D-CRS">/req/gsml-borehole/drill-interval-1D-CRS</fmt-xref></tt></span><br/><bookmark id="_dae6b667-e702-17f1-e175-b2d9e9617c69"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 27: <tt><xref style="id" target="req_gsml-borehole_value-mappedIntervalBegin" id="_9de05ccf-4b2f-a6e2-0550-5395edd738f3">/req/gsml-borehole/value-mappedIntervalBegin</xref><fmt-xref style="id" target="req_gsml-borehole_value-mappedIntervalBegin">/req/gsml-borehole/value-mappedIntervalBegin</fmt-xref></tt></span><br/><bookmark id="_a860196b-1a11-88c3-7966-e82869cc2370"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 28: <tt><xref style="id" target="req_gsml-borehole_interval-1D" id="_43242932-1786-4b5f-8f7d-b7127a744da8">/req/gsml-borehole/interval-1D</xref><fmt-xref style="id" target="req_gsml-borehole_interval-1D">/req/gsml-borehole/interval-1D</fmt-xref></tt></span><br/><bookmark id="_0dcd54af-c399-042a-1529-85f450a24867"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 29: <tt><xref style="id" target="req_gsml-borehole_interval-1D-CRS" id="_2528802f-db58-728d-797c-5a4b63fea6b3">/req/gsml-borehole/interval-1D-CRS</xref><fmt-xref style="id" target="req_gsml-borehole_interval-1D-CRS">/req/gsml-borehole/interval-1D-CRS</fmt-xref></tt></span><br/><bookmark id="_9866c837-f0c9-4ae5-a62c-e6fe358d4bdd"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 31: <tt><xref style="id" target="req_gsml-borehole_borehole-3d" id="_f5aa1f70-d95c-b838-6395-f11d2205441e">/req/gsml-borehole/borehole-3d</xref><fmt-xref style="id" target="req_gsml-borehole_borehole-3d">/req/gsml-borehole/borehole-3d</fmt-xref></tt></span><br/><bookmark id="_7adab720-9097-4ea7-1b28-e9805abd6ac6"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 32: <tt><xref style="id" target="req_gsml-borehole-borehole-elevation-dim" id="_b0b382bb-aad6-df82-9883-5d0ae15eae10">/req/gsml-borehole/borehole-elevation-dim</xref><fmt-xref style="id" target="req_gsml-borehole-borehole-elevation-dim">/req/gsml-borehole/borehole-elevation-dim</fmt-xref></tt></span><br/><bookmark id="_2dadbe73-0d8e-26c7-9e8f-20c6967a0cfe"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 33: <tt><xref style="id" target="req_gsml-borehole_borehole-elevation-CRS" id="_8633c098-1577-447a-e8c0-b4fda9c816ca">/req/gsml-borehole/borehole-elevation-CRS</xref><fmt-xref style="id" target="req_gsml-borehole_borehole-elevation-CRS">/req/gsml-borehole/borehole-elevation-CRS</fmt-xref></tt></span></td></tr></tbody></table></fmt-provision></requirement>

<p id="_19158936-a9b7-643b-49f0-0d8d3fe277e6" semx-id="_19158936-a9b7-643b-49f0-0d8d3fe277e6">The GeoSciML Borehole package contains an information model for boreholes and related artefacts. This is primarily through re-use of standard components from the Observations and Measurements (ISO19156).</p>

<figure id="_51e962b9-719f-0077-2f15-e9baeadb200b" width="601" semx-id="_51e962b9-719f-0077-2f15-e9baeadb200b" autonum="73">
<name id="_3ba7c508-db85-1287-f96a-c34be620ea36" semx-id="_8351ee01-1924-f386-3820-97c6edc413db">Borehole dependency diagram</name><fmt-name id="_d248b70f-39aa-2086-2777-fac25c42454f"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 73</span><span class="fmt-caption-delim"> — </span>Borehole dependency diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 73</fmt-xref-label>
<image id="_3ab67fe1-bfc3-91be-99c3-3631fa11eb41" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/faa4adb1-831d-4cd0-ab3e-996b2d4de0db.png" extracted="true" mimetype="image/png" height="559" width="601" filename="images/image75.png" alt="Borehole dependency diagram." semx-id="_3ab67fe1-bfc3-91be-99c3-3631fa11eb41"/></figure>

<figure id="_4a9c2617-27eb-c94f-7e3c-ff569335f25d" width="601" semx-id="_4a9c2617-27eb-c94f-7e3c-ff569335f25d" autonum="74">
<name id="_0fe16293-0b76-228f-744e-495372968a4c" semx-id="_afa4ecc6-6200-b3a4-efd6-d4ee7d73887f">Borehole summary diagram</name><fmt-name id="_9637d3d9-8355-14d6-7adb-f4bdf9a4b972"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 74</span><span class="fmt-caption-delim"> — </span>Borehole summary diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 74</fmt-xref-label>
<image id="_ef9bcbc5-c027-0251-b3f2-e7a0dc728169" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/cac00287-0090-4972-a175-ac0eed2e5394.png" extracted="true" mimetype="image/png" height="498" width="601" filename="images/image76.png" alt="Borehole summary diagram." semx-id="_ef9bcbc5-c027-0251-b3f2-e7a0dc728169"/></figure>

<clause id="_c2b0a00a-8407-492b-455e-f88bd51f23bb" obligation="normative" semx-id="_c2b0a00a-8407-492b-455e-f88bd51f23bb">
<title id="_3c069a7d-52b2-841c-3d7e-36f593084a26" semx-id="_1084d534-1f26-2ad8-0063-1b69011fa6f4">Borehole</title><fmt-title depth="3" id="_f8a9ab89-d996-c41d-4f7a-663d8b173d9d"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Borehole</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_6f006e2b-0f3f-69e5-afb1-f9f70d4988e9" semx-id="_6f006e2b-0f3f-69e5-afb1-f9f70d4988e9">This requirements class describes Borehole and BoreholeInterval and related data types.  This package describes a borehole as a means to sample geologic units underground and thus provide a linear map of the geology.</p>

<figure id="_fe1813f5-3bfa-8c95-ca47-629cd6a218be" width="601" semx-id="_fe1813f5-3bfa-8c95-ca47-629cd6a218be" autonum="75">
<name id="_e88b7dd0-fdbb-f4f9-d2f1-39dca04cd4a0" semx-id="_54ba6595-95fc-5d28-2878-a9acb26de8d0">Borehole context diagram</name><fmt-name id="_d0cf2249-ce9f-15d6-c1ab-7a7bddcc2228"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 75</span><span class="fmt-caption-delim"> — </span>Borehole context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 75</fmt-xref-label>
<image id="_b64793a9-4f0d-f679-f7ed-bc09eff258d2" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/36eec950-9cef-4078-ac18-5717063f41f2.png" extracted="true" mimetype="image/png" height="331" width="601" filename="images/image77.png" alt="Borehole context diagram." semx-id="_b64793a9-4f0d-f679-f7ed-bc09eff258d2"/></figure>

<clause id="_142ff89d-b889-e772-af34-c0d4b4480ee9" obligation="normative" semx-id="_142ff89d-b889-e772-af34-c0d4b4480ee9">
<title id="_5315463f-6479-1d60-c5f0-005623bca7b7" semx-id="_1bac4e91-e8d5-541e-0429-24f6166556c9">Borehole</title><fmt-title depth="4" id="_0cb0d187-54a6-5ada-8d53-087b116b10a5"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Borehole</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_21a64019-cdee-93f9-e4a6-510045335057" semx-id="_21a64019-cdee-93f9-e4a6-510045335057">A Borehole is the generalized term for any narrow shaft drilled in the ground, either vertically, horizontally, or inclined.</p>

<clause id="_4043aac6-6e5e-efab-251b-2ed113268064" obligation="normative" semx-id="_4043aac6-6e5e-efab-251b-2ed113268064">
<title id="_d0bd00f8-76f6-a16f-6e70-2ae5e1b0e2d1" semx-id="_5e047c6b-add7-9720-dc35-b10530e2d3dc">indexData</title><fmt-title depth="5" id="_bb5199f8-20d6-7eea-293c-56df9cb18755"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>indexData</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_a09a9e6e-dc4b-8144-7660-786b97816df0" semx-id="_a09a9e6e-dc4b-8144-7660-786b97816df0">The property indexData:BoreholeDetails describes metadata about a borehole, such as the operator, the custodian, dates of drilling, etc.</p>
</clause>

<clause id="_162f261b-9955-628b-0c02-fbc1472ba642" obligation="normative" semx-id="_162f261b-9955-628b-0c02-fbc1472ba642">
<title id="_5460efe7-d41c-87bb-9369-eb5dd2ac23fb" semx-id="_96b84d83-529a-2e71-7994-d38c78d57905">downholeDrillingDetails</title><fmt-title depth="5" id="_eef2cdb2-262d-f14f-e04f-224488bc7843"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>downholeDrillingDetails</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_17fe8e5b-b5b0-626b-505e-710837bb3ef4" semx-id="_17fe8e5b-b5b0-626b-505e-710837bb3ef4">The property downholeDrillingDetails:DrillingDetails specifies the drilling method and borehole diameter for intervals down the borehole.</p>
</clause>

<clause id="_4b4cd9ec-6b09-161c-209c-7dce304c7088" obligation="normative" semx-id="_4b4cd9ec-6b09-161c-209c-7dce304c7088">
<title id="_b26fd6bf-0db9-7465-d3e0-b73e9835fe84" semx-id="_2154baad-e9bb-2546-b944-dd09e8bb9913">logElement</title><fmt-title depth="5" id="_e300033a-f85d-100c-588c-c969d09530df"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>logElement</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_f06e05f2-2f68-6140-7b02-9080e5ccdfed" semx-id="_f06e05f2-2f68-6140-7b02-9080e5ccdfed">The property logElement is an association between a Borehole and a BoreholeInterval instance to describe measured downhole intervals and their observed features.</p>
</clause>

<clause id="_2470823a-b4e7-0b0d-4d35-43ef45c9d905" obligation="normative" semx-id="_2470823a-b4e7-0b0d-4d35-43ef45c9d905">
<title id="_854349d6-a1f1-92be-e914-517da30ea947" semx-id="_8d1b08ad-d802-7bc6-0c0f-b894182b2415">referenceLocation</title><fmt-title depth="5" id="_b66a5215-42a1-723a-2733-eed8076b809a"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>referenceLocation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_bf69a8c5-3801-f1da-82af-37bff3a50e8a" semx-id="_bf69a8c5-3801-f1da-82af-37bff3a50e8a">The property referenceLocation is an association between a Borehole and an OriginPosition corresponding to the start point of a borehole log.  This may correspond to the borehole collar location (e.g., kelly bush).</p>
</clause>

<clause id="_30f8547c-6242-7031-eef8-33d384559c62" obligation="normative" semx-id="_30f8547c-6242-7031-eef8-33d384559c62">
<title id="_b02ac6f3-df92-a43b-0f85-b455fd45823a" semx-id="_0196e7a5-65bf-7693-9e14-4912f10f282d">OM:sampledFeature</title><fmt-title depth="5" id="_2f0eb0d1-53cd-305e-1e03-0aa5c2b1ad40"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>OM:sampledFeature</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_20bb719d-a0ef-a7c0-18dd-b7ec835bef36" semx-id="_20bb719d-a0ef-a7c0-18dd-b7ec835bef36">Borehole inherits sampledFeature from OM::SF_SamplingFeature, which links the sampling feature to the real world feature it is designed to sample (19156:2011, clause 9.2.2.4). In the context of GeoSciML, this will typically be a GeologicFeature, such as a geologic unit. Where a SamplingFeature samples multiple features (e.g. borehole, traverse)</p>

<ul id="_c45ec3a9-ef01-b41f-49b9-bd7921fdc572" semx-id="_c45ec3a9-ef01-b41f-49b9-bd7921fdc572"><li id="_b96989cc-e557-3dd0-e64f-60c558bb8a68"><fmt-name id="_9035c90a-e5c6-4b50-24f5-fe0d05cc755a">•</fmt-name><p id="_e584be14-c623-84f3-446d-def200acf16b" semx-id="_e584be14-c623-84f3-446d-def200acf16b">if it is a sequence of units, then the part:GeologicUnitPart mechanisms may be used,</p>
</li>
<li id="_f8bc35aa-8f13-99c5-7a68-877012a22dd9"><fmt-name id="_06eaf180-feb5-9983-8085-5dcc7ed82bdd">•</fmt-name><p id="_2f0dd788-5aa1-65e9-c132-2c132a402d3c" semx-id="_2f0dd788-5aa1-65e9-c132-2c132a402d3c">else if it is an informal collection that exists only because of the sampling, then multiple sampledFeature roles should be used</p>
</li>
</ul>
</clause>
</clause>

<clause id="_f8f99a7c-4eca-6fc9-58fa-4393a97c3385" obligation="normative" semx-id="_f8f99a7c-4eca-6fc9-58fa-4393a97c3385">
<title id="_761b8850-b3a0-7e45-5c64-a31f441b0205" semx-id="_daf3141d-c800-c69e-5317-f2daf8e51145">DrillingDetails</title><fmt-title depth="4" id="_00f1520e-12dd-1f93-8b0d-3981193131b0"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>DrillingDetails</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_5457c261-081e-476d-cfef-4fa8dd2c20c8" semx-id="_5457c261-081e-476d-cfef-4fa8dd2c20c8">DrillingDetails is a class that captures the description of drilling methods and hole diameters down the drilling path.  Properties that apply to the Borehole as a whole are managed in BoreholeDetails (8.7.1.4).</p>

<figure id="_c3734d60-8f79-1b84-e3a8-7ff108f7fb89" width="601" semx-id="_c3734d60-8f79-1b84-e3a8-7ff108f7fb89" autonum="76">
<name id="_4f001f45-1ad2-6c45-3070-9110ba216e40" semx-id="_5cf0de24-97d6-b084-cfa0-4e8dfd41f5fc">Drilling details</name><fmt-name id="_e42d0882-5163-493e-4d61-00f1c20b188f"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 76</span><span class="fmt-caption-delim"> — </span>Drilling details</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 76</fmt-xref-label>
<image id="_ff3fedf5-929e-5fa8-f642-a23cd2640e95" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/422ed5c8-6495-467a-ab35-d524ca8db6c9.png" extracted="true" mimetype="image/png" height="387" width="601" filename="images/image78.png" alt="Drilling details" semx-id="_ff3fedf5-929e-5fa8-f642-a23cd2640e95"/></figure>

<clause id="_b13dfd9f-9f28-ecee-6163-361a38d664b7" obligation="normative" semx-id="_b13dfd9f-9f28-ecee-6163-361a38d664b7">
<title id="_71302759-bf55-31c9-6342-aaa497e85c89" semx-id="_1a57ac89-2e5c-f9a3-0844-df3b6d2f5e8a">drillingMethod</title><fmt-title depth="5" id="_a4ec8cf0-eda2-7ecf-1089-631d125b783f"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>drillingMethod</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_1f501c11-d44b-5c7e-5f62-71883b492523" semx-id="_1f501c11-d44b-5c7e-5f62-71883b492523">The drillingMethod:BoreholeDrillingMethodCode property contains a term from a controlled vocabulary indicating the drilling method used. Appropriate terms would include rotary air blast, auger, diamond core, air core, etc.</p>
</clause>

<clause id="_3881ee10-b6eb-a833-62c8-b0576719bd3e" obligation="normative" semx-id="_3881ee10-b6eb-a833-62c8-b0576719bd3e">
<title id="_6cdf98c4-9d6a-5995-e8f5-51ecce2e79a9" semx-id="_16eb3182-c5f7-0762-999f-0af180b8a74d">boreholeDiameter</title><fmt-title depth="5" id="_d5169325-81fa-fc1f-37a5-97a94617c5c2"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>boreholeDiameter</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_a4301a19-0c8a-b7fc-af8f-c6d5820534de" semx-id="_a4301a19-0c8a-b7fc-af8f-c6d5820534de">The boreholeDiameter property (SWE::Quantity) contains a measurement (a value and a unit of measure) corresponding to the diameter of the drilled hole.</p>
</clause>

<clause id="_63e8286d-d6f0-c461-f163-e7d03840fa2a" obligation="normative" semx-id="_63e8286d-d6f0-c461-f163-e7d03840fa2a">
<title id="_501114cb-bd23-9740-4329-3e50ada6630f" semx-id="_2093de49-f1d2-3dc4-7c18-f4887aef083c">intervalBegin</title><fmt-title depth="5" id="_626edd79-277e-5ea5-513c-7ea5fa368083"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>intervalBegin</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_ea62853c-44e4-2a3f-c758-c9ae07d45b86" semx-id="_ea62853c-44e4-2a3f-c758-c9ae07d45b86">The intervalBegin property (SWE::Quantity) contains a measurement (a value and a unit of measurement) that corresponds to the measured distance of the start of the interval along the path of the borehole. The measured value must be less than or equal to the intervalEnd value.</p>

<requirement id="_347ffd82-e1ff-4bb9-9e2e-40fb79ee1dbe" anchor="req_gsml-borehole_value-intervalBegin" model="ogc" semx-id="_b94006e5-adcb-da15-79a2-357d58cb021a" autonum="24" original-id="req_gsml-borehole_value-intervalBegin"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 24: <tt><xref style="id" target="req_gsml-borehole_value-intervalBegin">/req/gsml-borehole/value-intervalBegin</xref></tt></fmt-xref-label> <identifier id="_74a9f759-8e22-4679-9eac-a900c84ac29f">/req/gsml-borehole/value-intervalBegin</identifier><component class="part" semx-id="_e1767ec4-f6b7-6cf5-2d23-f1829dccb822" original-id="_e1767ec4-f6b7-6cf5-2d23-f1829dccb822"><p semx-id="_52eaabdf-4f09-2f41-4495-ce14c936e502" original-id="_52eaabdf-4f09-2f41-4495-ce14c936e502">The value of intervalBegin SHALL be less or equal to the value of intervalEnd.</p>
</component>
<fmt-provision id="_e5caccce-63fd-8dea-8de2-dc5791ec0bcb"><table id="req_gsml-borehole_value-intervalBegin" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_9d8773df-2dc4-5c61-01a4-218a6061c620"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 24</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/value-intervalBegin</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_9595ee54-7d73-7983-972a-44c678ec4985">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_e1767ec4-f6b7-6cf5-2d23-f1829dccb822"><th>A</th><td><p id="_52eaabdf-4f09-2f41-4495-ce14c936e502" semx-id="_52eaabdf-4f09-2f41-4495-ce14c936e502">The value of intervalBegin SHALL be less or equal to the value of intervalEnd.</p>
</td></tr></tbody></table></fmt-provision></requirement>
</clause>

<clause id="_f8a04723-810c-c0f1-78af-67832810f6f9" obligation="normative" semx-id="_f8a04723-810c-c0f1-78af-67832810f6f9">
<title id="_0e92a1fa-d8c4-14e7-102c-3abfc1e40fbb" semx-id="_c4a58c96-9357-1c03-0756-1a1edfdf8e48">intervalEnd</title><fmt-title depth="5" id="_23c8ced5-b7e1-e79a-bb38-6aadd7830e80"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>intervalEnd</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_2c847d4f-1045-800c-63c3-ed7877c27d9d" semx-id="_2c847d4f-1045-800c-63c3-ed7877c27d9d">The property intervalEnd (SWE::Quantity) contains a measurement (a value and a unit of measurement) of the measured distance of the end of the interval along the path of the borehole. The measured value must be greater than or equal to the intervalBegin value.</p>
</clause>

<clause id="_a1143d75-6c99-17de-ef2f-fa96e44ed056" obligation="normative" semx-id="_a1143d75-6c99-17de-ef2f-fa96e44ed056">
<title id="_cef20d3e-fbdc-215a-7481-a8ee7037bc01" semx-id="_f8f63d16-b943-c35b-5795-a1c0afaa4e68">interval</title><fmt-title depth="5" id="_a7d25872-f9b4-5789-e3d2-d8979ac7e60f"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>interval</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_5f38baff-1b04-abae-9173-c1ccc5cd4871" semx-id="_5f38baff-1b04-abae-9173-c1ccc5cd4871">The property interval:GM_Object is a shape that is a 1-D interval (e.g., a “from” and “to”, or “top” and “base” measurements) that is equivalent (represents the same distance) as the one represented by intervalBegin and intervalEnd.  The geometry shall use a reference to the borehole geometry as its CRS.</p>

<requirement id="_0a1694ab-6be1-4581-9f32-8d1d4f83f557" anchor="req_gsml-borehole_drill-interval-1D" model="ogc" semx-id="_fc3a92c6-5c00-a99d-0d98-6563ebbbd871" autonum="25" original-id="req_gsml-borehole_drill-interval-1D"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 25: <tt><xref style="id" target="req_gsml-borehole_drill-interval-1D">/req/gsml-borehole/drill-interval-1D</xref></tt></fmt-xref-label> <identifier id="_7373d958-66f0-4add-a451-6857b6656991">/req/gsml-borehole/drill-interval-1D</identifier><component class="part" semx-id="_ea899532-77db-b9b0-c7fd-d64a27066ed0" original-id="_ea899532-77db-b9b0-c7fd-d64a27066ed0"><p semx-id="_fd076814-18d7-f151-bc73-74808f6f6e04" original-id="_fd076814-18d7-f151-bc73-74808f6f6e04">Interval SHALL be encoded with GM_LineString with two 1D points.</p>
</component>
<fmt-provision id="_57d0359c-32b3-0b44-2e74-097c70d3aae9"><table id="req_gsml-borehole_drill-interval-1D" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_0373a81f-1f63-33fa-4b8f-6f2c942c6270"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 25</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/drill-interval-1D</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_24634946-7457-6de3-0d1f-8eefea92bebf">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_ea899532-77db-b9b0-c7fd-d64a27066ed0"><th>A</th><td><p id="_fd076814-18d7-f151-bc73-74808f6f6e04" semx-id="_fd076814-18d7-f151-bc73-74808f6f6e04">Interval SHALL be encoded with GM_LineString with two 1D points.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_39ba60b9-461c-96fc-fe45-570071eb5cda" semx-id="_39ba60b9-461c-96fc-fe45-570071eb5cda"> </p>

<requirement id="_2989c069-332a-4a3d-8035-481a34b773c5" anchor="req_gsml-borehole_drill-interval-1D-CRS" model="ogc" semx-id="_f3387a8d-d183-ad8f-c47f-2823ae8df834" autonum="26" original-id="req_gsml-borehole_drill-interval-1D-CRS"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 26: <tt><xref style="id" target="req_gsml-borehole_drill-interval-1D-CRS">/req/gsml-borehole/drill-interval-1D-CRS</xref></tt></fmt-xref-label> <identifier id="_d1b5e073-8515-4c3d-b02a-2e5d35b78061">/req/gsml-borehole/drill-interval-1D-CRS</identifier><component class="part" semx-id="_229353b9-aa01-36ab-97ca-c1b55d052867" original-id="_229353b9-aa01-36ab-97ca-c1b55d052867"><p semx-id="_1f730d8f-a8a2-8026-d27f-e91a462ad0a7" original-id="_1f730d8f-a8a2-8026-d27f-e91a462ad0a7">Coordinate Reference System shall be a reference to the borehole geometry.</p>
</component>
<fmt-provision id="_646191f0-968d-961f-6dd1-956032bef30d"><table id="req_gsml-borehole_drill-interval-1D-CRS" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_6935e4d0-6511-2dfa-5538-2d22d6b1cf56"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 26</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/drill-interval-1D-CRS</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_fe752b23-1aad-db31-0bb4-4f7495b2d489">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_229353b9-aa01-36ab-97ca-c1b55d052867"><th>A</th><td><p id="_1f730d8f-a8a2-8026-d27f-e91a462ad0a7" semx-id="_1f730d8f-a8a2-8026-d27f-e91a462ad0a7">Coordinate Reference System shall be a reference to the borehole geometry.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_9eb3d769-0431-80e0-8c23-fde5b72771a4" semx-id="_9eb3d769-0431-80e0-8c23-fde5b72771a4">Encoding of the drilled interval using GEO::GM_LineString shall consist of two 1D points only (the start and end point of the interval, measured as distance from the borehole collar), with a 1-D CRS referencing the borehole shape.</p>
</clause>
</clause>

<clause id="_01a36d5c-1ca1-eab8-cbdb-d7a1cc9caad9" obligation="normative" semx-id="_01a36d5c-1ca1-eab8-cbdb-d7a1cc9caad9">
<title id="_c535c32e-96a6-d5a9-9d1c-5089ea086c9a" semx-id="_9ddcd8c9-74a9-30f7-312f-5440dcd35102">BoreholeInterval</title><fmt-title depth="4" id="_05340643-a129-2601-a7b0-2b2ab374ba43"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>BoreholeInterval</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_455f339b-14d9-d726-33f2-44af45f9b69f" semx-id="_455f339b-14d9-d726-33f2-44af45f9b69f">A BoreholeInterval is similar to a MappedFeature (8.4.1.2) whose shape is 1-D interval and uses the SRS of the containing borehole.  The “mappedIntervalBegin” and “mappedIntervalEnd” properties are alternative to the 1D geometry to overcome problems with the delivery and ease of queryability of 1D GML shapes.</p>

<figure id="_ab39d74e-44f9-b9ca-688b-3d5eddf56518" width="601" semx-id="_ab39d74e-44f9-b9ca-688b-3d5eddf56518" autonum="77">
<name id="_23a060e6-a065-1d3a-51f9-78af571ed4f4" semx-id="_84cf95d7-ffdc-557b-36a0-e7a03a8db2ce">Borehole interval context diagram</name><fmt-name id="_e5603328-37f7-9527-ba97-fdb662700e71"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 77</span><span class="fmt-caption-delim"> — </span>Borehole interval context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 77</fmt-xref-label>
<image id="_0ddf2524-84ce-f231-032c-15a32a173c44" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/c0a357ef-a370-4af1-bd56-509dbca367f6.png" extracted="true" mimetype="image/png" height="439" width="601" filename="images/image79.png" alt="Borehole interval context diagram." semx-id="_0ddf2524-84ce-f231-032c-15a32a173c44"/></figure>

<clause id="_12fed5cd-a157-8a00-832e-3db82ad2b813" obligation="normative" semx-id="_12fed5cd-a157-8a00-832e-3db82ad2b813">
<title id="_2a17747e-6fa8-e241-892b-af431093506a" semx-id="_3a4c3ba4-2371-5b17-d2d8-9534b7f58388">observationMethod</title><fmt-title depth="5" id="_2ce6ba3f-7315-a78f-b05e-633fe3f51ad7"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>observationMethod</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_5284ee39-e491-06f4-20f6-e80046a2e52d" semx-id="_5284ee39-e491-06f4-20f6-e80046a2e52d">The observationMethod property (SWE::Category) contains a term from a controlled vocabulary that describes the method used to observe the properties of the borehole.</p>
</clause>

<clause id="_676ef266-289d-704d-d74f-0d443eab4c18" obligation="normative" semx-id="_676ef266-289d-704d-d74f-0d443eab4c18">
<title id="_4e03178a-3b6d-d111-367a-264f4790f99e" semx-id="_358b4e21-cde5-c75a-b244-8af7d189a46f">specification</title><fmt-title depth="5" id="_ce93fac5-dc36-09fb-f69d-87d76fdf0fc8"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>specification</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_5ba9414d-3096-a34c-d972-872c9bc4d1e9" semx-id="_5ba9414d-3096-a34c-d972-872c9bc4d1e9">The specification property is an association between a BoreholeInterval and a GFI_Feature, a domain feature that is sampled by the interval (e.g., a GeologicUnit). It is semantically equivalent to O&amp;M ISO19156 “sampledFeature”.</p>
</clause>

<clause id="_706a9fdd-8c5a-7729-5b46-8161e0a0b23c" obligation="normative" semx-id="_706a9fdd-8c5a-7729-5b46-8161e0a0b23c">
<title id="_165a95fd-4ef7-7ab5-30dc-dd243477bf9f" semx-id="_505755ec-cafd-3139-e8e0-e602ae6f472e">mappedIntervalBegin</title><fmt-title depth="5" id="_b8dec746-8158-8ef2-aaa8-1fa029a53f52"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>mappedIntervalBegin</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_51310674-aaa5-f682-cd1e-a8a5fbee00b6" semx-id="_51310674-aaa5-f682-cd1e-a8a5fbee00b6">The property mappedIntervalBegin (SWE::Quantity) is a measurement (a value and a unit of measurement) corresponding to the measured distance of the start of the mapped interval along the path of the borehole. The measured value must be less than or equal to the mappedIntervalEnd value.</p>

<requirement id="_3535d0ce-f06f-44c1-8297-bae1a37c6c3f" anchor="req_gsml-borehole_value-mappedIntervalBegin" model="ogc" semx-id="_6bc39daf-046e-15b6-37a4-2cba4a7cb94f" autonum="27" original-id="req_gsml-borehole_value-mappedIntervalBegin"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 27: <tt><xref style="id" target="req_gsml-borehole_value-mappedIntervalBegin">/req/gsml-borehole/value-mappedIntervalBegin</xref></tt></fmt-xref-label> <identifier id="_800573a6-61fe-4b5a-8881-7853ded7943b">/req/gsml-borehole/value-mappedIntervalBegin</identifier><component class="part" semx-id="_3cd1c435-d91e-d69e-90bb-d8f1552e55ec" original-id="_3cd1c435-d91e-d69e-90bb-d8f1552e55ec"><p semx-id="_44d4d0a8-ad39-7371-0f06-ea86db4c39eb" original-id="_44d4d0a8-ad39-7371-0f06-ea86db4c39eb">The value of mappedIntervalBegin SHALL be less or equal to the value of mappedIntervalEnd.</p>
</component>
<fmt-provision id="_d4793b99-8b47-e1d7-9c82-642a4a893ea5"><table id="req_gsml-borehole_value-mappedIntervalBegin" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_12a02951-41a6-0246-14bb-5bc5d69c2180"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 27</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/value-mappedIntervalBegin</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_66885de4-c756-b5eb-2055-43f1c2f6e3ca">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_3cd1c435-d91e-d69e-90bb-d8f1552e55ec"><th>A</th><td><p id="_44d4d0a8-ad39-7371-0f06-ea86db4c39eb" semx-id="_44d4d0a8-ad39-7371-0f06-ea86db4c39eb">The value of mappedIntervalBegin SHALL be less or equal to the value of mappedIntervalEnd.</p>
</td></tr></tbody></table></fmt-provision></requirement>
</clause>

<clause id="_644c3700-2665-8962-c12a-634ffecda487" obligation="normative" semx-id="_644c3700-2665-8962-c12a-634ffecda487">
<title id="_53745d01-a948-091d-4ff0-5a92b006f7d1" semx-id="_34019d64-c37f-c66c-c09d-05df4b442d4f">mappedIntervalEnd</title><fmt-title depth="5" id="_079a9fcf-0415-8874-5b02-2c304b31730b"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>mappedIntervalEnd</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_025464db-eaed-331f-26c8-0e6620ee228c" semx-id="_025464db-eaed-331f-26c8-0e6620ee228c">The mappedIntervalEnd property (SWE::Quantity) is a measurement (a value and a unit of measure) corresponding to the measured distance of the end of the mapped interval along the path of the borehole. The measured value must be greater than or equal to the mappedIntervalBegin value.</p>
</clause>

<clause id="_e326af73-de07-0bc9-d6bb-07c9545558e7" obligation="normative" semx-id="_e326af73-de07-0bc9-d6bb-07c9545558e7">
<title id="_e6dfbb7d-f04c-0cb2-e915-1696181a8e9b" semx-id="_b4097137-49d2-8e4f-1cbd-09574071e442">collectionIdentifier</title><fmt-title depth="5" id="_9334c0d7-ac50-06b9-13ff-3ff2754d756d"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>collectionIdentifier</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_3060e765-8942-0649-a10e-a707f74bc02d" semx-id="_3060e765-8942-0649-a10e-a707f74bc02d">The collectionIdentifier:ScopedName is a string unique within a scope that identifies a collection which forms a set BoreholeIntervals. This allows description of multiple downhole logs for a single borehole. The name should identify a particular log observation event.</p>
</clause>

<clause id="_fba2221c-a09d-46c3-af51-9c63484c9bc4" obligation="normative" semx-id="_fba2221c-a09d-46c3-af51-9c63484c9bc4">
<title id="_03cb8dd3-05a8-b16d-69f5-91b465f80575" semx-id="_444ea6c7-b9a0-9751-4755-7d5b6b510d6a">parentBorehole</title><fmt-title depth="5" id="_56c0ad84-30da-4d3d-021b-dd9a8a4ff5c5"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>parentBorehole</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_c2754813-34a7-e126-c69f-c288b7375b4d" semx-id="_c2754813-34a7-e126-c69f-c288b7375b4d">The property parentBorehole is an association between a BoreholeInterval and a Borehole to which the interval belongs.</p>
</clause>

<clause id="_e092df53-3581-78b0-f1e3-44670470cbc2" obligation="normative" semx-id="_e092df53-3581-78b0-f1e3-44670470cbc2">
<title id="_e4699da6-5bf8-8426-38ad-b25794b5468d" semx-id="_cd0d7e28-5ba9-8266-d2df-493907640a2a">shape</title><fmt-title depth="5" id="_305982cb-56ee-89a5-f280-c2982eb30195"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>shape</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>7</fmt-xref-label>
<p id="_153912d1-a825-4ae8-7fc0-96c6bcebbda6" semx-id="_153912d1-a825-4ae8-7fc0-96c6bcebbda6">The property shape:GM_Object is a 1-D interval (e.g., a “from” and “to”, or “top” and “base” measurement) covering the same distance as mappedIntervalBegin and mappedIntervalEnd.  The geometry shall use a reference to the borehole as the CRS of the containing borehole.</p>

<p id="_0822e120-a917-ba08-e9f0-1b2f6527f6e5" semx-id="_0822e120-a917-ba08-e9f0-1b2f6527f6e5">Encoding of an interval within the borehole using GEO::GM_LineString shall consist of two 1D points only (the start and end point of the interval, measured as distance from the borehole collar), with CRS corresponding to the borehole shape.</p>

<requirement id="_c71373f1-81c3-40c1-9068-d22e9a3b3fa3" anchor="req_gsml-borehole_interval-1D" model="ogc" semx-id="_7342ef4a-cbc3-2eda-bd8d-328198574fee" autonum="28" original-id="req_gsml-borehole_interval-1D"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 28: <tt><xref style="id" target="req_gsml-borehole_interval-1D">/req/gsml-borehole/interval-1D</xref></tt></fmt-xref-label> <identifier id="_7d1e0275-c12f-400b-a688-16af0f76d8a6">/req/gsml-borehole/interval-1D</identifier><component class="part" semx-id="_88795ffc-c6b8-16e8-8cc5-d37036e7e269" original-id="_88795ffc-c6b8-16e8-8cc5-d37036e7e269"><p semx-id="_b704fea3-ff78-3555-bb8b-3aefdb286bcf" original-id="_b704fea3-ff78-3555-bb8b-3aefdb286bcf">Interval SHALL be encoded with GM_LineString with two 1D points.</p>
</component>
<fmt-provision id="_0de137c8-4083-a6b7-a018-d7c1f9ee7c4c"><table id="req_gsml-borehole_interval-1D" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_8590f36f-dd0f-1bb5-6ebb-066077023854"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 28</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/interval-1D</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_446f44f4-2184-613f-8459-874cf1c87b09">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_88795ffc-c6b8-16e8-8cc5-d37036e7e269"><th>A</th><td><p id="_b704fea3-ff78-3555-bb8b-3aefdb286bcf" semx-id="_b704fea3-ff78-3555-bb8b-3aefdb286bcf">Interval SHALL be encoded with GM_LineString with two 1D points.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<requirement id="_f89bed12-709d-4e49-a805-950bb961a67b" anchor="req_gsml-borehole_interval-1D-CRS" model="ogc" semx-id="_60f3ab5e-da25-b43e-b5e5-2edf6a6c5059" autonum="29" original-id="req_gsml-borehole_interval-1D-CRS"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 29: <tt><xref style="id" target="req_gsml-borehole_interval-1D-CRS">/req/gsml-borehole/interval-1D-CRS</xref></tt></fmt-xref-label> <identifier id="_3331fdf0-eb08-42f4-a951-78aa66b0cb23">/req/gsml-borehole/interval-1D-CRS</identifier><component class="part" semx-id="_6df9ec92-7eb9-0898-80e0-1d1650ea5e47" original-id="_6df9ec92-7eb9-0898-80e0-1d1650ea5e47"><p semx-id="_ccb9f913-7c00-4e40-4e60-315ce299fcdc" original-id="_ccb9f913-7c00-4e40-4e60-315ce299fcdc">Coordinate Reference System of interval geometries SHALL use the borehole geometry.</p>
</component>
<fmt-provision id="_a4a0490c-3a21-22c4-bb43-d479eb45461d"><table id="req_gsml-borehole_interval-1D-CRS" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_67befd58-f656-e9d2-6d9f-4bd49ffe75f6"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 29</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/interval-1D-CRS</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_6261b960-464e-cbf6-c3dc-55abdbf0ef4a">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_6df9ec92-7eb9-0898-80e0-1d1650ea5e47"><th>A</th><td><p id="_ccb9f913-7c00-4e40-4e60-315ce299fcdc" semx-id="_ccb9f913-7c00-4e40-4e60-315ce299fcdc">Coordinate Reference System of interval geometries SHALL use the borehole geometry.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_aaddbba4-e791-9553-a82b-d4eec71e19f3" semx-id="_aaddbba4-e791-9553-a82b-d4eec71e19f3">Instance example for Klčovo and Lastomir Formation adapted from Túnyi [18]:</p>

<figure id="img_top__part_tunyi" anchor="img_top__part_tunyi" width="426" semx-id="_65eb9d68-c059-5fe9-c7e7-7e01f2474f30" autonum="78">
<name id="_5b34e950-b710-e295-a8f7-4d02573e0c36" semx-id="_a63766cd-2c8d-4685-69c8-336fc4e7e195">Top part of Figure 2 from Túnyi [18]</name><fmt-name id="_96657ddf-29eb-29d3-0201-3031a389c9d5"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 78</span><span class="fmt-caption-delim"> — </span>Top part of Figure 2 from Túnyi [18]</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 78</fmt-xref-label>
<image id="_68fa1333-1ee8-defb-b8bf-498fa113f7b9" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/22cbcd73-f030-465c-baa3-9509cc570622.png" extracted="true" mimetype="image/png" height="549" width="426" filename="images/image80.png" semx-id="_68fa1333-1ee8-defb-b8bf-498fa113f7b9"/></figure>

<p id="_aeb1917f-ffd3-20a1-8b1c-9c9974407bc4" semx-id="_aeb1917f-ffd3-20a1-8b1c-9c9974407bc4"><xref target="img_encoding_of_a_borehole_with_two_logs" id="_0815c7e8-472c-371a-5223-e39ea26675aa"/><fmt-xref target="img_encoding_of_a_borehole_with_two_logs"><span class="fmt-element-name">Figure</span> 79</fmt-xref> shows an encoding of the first lithostratigraphic and magnetostratigraphic units from <xref target="img_top__part_tunyi" id="_12dd0410-8b25-d7ff-8b35-0c90a15cd333"/><fmt-xref target="img_top__part_tunyi"><span class="fmt-element-name">Figure</span> 78</fmt-xref> showing how the collection identifiers group BoreholeIntervals into two groups.</p>

<figure id="img_encoding_of_a_borehole_with_two_logs" anchor="img_encoding_of_a_borehole_with_two_logs" width="601" semx-id="_0988f195-8753-71df-f8f3-158a8a55e10a" autonum="79">
<name id="_01c2eb74-bc87-a829-ee71-d209a6d0ccb3" semx-id="_ffe11fa2-690f-1459-a47f-1a9680eb0109">Encoding of a borehole with two distinct logs (collectionIdentifier).</name><fmt-name id="_52efc10c-22e0-b29e-8fe6-f3031bf66fba"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 79</span><span class="fmt-caption-delim"> — </span>Encoding of a borehole with two distinct logs (collectionIdentifier).</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 79</fmt-xref-label>
<image id="_49a4acc5-e995-fe06-607c-be87912ac3b9" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/4de0fedf-36e1-402d-bdc5-d4b7ac5b896e.png" extracted="true" mimetype="image/png" height="398" width="601" filename="images/image81.png" semx-id="_49a4acc5-e995-fe06-607c-be87912ac3b9"/></figure>
</clause>
</clause>

<clause id="_378f0bb2-4b1d-3098-7236-ee318782cc7e" obligation="normative" semx-id="_378f0bb2-4b1d-3098-7236-ee318782cc7e">
<title id="_be8a860a-f2a5-7bea-b3b2-5bed113fa264" semx-id="_0f2ee312-1775-e53a-d451-44a9eb8ab1aa">BoreholeDetails</title><fmt-title depth="4" id="_373f5627-9a6d-2bb2-2b57-5a8908d66989"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>BoreholeDetails</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_d00c0982-c6b4-8f25-696a-40ccbc731c03" semx-id="_d00c0982-c6b4-8f25-696a-40ccbc731c03">BoreholeDetails describes borehole-specific index data, often termed “header information”. It contains metadata about the parties involved in the drilling, the storage of drilled material and other information relevant to the borehole as a whole.  Properties that may vary along the borehole path are managed in DrillingDetails (8.7.1.2).</p>

<figure id="_d3816da5-f5ca-0705-d3a5-6d71011c5c3f" width="601" semx-id="_d3816da5-f5ca-0705-d3a5-6d71011c5c3f" autonum="80">
<name id="_cc413127-3476-b8d8-e6a6-778544bfbf2c" semx-id="_d75b9c82-bb89-8043-2cb0-f580c06503ea">Borehole details context diagram</name><fmt-name id="_359c1f62-70b8-47f5-66b7-437a10fad1f7"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 80</span><span class="fmt-caption-delim"> — </span>Borehole details context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 80</fmt-xref-label>
<image id="_685d81f1-0658-d73b-81c6-4280254769d5" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/64bdb65a-49f5-4711-b119-080736533eca.png" extracted="true" mimetype="image/png" height="570" width="601" filename="images/image82.png" alt="Borehole details context diagram." semx-id="_685d81f1-0658-d73b-81c6-4280254769d5"/></figure>

<clause id="_4a4bc560-1c63-32ad-705c-af51bfa31329" obligation="normative" semx-id="_4a4bc560-1c63-32ad-705c-af51bfa31329">
<title id="_64bca1b8-4db2-d889-409a-a3f69a3fc4d6" semx-id="_08e7926e-c72c-e34e-eb6e-0ad6bbca16cd">operator</title><fmt-title depth="5" id="_fd90b04b-0c45-857b-94c6-1298da1d328a"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>operator</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_359902ce-6de8-8644-d53f-0ccac6253bcd" semx-id="_359902ce-6de8-8644-d53f-0ccac6253bcd">The operator property is an association between a BoreholeDetails and a CIT:CI_ResponsibleParty describing the organisation responsible for commissioning the borehole (as opposed to actually drilling the borehole).</p>
</clause>

<clause id="_fb51378d-6cd0-fdce-bf62-9d2c68e5d946" obligation="normative" semx-id="_fb51378d-6cd0-fdce-bf62-9d2c68e5d946">
<title id="_2daf017b-565a-d727-3173-2bd138c9f152" semx-id="_ef6cc91a-8f15-cc41-a398-ed760eb773a5">driller</title><fmt-title depth="5" id="_a46079be-827f-0518-e6a8-f3520dd45b9c"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>driller</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_1adf1c16-142a-56d4-b450-59ca90340ac5" semx-id="_1adf1c16-142a-56d4-b450-59ca90340ac5">The driller property is an association between a BoreholeDetails and a CIT:CI_ResponsibleParty describing of the organisation responsible for drilling the borehole (as opposed to commissioning the borehole).</p>
</clause>

<clause id="_41e2f941-0018-75d2-93c5-e18de9b56785" obligation="normative" semx-id="_41e2f941-0018-75d2-93c5-e18de9b56785">
<title id="_af1d07db-71ec-e403-fc5f-0b4a640dec4a" semx-id="_9ee363b5-771d-218f-fbd3-8df45eca774e">dateOfDrilling</title><fmt-title depth="5" id="_6934ad11-0e66-c6b1-9c05-445ad55bf559"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>dateOfDrilling</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_d8866025-74f5-f198-88f6-817bb1ab0dec" semx-id="_d8866025-74f5-f198-88f6-817bb1ab0dec">The property dateOfDrilling:TM_Period describes the time period during which drilling of the borehole occurred.</p>
</clause>

<clause id="_70553cf9-2c75-270f-6e41-c4cf2d34065a" obligation="normative" semx-id="_70553cf9-2c75-270f-6e41-c4cf2d34065a">
<title id="_7eebc48d-c924-78fe-844b-05684814a343" semx-id="_ea9d8098-6c46-d254-9ed1-d9dacdb02de5">startPoint</title><fmt-title depth="5" id="_b6d6b6ee-0479-f1cb-8c82-2db55002d280"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>startPoint</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_863ff117-b472-9564-4173-234522a49d27" semx-id="_863ff117-b472-9564-4173-234522a49d27">The property startPoint:BoreholeStartPointCode provides a term from a controlled vocabulary indicating the named position relative to ground surface where the borehole commenced. (e.g., natural ground surface, open pit floor, underground, offshore)</p>
</clause>

<clause id="_7ece0ff7-b1e3-e110-f182-51822de21d95" obligation="normative" semx-id="_7ece0ff7-b1e3-e110-f182-51822de21d95">
<title id="_51d3c604-9402-f052-69f6-2acf68545075" semx-id="_723c713c-3a9c-f445-80fb-41cd168f3e52">inclinationType</title><fmt-title depth="5" id="_e91e0430-b06d-f341-89eb-c668f9187203"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>inclinationType</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_e6732749-a8fe-527c-3451-c672a71c1cbd" semx-id="_e6732749-a8fe-527c-3451-c672a71c1cbd">The property inclinationType:BoreholeInclinationCode contains a term from a controlled vocabulary indicating the inclination type of the borehole. Appropriate terms would include vertical; inclined up; inclined down, horizontal.</p>
</clause>

<clause id="_d023a313-c1cb-797f-b4fe-09bb481ec0e4" obligation="normative" semx-id="_d023a313-c1cb-797f-b4fe-09bb481ec0e4">
<title id="_c4ac7bec-70ff-194d-8979-a7dde66f470b" semx-id="_4e60814f-01bb-54be-1a15-6ec1a9b87901">boreholeMaterialCustodian</title><fmt-title depth="5" id="_75a6ac1c-8ae7-0986-ae3b-c2dd1d91773e"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>boreholeMaterialCustodian</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_e91e6e5f-2e11-87e2-e4d1-a9b1dbf097f4" semx-id="_e91e6e5f-2e11-87e2-e4d1-a9b1dbf097f4">The property boreholeMaterialCustodian is an association between BoreholeDetails and a CIT:CI_ResponsibleParty describing the organisation that is custodian of the drilled material recovered from the borehole.</p>
</clause>

<clause id="_1ff0d4c0-a73b-e99a-19c6-f7f7702904ef" obligation="normative" semx-id="_1ff0d4c0-a73b-e99a-19c6-f7f7702904ef">
<title id="_58564be5-59c1-f0d4-05fb-db543ddc239b" semx-id="_da3433db-e8f1-ff84-8fb4-6847a18fd70c">purpose</title><fmt-title depth="5" id="_6af30bb5-400c-227f-9ad0-d769492671f4"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>purpose</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>7</fmt-xref-label>
<p id="_3c0d164d-c970-843d-e559-80fbdc64a332" semx-id="_3c0d164d-c970-843d-e559-80fbdc64a332">The property purpose:BoreholePurposeCode contains a term from a controlled vocabulary describing the purpose for which the borehole was drilled. e.g., site investigation, mineral exploration, hydrocarbon exploration, water resources.</p>
</clause>

<clause id="_87f1e326-28a8-5979-cb59-314481162f60" obligation="normative" semx-id="_87f1e326-28a8-5979-cb59-314481162f60">
<title id="_b72c7137-d88a-5d0f-eab0-33a22fcb6068" semx-id="_8b8e4237-0484-c8a1-b339-208b7d23829a">dataCustodian</title><fmt-title depth="5" id="_07c725c6-0a3a-2b47-9e63-777d7a6ce7e9"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>dataCustodian</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>8</fmt-xref-label>
<p id="_f80938d3-31f2-35da-6cb5-1f1485c4c147" semx-id="_f80938d3-31f2-35da-6cb5-1f1485c4c147">The dataCustodian is an association between a BoreholeDetails and a CIT:CI_ResponsibleParty describing the custodian (person or organisation) that is the custodian of data pertaining to this borehole.</p>
</clause>

<clause id="_7e856535-a684-c935-bf2a-0ffb7e001c95" obligation="normative" semx-id="_7e856535-a684-c935-bf2a-0ffb7e001c95">
<title id="_6dc7eaac-8ff4-c6ce-69e1-c30880b0ac6d" semx-id="_f88fb684-97c0-a8b5-8fc4-a46cb6d5c50e">boreholeLength</title><fmt-title depth="5" id="_a232e9be-ff02-e162-965d-54b7e206b688"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>9<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>boreholeLength</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>9</fmt-xref-label>
<p id="_8cfff4b5-afad-ab2f-f7c3-8484f544afed" semx-id="_8cfff4b5-afad-ab2f-f7c3-8484f544afed">The property boreholeLength (SWE::Quantity) contains a measurement (a value and a unit of measurement) corresponding to the “length” of a borehole determined by the data provider (i.e., “length” can have different sources, like drillers measurement, loggers measurement, survey measurement, etc.).</p>
</clause>
</clause>

<clause id="_fb9bb9b5-0dfe-a137-4b2c-becc8911245e" obligation="normative" semx-id="_fb9bb9b5-0dfe-a137-4b2c-becc8911245e">
<title id="_e090eb59-71c4-1491-f024-08142abf8f2c" semx-id="_15eb532d-9bc5-2809-410f-41628676458b">OriginPosition</title><fmt-title depth="4" id="_ce49a068-5df4-1cba-d054-54ade8a84b1b"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>OriginPosition</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_34315eda-ee63-db8a-62a1-214cffd4cb79" semx-id="_34315eda-ee63-db8a-62a1-214cffd4cb79">A borehole OriginPosition is a feature corresponding to the start point of a borehole log.  This may correspond to the borehole collar location (e.g., kelly bush).</p>

<figure id="_af09b8db-52a7-a1f0-4d14-75cdb276e91c" width="518" semx-id="_af09b8db-52a7-a1f0-4d14-75cdb276e91c" autonum="81">
<name id="_5f50bf6b-c684-010b-75e0-e591dfcbe92e" semx-id="_bf9f3aca-bc62-85f4-4775-c8a78630dcbd">Origin position context diagram</name><fmt-name id="_eea6fb02-be56-dd14-0500-156dcea3d5bb"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 81</span><span class="fmt-caption-delim"> — </span>Origin position context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 81</fmt-xref-label>
<image id="_59bf82d6-aaf3-a931-19e2-c4626891516d" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/454f7139-e209-45d2-a9ff-18bb3587680c.png" extracted="true" mimetype="image/png" height="456" width="518" filename="images/image83.png" alt="Origin position context diagram." semx-id="_59bf82d6-aaf3-a931-19e2-c4626891516d"/></figure>

<p id="_59e07a8c-fe0d-891e-e422-201539a0f7a3" semx-id="_59e07a8c-fe0d-891e-e422-201539a0f7a3">If a text description of the location is available, it should be reported in the description property, inherited from GM:GFI_Feature. </p>

<clause id="_f4166ba9-b5ed-e070-e175-d8145bd8af5d" obligation="normative" semx-id="_f4166ba9-b5ed-e070-e175-d8145bd8af5d">
<title id="_067d341c-e2ae-3555-b115-c8da98041cf8" semx-id="_ba1b1db8-8020-1990-9b1f-8f71e1969797">location</title><fmt-title depth="5" id="_119b7854-ea43-e3cc-6bc6-51e0562c97ba"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>location</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_f67c07db-9062-7c70-af9b-131a81212843" semx-id="_f67c07db-9062-7c70-af9b-131a81212843">The property location contains a geometry corresponding to the location of the borehole collar.</p>

<p id="_7fea8d1e-2216-9100-4ed0-47d4130c4084" semx-id="_7fea8d1e-2216-9100-4ed0-47d4130c4084">If no GEO::GM_Point is available, an OGC nil value shall be used.</p>

<requirement id="_23a35b94-dc6c-4bc9-aa6a-4a6df0e7b6fb" anchor="req_gsml-borehole_borehole-position-null" model="ogc" semx-id="_7a9056a3-d4fb-e784-76f4-f333f6177837" autonum="30" original-id="req_gsml-borehole_borehole-position-null"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 30: <tt><xref style="id" target="req_gsml-borehole_borehole-position-null">/req/gsml-borehole/borehole-position-null</xref></tt></fmt-xref-label> <identifier id="_83af4073-a947-444a-b105-e5bb77f89c5b">/req/gsml-borehole/borehole-position-null</identifier><component class="part" semx-id="_7f07bde3-004a-4a48-2ed5-47f37da805e7" original-id="_7f07bde3-004a-4a48-2ed5-47f37da805e7"><p semx-id="_252ab9d0-58cb-d265-49cc-265546926cc6" original-id="_252ab9d0-58cb-d265-49cc-265546926cc6">If no GM_Point is available, an OGC nil value SHALL be used.</p>
</component>
<fmt-provision id="_812ee283-86f9-4fb9-55f9-8e7830a1db3c"><table id="req_gsml-borehole_borehole-position-null" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_a4bf4030-2814-229d-9001-dcc18bc96382"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 30</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/borehole-position-null</tt></td>
</tr><tr id="_7f07bde3-004a-4a48-2ed5-47f37da805e7"><th>A</th><td><p id="_252ab9d0-58cb-d265-49cc-265546926cc6" semx-id="_252ab9d0-58cb-d265-49cc-265546926cc6">If no GM_Point is available, an OGC nil value SHALL be used.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_48b84e28-4ab6-3cce-3af0-f78f593169da" semx-id="_48b84e28-4ab6-3cce-3af0-f78f593169da">In situations where the origin position changes over the life of the borehole (e.g., due to subsidence or destruction of the original collar), the origin position should be updated to the new location.</p>
</clause>

<clause id="_54a07c2f-471f-e409-4a22-fb7fbc0ec857" obligation="normative" semx-id="_54a07c2f-471f-e409-4a22-fb7fbc0ec857">
<title id="_45349874-6e6e-653b-52bc-1cae01187cc1" semx-id="_1637923f-1426-62c2-6009-19156d7639b6">elevation</title><fmt-title depth="5" id="_de8f6d60-47a3-49cc-2c3b-4b6553673626"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>elevation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_24439d64-0625-6201-74fd-e5d23f3a3e91" semx-id="_24439d64-0625-6201-74fd-e5d23f3a3e91">Implementers delivering 3-D origin locations should provide an elevation to improve interoperability.</p>

<requirement id="_15918387-122b-43a3-ab4a-e26260c31d2f" anchor="req_gsml-borehole_borehole-3d" model="ogc" semx-id="_19f62138-e47a-f075-1374-f5570eb0eb54" autonum="31" original-id="req_gsml-borehole_borehole-3d"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 31: <tt><xref style="id" target="req_gsml-borehole_borehole-3d">/req/gsml-borehole/borehole-3d</xref></tt></fmt-xref-label> <identifier id="_da6d17d7-8ffc-45e8-8b90-4fd216ee4f1f">/req/gsml-borehole/borehole-3d</identifier><component class="part" semx-id="_6954ba17-cd5c-d371-5f86-647228130a46" original-id="_6954ba17-cd5c-d371-5f86-647228130a46"><p semx-id="_9485d890-e5eb-5df7-3180-46bac776ef62" original-id="_9485d890-e5eb-5df7-3180-46bac776ef62">Implementers delivering 3-D origin locations SHOULD provide an elevation.</p>
</component>
<fmt-provision id="_e69f3f93-5497-ea32-dff0-20db7cf93582"><table id="req_gsml-borehole_borehole-3d" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_f1ea7821-d6ca-321a-963e-744c36eecf23"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 31</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/borehole-3d</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_40b0ce52-ad72-5e88-1f7a-165504826a9d">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_6954ba17-cd5c-d371-5f86-647228130a46"><th>A</th><td><p id="_9485d890-e5eb-5df7-3180-46bac776ef62" semx-id="_9485d890-e5eb-5df7-3180-46bac776ef62">Implementers delivering 3-D origin locations SHOULD provide an elevation.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_6c0e9b67-8410-6d1d-9706-079f89040277" semx-id="_6c0e9b67-8410-6d1d-9706-079f89040277">The elevation:DirectPosition property is a compromise approach to supply elevation explicitly for location; this is to allow for software that cannot process 3-D GM_Point. Null shall be used if elevation is unknown. A DirectPosition shall have a dimension of 1, and CRS will be a “vertical” CRS (e.g. EPSG CRSs in the range 5600-5799).</p>

<requirement id="_e9d19497-272c-473b-b613-759a87251f77" anchor="req_gsml-borehole-borehole-elevation-dim" model="ogc" semx-id="_4a05c43c-494d-0d04-d5a6-dc0b5e4a3b51" autonum="32" original-id="req_gsml-borehole-borehole-elevation-dim"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 32: <tt><xref style="id" target="req_gsml-borehole-borehole-elevation-dim">/req/gsml-borehole/borehole-elevation-dim</xref></tt></fmt-xref-label> <identifier id="_6d5e0db2-c385-4817-bed1-cac1b0ec3922">/req/gsml-borehole/borehole-elevation-dim</identifier><component class="part" semx-id="_5180aead-3eeb-024b-5c82-52984efdd8c1" original-id="_5180aead-3eeb-024b-5c82-52984efdd8c1"><p semx-id="_891ab893-73ec-8c23-7e21-39e28152d076" original-id="_891ab893-73ec-8c23-7e21-39e28152d076">Origin elevation SHALL be a geometry with a dimension of 1.</p>
</component>
<fmt-provision id="_c50bbc06-ed36-d210-b63d-13da019df96e"><table id="req_gsml-borehole-borehole-elevation-dim" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_b675ee35-7074-e22b-0adf-0e981cfe5345"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 32</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/borehole-elevation-dim</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_76067a23-befd-a8ae-7fe0-d392373a04e2">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_5180aead-3eeb-024b-5c82-52984efdd8c1"><th>A</th><td><p id="_891ab893-73ec-8c23-7e21-39e28152d076" semx-id="_891ab893-73ec-8c23-7e21-39e28152d076">Origin elevation SHALL be a geometry with a dimension of 1.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<requirement id="_cd3109d5-5d0b-4478-b136-262496725da6" anchor="req_gsml-borehole_borehole-elevation-CRS" model="ogc" semx-id="_5370f9ff-e840-a771-233b-c5db3c05e3cf" autonum="33" original-id="req_gsml-borehole_borehole-elevation-CRS"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 33: <tt><xref style="id" target="req_gsml-borehole_borehole-elevation-CRS">/req/gsml-borehole/borehole-elevation-CRS</xref></tt></fmt-xref-label> <identifier id="_3326d374-ca50-451a-b80f-d878352dbae0">/req/gsml-borehole/borehole-elevation-CRS</identifier><component class="part" semx-id="_73868929-a24e-63a6-b011-efa4e9ddd62b" original-id="_73868929-a24e-63a6-b011-efa4e9ddd62b"><p semx-id="_d7a59bab-fa23-0ac0-8f1b-b4144e8690f2" original-id="_d7a59bab-fa23-0ac0-8f1b-b4144e8690f2">Origin elevation srsName identifier SHALL be a vertical CRS having a EPSG in the range 5600-5799</p>
</component>
<fmt-provision id="_07c4c8b7-7b7d-634a-f250-4d3d2fff5081"><table id="req_gsml-borehole_borehole-elevation-CRS" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_1ea5ce49-ba05-2d98-24c3-12d68dcde866"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 33</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-borehole/borehole-elevation-CRS</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 7: <tt><xref style="id" target="req_class_gsml-borehole" id="_26b54eec-b8c8-d9d8-7689-b80082f7edc6">{spec-part1-uri}/req/gsml-borehole</xref><fmt-xref style="id" target="req_class_gsml-borehole">{spec-part1-uri}/req/gsml-borehole</fmt-xref></tt></td></tr><tr id="_73868929-a24e-63a6-b011-efa4e9ddd62b"><th>A</th><td><p id="_d7a59bab-fa23-0ac0-8f1b-b4144e8690f2" semx-id="_d7a59bab-fa23-0ac0-8f1b-b4144e8690f2">Origin elevation srsName identifier SHALL be a vertical CRS having a EPSG in the range 5600-5799</p>
</td></tr></tbody></table></fmt-provision></requirement>
</clause>
</clause>
</clause>

<clause id="_aac11acd-286d-fdcc-1b98-04f895f21a47" obligation="normative" semx-id="_aac11acd-286d-fdcc-1b98-04f895f21a47">
<title id="_866449f8-fff1-65ed-6f23-852ce7e4cad1" semx-id="_2a178db8-eefb-0b06-bd61-2b532d4eb1fa">GeoSciML Borehole vocabularies</title><fmt-title depth="3" id="_082f8377-6aef-e702-d116-3e69c2397764"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeoSciML Borehole vocabularies</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_d0491cef-896a-1c40-16f4-f88e2ddbaba1" semx-id="_d0491cef-896a-1c40-16f4-f88e2ddbaba1">Vocabularies used in Borehole package are listed in <xref target="tbl_geosciml_borehole_vocabularies" id="_db271013-d8d5-0376-7ded-ca858e4d3b0f"/><fmt-xref target="tbl_geosciml_borehole_vocabularies"><span class="fmt-element-name">Table</span> 7</fmt-xref>.</p>

<table id="tbl_geosciml_borehole_vocabularies" anchor="tbl_geosciml_borehole_vocabularies" width="100%" semx-id="_9bdde02b-617f-bea4-814e-5c513ae09b92" autonum="7"><colgroup><col width="32%"/><col width="68%"/></colgroup>
<name id="_edfecb0e-b730-e120-6bc0-fe8d3e50b65a" semx-id="_ef56f6cf-dc3a-e885-5e75-80f010ebe48c">GeoSciML Borehole vocabularies</name><fmt-name id="_004529bc-bddb-2071-6bbb-f6a430d99136"><span class="fmt-caption-label"><span class="fmt-element-name">Table</span> 7</span><span class="fmt-caption-delim"> — </span>GeoSciML Borehole vocabularies</fmt-name><fmt-xref-label><span class="fmt-element-name">Table</span> 7</fmt-xref-label>
<thead><tr id="_2acd0857-b6a7-fd08-2a63-f2e6f437c488" semx-id="_2acd0857-b6a7-fd08-2a63-f2e6f437c488"><th id="_f866cd4f-03cf-364f-0fd2-50a563cc7d07" valign="middle" align="center" semx-id="_f866cd4f-03cf-364f-0fd2-50a563cc7d07"><strong>Vocabulary</strong></th>
<th id="_742dea24-7d60-e482-8071-92a0df0f414d" valign="middle" align="center" semx-id="_742dea24-7d60-e482-8071-92a0df0f414d"><strong>Description</strong></th>
</tr></thead>
<tbody><tr id="_75d33ee1-fc13-4e70-2271-d5b9be6dce86" semx-id="_75d33ee1-fc13-4e70-2271-d5b9be6dce86"><td id="_e6bfcdee-9a30-516d-8915-3241433e3ab3" valign="middle" align="center" semx-id="_e6bfcdee-9a30-516d-8915-3241433e3ab3"><strong>BoreholeDrillingMethodCode</strong></td>
<td id="_f38d8435-757a-f101-3d89-a3e424616264" valign="middle" align="center" semx-id="_f38d8435-757a-f101-3d89-a3e424616264">This class is an indicative placeholder only for a vocabulary of terms describing the borehole drilling method.  Users are encouraged to use a vocabulary of terms managed by the CGI vocabularies working group. (e.g., auger, hand auger, air core, cable tool, diamond core, rotary air blast, etc.).</td>
</tr><tr id="_f8d94dcd-3dfc-b381-7142-c8b53fc446ca" semx-id="_f8d94dcd-3dfc-b381-7142-c8b53fc446ca"><td id="_97eba29a-0f28-41bb-1a5f-0d970e78dd9b" valign="middle" align="center" semx-id="_97eba29a-0f28-41bb-1a5f-0d970e78dd9b"><strong>BoreholeInclinationCode</strong></td>
<td id="_7f364ec1-4aa6-eb49-1a70-287b36be86cd" valign="middle" align="center" semx-id="_7f364ec1-4aa6-eb49-1a70-287b36be86cd"><p id="_6f754a83-a9dd-fae5-a48c-e1db687b67cc" semx-id="_6f754a83-a9dd-fae5-a48c-e1db687b67cc">This class is an indicative placeholder only for a vocabulary of terms describing the general orientation of a borehole.  Users are encouraged to use a vocabulary of terms managed by the CGI vocabularies working group.</p>

<p id="_44530747-6ad9-e47b-f288-b07fdf1d8489" semx-id="_44530747-6ad9-e47b-f288-b07fdf1d8489">For example:</p>

<ul id="_a65ae2a5-f1cf-c05d-dc1e-7ca49fc99eb1" semx-id="_a65ae2a5-f1cf-c05d-dc1e-7ca49fc99eb1"><li id="_8147b8a0-fcd0-8237-07b9-1d46e7c76f23"><fmt-name id="_59e1fa39-0ac9-5f6b-6b7a-da03f774fa6c">•</fmt-name><p id="_b82c9b12-f172-8d9c-44ec-362b1f3e27fe" semx-id="_b82c9b12-f172-8d9c-44ec-362b1f3e27fe">vertical</p>
</li>
<li id="_822f0f6f-c649-5920-fab6-6c6569d53a3a"><fmt-name id="_c7d5f764-1204-ed0d-3cdc-b39efd99c05d">•</fmt-name><p id="_5fe44285-4b87-f3f5-c5cf-2a5d0dab3092" semx-id="_5fe44285-4b87-f3f5-c5cf-2a5d0dab3092">horizontal</p>
</li>
<li id="_95b19f47-7969-61a2-55af-1709daa0417c"><fmt-name id="_768f3807-d9cb-d55d-a4c0-2bb736c4abc9">•</fmt-name><p id="_5a813401-e924-1cbd-b29c-cbadcbedc0e5" semx-id="_5a813401-e924-1cbd-b29c-cbadcbedc0e5">inclined up</p>
</li>
<li id="_8cb80c6d-00b4-9ebb-f1cc-27a80ad8682e"><fmt-name id="_e765bfa2-6e4f-402f-524f-2fec7e70bf24">•</fmt-name><p id="_4db12501-f741-fe70-4b77-9fa791cf00f2" semx-id="_4db12501-f741-fe70-4b77-9fa791cf00f2">inclined down</p>
</li>
</ul>
</td>
</tr><tr id="_bd033953-b3b1-7652-f923-f734eaea39ad" semx-id="_bd033953-b3b1-7652-f923-f734eaea39ad"><td id="_d9b4ecb1-01d4-9d35-5864-5a86f3dd4223" valign="middle" align="center" semx-id="_d9b4ecb1-01d4-9d35-5864-5a86f3dd4223"><strong>BoreholePurposeCode</strong></td>
<td id="_067b0fa5-2dda-6325-755f-3cbf856b02fe" valign="middle" align="center" semx-id="_067b0fa5-2dda-6325-755f-3cbf856b02fe">Place holder for a vocabulary containing terms describing the purpose for which the borehole was drilled.  e.g., mineral exploration, water pumping, site evaluation, stratigraphic research, etc.</td>
</tr><tr id="_2847401a-ca46-38ce-400a-4a114023fc92" semx-id="_2847401a-ca46-38ce-400a-4a114023fc92"><td id="_4405767b-1269-266d-48c0-7b8ab0fdb29d" valign="middle" align="center" semx-id="_4405767b-1269-266d-48c0-7b8ab0fdb29d"><strong>BoreholeStartPointCode</strong></td>
<td id="_b1c1efce-c8f4-ef63-8eb0-01b15cb554c9" valign="middle" align="center" semx-id="_b1c1efce-c8f4-ef63-8eb0-01b15cb554c9"><p id="_b5ca6661-f79d-1ae1-86de-d83080ed28af" semx-id="_b5ca6661-f79d-1ae1-86de-d83080ed28af">This class is an indicative placeholder only for a vocabulary of terms describing the location of the start of a borehole.  Users are encouraged to use a vocabulary of terms managed by the CGI vocabularies working group.</p>

<p id="_0ec5f140-be4d-19af-e415-b5192a6afee3" semx-id="_0ec5f140-be4d-19af-e415-b5192a6afee3">Examples may include:</p>

<ul id="_df6c116b-6515-1305-9d71-cddd3b312ec5" semx-id="_df6c116b-6515-1305-9d71-cddd3b312ec5"><li id="_72c54ee6-6bce-526d-2c3c-5eeb7d99d928"><fmt-name id="_e762a1f4-fa8b-593a-a410-cb982b8ae265">•</fmt-name><p id="_6fe1b7fc-8eb4-50d2-b722-fe0d17c6ff7f" semx-id="_6fe1b7fc-8eb4-50d2-b722-fe0d17c6ff7f">natural ground surface — drilling started from a natural topographic surface</p>
</li>
<li id="_eb6ba302-22b4-4f67-4c8f-e3a2791a70d4"><fmt-name id="_0952cf9e-9345-3658-3aee-6d706486db4a">•</fmt-name><p id="_03e7e956-d8a4-29f5-270e-02b79d7f2a26" semx-id="_03e7e956-d8a4-29f5-270e-02b79d7f2a26">open pit floor or wall — drilling started from the wall of an open pit or quarry</p>
</li>
<li id="_ebaa2811-5f0b-fb24-3e27-f8fce3a4d214"><fmt-name id="_42df37cb-06f3-20c0-de02-e1b1991f44ec">•</fmt-name><p id="_8fc71e0c-498d-2f79-5f2b-9da956fbf87e" semx-id="_8fc71e0c-498d-2f79-5f2b-9da956fbf87e">underground — drilling started from an underground location, such as a driveway, chamber or open-stope</p>
</li>
<li id="_b3cb7f8e-474d-367a-53bf-ede0a348adcf"><fmt-name id="_aea4e8a5-bb3d-4403-8156-d392dc1632bf">•</fmt-name><p id="_06ee0e43-e6f9-685c-8d3d-91b4f45cae64" semx-id="_06ee0e43-e6f9-685c-8d3d-91b4f45cae64">from pre-existing hole — new drill hole spudded off the wall of an existing hole</p>
</li>
</ul>
</td>
</tr></tbody>
</table>
</clause>
</clause>

<clause id="_bfea7e02-b4d9-9772-83ea-5b39ec90cf6f" obligation="normative" semx-id="_bfea7e02-b4d9-9772-83ea-5b39ec90cf6f">
<title id="_02ad5ea9-95a5-aa93-f8fc-d2f69dda1d3c" semx-id="_f07b9094-1550-fee2-8dfb-89ba1e4b8978">GeoSciML LaboratoryAnalysis-Specimen Requirements Class (Normative)</title><fmt-title depth="2" id="_6a17c721-70ba-eb1d-e031-d1a0db8d6c99"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeoSciML LaboratoryAnalysis-Specimen Requirements Class (Normative)</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8</fmt-xref-label>
<requirement id="_e61b3195-8337-4f58-9488-69e8f2afbefe" anchor="req_class_gsml-lab-analysis" model="ogc" type="class" semx-id="_02c35fee-25e4-b52b-0be3-9ffe29fe55f1" autonum="8" original-id="req_class_gsml-lab-analysis"><fmt-xref-label><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</xref></tt></fmt-xref-label>
<title>Requirements Class ‘GeoSciML LaboratoryAnalysis-Specimen’</title><identifier id="_63fa392a-022e-4bc1-aebd-b8f16062eac2">{spec-part1-uri}/req/gsml-lab-analysis</identifier><subject id="_98309a05-ce03-4734-942c-6e435d265c5f">Encoding</subject><inherit id="_067eed39-b371-4161-adec-df291e7ae8d9">ISO 19103 Conceptual Model Language</inherit><inherit id="_f36b4b84-d487-4952-94ae-7dc5b0e4c71e">ISO 19107 Spatial Schema</inherit><inherit id="_2ce0093a-b582-479f-81db-b20e7bb33b27">ISO-19156 Observations and Measurements (OGC Topic 20)</inherit><inherit id="_5e515c0c-5be5-414b-a325-5396c5a36bc9">SWE Common 2.0 08-094r1 Clause 7</inherit><inherit id="_b7c73b78-78c6-423d-8d4d-4b945e7454c2">ISO 19108 Temporal Schema</inherit><inherit id="_dfa4e5a4-8a09-425f-a1a8-2b813f2f2090">ISO 19115-3 Citation</inherit><requirement model="ogc" type="general" semx-id="_09f0ee68-6d6c-453a-9762-c748905352e0" autonum="8-1" original-id="_09f0ee68-6d6c-453a-9762-c748905352e0"> <identifier id="_e6b440c4-694d-4f25-b6f0-813133a947b2">/req/gsml-lab-analysis/sampledFeature</identifier></requirement><requirement model="ogc" type="general" semx-id="_94cfeaa9-dd10-3d55-d82f-de8ea44b74c9" autonum="8-2" original-id="_94cfeaa9-dd10-3d55-d82f-de8ea44b74c9"> <identifier id="_1cc1a4f6-1986-4bfa-bcea-87f32e460d50">/req/gsml-lab-analysis/accuracy-measure</identifier></requirement><requirement model="ogc" type="general" semx-id="_96404704-b31b-4c37-f032-9fb3437743f7" autonum="8-3" original-id="_96404704-b31b-4c37-f032-9fb3437743f7"> <identifier id="_8b4e2757-ea21-4f7e-b03c-6f2b84454da1">/req/gsml-lab-analysis/accuracy-vocabulary</identifier></requirement><recommendation model="ogc" type="general" semx-id="_28e06612-15a0-0536-0657-bcd10962ce30" autonum="8-1" original-id="_28e06612-15a0-0536-0657-bcd10962ce30"> <identifier id="_7059eb08-b452-43f7-a020-94860ccb2d52">/rec/gsml-lab-analysis/image-url</identifier></recommendation><recommendation model="ogc" type="general" semx-id="_b69175aa-5a27-3712-0e68-cf53984d8559" autonum="8-2" original-id="_b69175aa-5a27-3712-0e68-cf53984d8559"> <identifier id="_86203862-940c-4259-9ee6-6627c61f0e08">/rec/gsml-lab-analysis/image-process</identifier></recommendation><recommendation model="ogc" type="general" semx-id="_e3f0f0ec-660d-96d5-5e2f-c09324964361" autonum="8-3" original-id="_e3f0f0ec-660d-96d5-5e2f-c09324964361"> <identifier id="_0bc6d42c-4e10-4da4-baf0-4ec78bed162c">/rec/gsml-lab-analysis/outcrop-pattern</identifier></recommendation>

<fmt-provision id="_8a71fa15-aba5-907b-c30f-6b3516d7e44b"><table id="req_class_gsml-lab-analysis" type="recommendclass" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_abe37986-7351-20af-f33d-d6663fbdd029"><span class="fmt-caption-label"><span class="fmt-element-name">Requirements class</span> 8<span class="fmt-caption-delim">: </span>Requirements Class ‘GeoSciML LaboratoryAnalysis-Specimen’</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>{spec-part1-uri}/req/gsml-lab-analysis</tt></td>
</tr><tr><th>Target type</th><td>Encoding</td></tr><tr><th>Prerequisites</th><td>ISO 19103 Conceptual Model Language<br/>ISO 19107 Spatial Schema<br/>ISO-19156 Observations and Measurements (OGC Topic 20)<br/>SWE Common 2.0 08-094r1 Clause 7<br/>ISO 19108 Temporal Schema<br/>ISO 19115-3 Citation</td></tr><tr><th>Normative statements</th><td><bookmark id="_28e06612-15a0-0536-0657-bcd10962ce30"/><span class="fmt-caption-label"><span class="fmt-element-name">Recommendation</span> 1: <tt><xref style="id" target="rec_gsml-lab-analysis_image-url" id="_04ef04a7-2031-7a6a-2103-c71ea7e171ac">/rec/gsml-lab-analysis/image-url</xref><fmt-xref style="id" target="rec_gsml-lab-analysis_image-url">/rec/gsml-lab-analysis/image-url</fmt-xref></tt></span><br/><bookmark id="_b69175aa-5a27-3712-0e68-cf53984d8559"/><span class="fmt-caption-label"><span class="fmt-element-name">Recommendation</span> 2: <tt><xref style="id" target="rec_gsml-lab-analysis_image-process" id="_3b98087a-402b-b392-c9df-af63f6a51bd4">/rec/gsml-lab-analysis/image-process</xref><fmt-xref style="id" target="rec_gsml-lab-analysis_image-process">/rec/gsml-lab-analysis/image-process</fmt-xref></tt></span><br/><bookmark id="_e3f0f0ec-660d-96d5-5e2f-c09324964361"/><span class="fmt-caption-label"><span class="fmt-element-name">Recommendation</span> 3: <tt><xref style="id" target="rec_gsml-lab-analysis_outcrop-pattern" id="_e86e42ed-7f56-28b9-6950-db8a210b64cc">/rec/gsml-lab-analysis/outcrop-pattern</xref><fmt-xref style="id" target="rec_gsml-lab-analysis_outcrop-pattern">/rec/gsml-lab-analysis/outcrop-pattern</fmt-xref></tt></span><br/><bookmark id="_09f0ee68-6d6c-453a-9762-c748905352e0"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 34: <tt><xref style="id" target="req_gsml-lab-analysis_sampledFeature" id="_e808bfb7-a46c-4e0c-a7d0-40147df4b989">/req/gsml-lab-analysis/sampledFeature</xref><fmt-xref style="id" target="req_gsml-lab-analysis_sampledFeature">/req/gsml-lab-analysis/sampledFeature</fmt-xref></tt></span><br/><bookmark id="_94cfeaa9-dd10-3d55-d82f-de8ea44b74c9"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 35: <tt><xref style="id" target="req_gsml-lab-analysis_accuracy-measure" id="_4c8bd98e-384d-dfe3-8548-bfb610b8524c">/req/gsml-lab-analysis/accuracy-measure</xref><fmt-xref style="id" target="req_gsml-lab-analysis_accuracy-measure">/req/gsml-lab-analysis/accuracy-measure</fmt-xref></tt></span><br/><bookmark id="_96404704-b31b-4c37-f032-9fb3437743f7"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 36: <tt><xref style="id" target="req_gsml-lab-analysis_accuracy-vocabulary" id="_c3fb99dc-ebc7-c95d-66c5-7921d61b4da1">/req/gsml-lab-analysis/accuracy-vocabulary</xref><fmt-xref style="id" target="req_gsml-lab-analysis_accuracy-vocabulary">/req/gsml-lab-analysis/accuracy-vocabulary</fmt-xref></tt></span></td></tr></tbody></table></fmt-provision></requirement>

<p id="_d088ffb8-8e7d-2805-e645-38a94c8f63d5" semx-id="_d088ffb8-8e7d-2805-e645-38a94c8f63d5">The LaboratoryAnalysis-Specimen application model extends the ISO19156 model for Observations, Measurements and Sampling.  It specifically describes processes and results related to the analysis of (geological) samples using instruments, commonly in a laboratory environment. The design of this package is also informed by the MOLES v3 data model [21]. </p>

<figure id="_056abe3e-f2d6-a2c0-bf5e-8f367c467b53" width="601" semx-id="_056abe3e-f2d6-a2c0-bf5e-8f367c467b53" autonum="82">
<name id="_0b6a226f-55ce-4a10-03b9-af44705750b9" semx-id="_a2242128-82c4-c2ee-c0c6-98028491937b">LaboratoryAnalysis and Specimen dependencies</name><fmt-name id="_a335e3e7-ee8f-9804-fa25-b75f1c4a202c"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 82</span><span class="fmt-caption-delim"> — </span>LaboratoryAnalysis and Specimen dependencies</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 82</fmt-xref-label>
<image id="_20bf681b-c319-ab7e-d704-3cd264c4f5a4" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/d735645e-aee2-4663-b730-0e7a6515de36.png" extracted="true" mimetype="image/png" height="506" width="601" filename="images/image84.png" alt="LaboratoryAnalysis and Specimen dependencies." semx-id="_20bf681b-c319-ab7e-d704-3cd264c4f5a4"/></figure>

<clause id="_36101d1e-01e8-c431-c61b-cc932e27945c" obligation="normative" semx-id="_36101d1e-01e8-c431-c61b-cc932e27945c">
<title id="_5c9995be-dd32-7d80-f011-3c13e8937c6c" semx-id="_61dbe29f-7c82-3500-56c3-bc4796be83e8">LaboratoryAnalysis</title><fmt-title depth="3" id="_de587104-2d5d-4e1a-714f-23dbf0b476d8"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>LaboratoryAnalysis</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_36083fba-2590-b359-dccd-378b53e3ec6f" semx-id="_36083fba-2590-b359-dccd-378b53e3ec6f">The LaboratoryAnalysis leaf package describes processes, instruments and result quality associated with quantitative analysis of samples.  It is an application of ISO19156 Observations and Measurements with supplemental requirements over some of O&amp;M classes.</p>

<clause id="_c8c83d4a-b28b-4bc3-7f71-69c6ed7306b4" obligation="normative" semx-id="_c8c83d4a-b28b-4bc3-7f71-69c6ed7306b4">
<title id="_137d113a-27ee-29d3-dbe8-1f77a9ac7a6c" semx-id="_d7680d08-86a9-7801-5926-fda9d849c962">SF_SamplingFeature::sampledFeature</title><fmt-title depth="4" id="_6bd219d5-f662-1149-b62a-274d93c511c6"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>SF_SamplingFeature::sampledFeature</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_0a0cca2c-10b4-c630-c1f1-3e56a333a968" semx-id="_0a0cca2c-10b4-c630-c1f1-3e56a333a968">The “sampledFeature” association links the OM::SF_SamplingFeature to the feature which the sampling feature was designed to sample. The target of this association shall not be a sampling feature. It is shall a real-world feature from an application domain.</p>

<requirement id="_6fd30d8e-cdd4-4dc5-a383-865697a6d4bc" anchor="req_gsml-lab-analysis_sampledFeature" model="ogc" semx-id="_133ce84d-e111-6da2-b572-1c63f57ef922" autonum="34" original-id="req_gsml-lab-analysis_sampledFeature"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 34: <tt><xref style="id" target="req_gsml-lab-analysis_sampledFeature">/req/gsml-lab-analysis/sampledFeature</xref></tt></fmt-xref-label> <identifier id="_1a1b82c1-8f88-4db3-a024-027435410ba2">/req/gsml-lab-analysis/sampledFeature</identifier><component class="part" semx-id="_9d5e6cde-14e3-f59b-ae6b-6000909e7495" original-id="_9d5e6cde-14e3-f59b-ae6b-6000909e7495"><p semx-id="_039f9b24-0cda-0bd5-8f9e-4cc4a4b529e4" original-id="_039f9b24-0cda-0bd5-8f9e-4cc4a4b529e4">OM::SF_SamplingFeature::sampledFeature SHALL not be an instance of OM::SF_SamplingFeature.</p>
</component>
<fmt-provision id="_ab85c709-1e30-a130-a876-2d768eb6fb69"><table id="req_gsml-lab-analysis_sampledFeature" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_6e5ebb6a-a47a-cb49-b2dc-dbfe9027bbf1"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 34</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lab-analysis/sampledFeature</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis" id="_224dcffe-4555-3e0f-cdc9-e008890f7686">{spec-part1-uri}/req/gsml-lab-analysis</xref><fmt-xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</fmt-xref></tt></td></tr><tr id="_9d5e6cde-14e3-f59b-ae6b-6000909e7495"><th>A</th><td><p id="_039f9b24-0cda-0bd5-8f9e-4cc4a4b529e4" semx-id="_039f9b24-0cda-0bd5-8f9e-4cc4a4b529e4">OM::SF_SamplingFeature::sampledFeature SHALL not be an instance of OM::SF_SamplingFeature.</p>
</td></tr></tbody></table></fmt-provision></requirement>
</clause>

<clause id="_70f51609-1d50-f495-44a4-add7435ecc3d" obligation="normative" semx-id="_70f51609-1d50-f495-44a4-add7435ecc3d">
<title id="_5ec776cc-e6c3-f5a4-009b-40d7f51cd386" semx-id="_c910a65a-1582-e4e5-a3a0-fa19ded55b49">OM_Observation::resultQuality</title><fmt-title depth="4" id="_89987f0d-fd68-6c54-abea-406e7c3b76e1"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>OM_Observation::resultQuality</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_755b3bf3-7a85-96ff-5eed-5386e3f4daf6" semx-id="_755b3bf3-7a85-96ff-5eed-5386e3f4daf6">OM::OM_Observation::resultQuality::DQ_QuantitativeAttributeAccuracy attribute shall be used to represent analytical errors and detection limits for each analytical measurement.</p>

<p id="_63eb24e1-73e6-f45c-62d0-84f82dcddb4d" semx-id="_63eb24e1-73e6-f45c-62d0-84f82dcddb4d">At least “nameOfMeasure” and “result” shall be used when delivering om:resultQuality. </p>

<figure id="_77d2c3e1-2861-c844-4496-cc0df83654e1" width="415" semx-id="_77d2c3e1-2861-c844-4496-cc0df83654e1" autonum="83">
<name id="_b311e9b6-95e4-1232-3f74-afa386287a38" semx-id="_cfa2440a-53a8-7a57-b0b1-5a367c2ab6a3">DQ_Element from ISO19115:2003</name><fmt-name id="_0c77c65b-c247-dc2b-af4a-03442ea9b8cc"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 83</span><span class="fmt-caption-delim"> — </span>DQ_Element from ISO19115:2003</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 83</fmt-xref-label>
<image id="_cb620f38-2621-401f-954d-c39ad138dacb" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/ef3d92f5-5b5b-4650-8e22-d389d3cf04e0.png" extracted="true" mimetype="image/png" height="188" width="415" filename="images/image85.png" alt="DQ++_++Element from ISO19115:2003." semx-id="_cb620f38-2621-401f-954d-c39ad138dacb"/></figure>

<requirement id="_d7f0cfdb-6f5d-4146-b8ca-877e41106fb1" anchor="req_gsml-lab-analysis_accuracy-measure" model="ogc" semx-id="_02d97216-26b7-7528-10e0-b687ee2f993c" autonum="35" original-id="req_gsml-lab-analysis_accuracy-measure"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 35: <tt><xref style="id" target="req_gsml-lab-analysis_accuracy-measure">/req/gsml-lab-analysis/accuracy-measure</xref></tt></fmt-xref-label> <identifier id="_7af2e412-90f2-4aad-a115-ba6de89a0dec">/req/gsml-lab-analysis/accuracy-measure</identifier><component class="part" semx-id="_f9a6bba5-f2fb-1aea-e578-a48abddd26a8" original-id="_f9a6bba5-f2fb-1aea-e578-a48abddd26a8"><p semx-id="_ff224a85-5f3e-f641-8e08-851c52f75c02" original-id="_ff224a85-5f3e-f641-8e08-851c52f75c02">For analytical error and detection limits, both DQ_QuantitativeAttributeAccuracy::nameOfMeasure and DQ_QuantitativeAttributeAccuracy::result SHALL NOT be null.</p>
</component>
<fmt-provision id="_30e88545-9748-d840-ab50-e945e52c6bdf"><table id="req_gsml-lab-analysis_accuracy-measure" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_d84e3cfd-ef91-b15d-17bb-114d17ad4089"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 35</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lab-analysis/accuracy-measure</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis" id="_34ae57d1-8257-efbf-32de-e3ecb9b437f1">{spec-part1-uri}/req/gsml-lab-analysis</xref><fmt-xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</fmt-xref></tt></td></tr><tr id="_f9a6bba5-f2fb-1aea-e578-a48abddd26a8"><th>A</th><td><p id="_ff224a85-5f3e-f641-8e08-851c52f75c02" semx-id="_ff224a85-5f3e-f641-8e08-851c52f75c02">For analytical error and detection limits, both DQ_QuantitativeAttributeAccuracy::nameOfMeasure and DQ_QuantitativeAttributeAccuracy::result SHALL NOT be null.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_7efe80d7-d68a-7a13-6721-46c7498dec1b" semx-id="_7efe80d7-d68a-7a13-6721-46c7498dec1b">The CharacterString in “nameOfMeasure” should be a term from a controlled vocabulary.</p>

<requirement id="_bcf99c62-f59a-4b21-bac9-83d3b62498df" anchor="req_gsml-lab-analysis_accuracy-vocabulary" model="ogc" semx-id="_14009403-94d1-42e7-8007-42cb2e3fd94f" autonum="36" original-id="req_gsml-lab-analysis_accuracy-vocabulary"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 36: <tt><xref style="id" target="req_gsml-lab-analysis_accuracy-vocabulary">/req/gsml-lab-analysis/accuracy-vocabulary</xref></tt></fmt-xref-label> <identifier id="_ebcc5c2c-8630-421c-9e0b-f5e9c05b68bb">/req/gsml-lab-analysis/accuracy-vocabulary</identifier><component class="part" semx-id="_b8412e4c-014b-f470-1ca4-d51a4e6bad1a" original-id="_b8412e4c-014b-f470-1ca4-d51a4e6bad1a"><p semx-id="_c12640f4-0e3e-57a8-148a-5106d4b9d0e2" original-id="_c12640f4-0e3e-57a8-148a-5106d4b9d0e2">The value of DQ_Element:nameOfMeasure SHOULD be a term from a controlled vocabulary.</p>
</component>
<fmt-provision id="_0bfeedc5-ac26-edc5-931c-091e87832940"><table id="req_gsml-lab-analysis_accuracy-vocabulary" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_1315c1c3-3623-1315-139b-4e5f2969571a"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 36</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lab-analysis/accuracy-vocabulary</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis" id="_04377167-2a6b-d4f3-7835-86f0b0d11a76">{spec-part1-uri}/req/gsml-lab-analysis</xref><fmt-xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</fmt-xref></tt></td></tr><tr id="_b8412e4c-014b-f470-1ca4-d51a4e6bad1a"><th>A</th><td><p id="_c12640f4-0e3e-57a8-148a-5106d4b9d0e2" semx-id="_c12640f4-0e3e-57a8-148a-5106d4b9d0e2">The value of DQ_Element:nameOfMeasure SHOULD be a term from a controlled vocabulary.</p>
</td></tr></tbody></table></fmt-provision></requirement>
</clause>

<clause id="_885f5f8e-0ed6-fcc9-9ecf-0930634e95c5" obligation="normative" semx-id="_885f5f8e-0ed6-fcc9-9ecf-0930634e95c5">
<title id="_f3c34ac8-5179-2219-ecce-03aac79fc210" semx-id="_ec40c28e-2804-d73a-8118-4cd182ae33ad">OM_Observation::parameter</title><fmt-title depth="4" id="_ffb2ee2b-5c18-62ef-008b-103d711ba587"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>OM_Observation::parameter</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_e3d2a1f9-0407-60c7-c8ec-2823d544b819" semx-id="_e3d2a1f9-0407-60c7-c8ec-2823d544b819">Analytical methods are very varied and a single model cannot capture all the intricacies of all methods used in geoscience.  Communities that need to report specific parameters that are not covered by this specification can use NamedParameter.</p>

<figure id="_fdb8911a-27d9-fe74-40a9-23d94e4621e1" width="601" semx-id="_fdb8911a-27d9-fe74-40a9-23d94e4621e1" autonum="84">
<name id="_25de17af-4845-ad8f-a988-7978c7469607" semx-id="_1da62113-75b4-724c-ee33-42ad77a14dbc">Laboratory analysis summary diagram</name><fmt-name id="_e4da52ec-c721-9215-061d-b228a65f8739"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 84</span><span class="fmt-caption-delim"> — </span>Laboratory analysis summary diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 84</fmt-xref-label>
<image id="_2c000444-4f8f-d885-a168-91bc19471cbd" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/fc30d0f4-fa08-4d86-af84-e85a839b3616.png" extracted="true" mimetype="image/png" height="314" width="601" filename="images/image86.png" alt="Laboratory analysis summary diagram." semx-id="_2c000444-4f8f-d885-a168-91bc19471cbd"/></figure>
</clause>

<clause id="_c6eece9b-fe3a-18dc-c5e9-4f78ae233dc0" obligation="normative" semx-id="_c6eece9b-fe3a-18dc-c5e9-4f78ae233dc0">
<title id="_d90b38d0-4b30-fbf3-3a6f-3f3af235f34b" semx-id="_2e5ccc85-ea6e-3572-d16e-ec0b795cddb5">AnalyticalInstrument</title><fmt-title depth="4" id="_9a066486-6580-dcad-c35f-17cdad189735"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>AnalyticalInstrument</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_2270879b-f54c-8524-51bf-cc1b85e26a23" semx-id="_2270879b-f54c-8524-51bf-cc1b85e26a23">The analytical instrument is the category of instrument used to perform an analytical measurement or observation.</p>

<figure id="_6f078f48-f5ba-41e6-b528-bfdf1f9942d1" width="601" semx-id="_6f078f48-f5ba-41e6-b528-bfdf1f9942d1" autonum="85">
<name id="_e91152e5-845c-9dcb-2a47-f0d3ddcd8d5f" semx-id="_d7c9ae99-984e-b80d-f3c8-ab56bb9730e6">Analytical instrument context diagram</name><fmt-name id="_e428ea54-64db-32fe-d1ef-d49739c8f5de"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 85</span><span class="fmt-caption-delim"> — </span>Analytical instrument context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 85</fmt-xref-label>
<image id="_cae7fe49-aa51-701c-1a7b-aa4d39e95c70" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/45d8ef92-9b0f-4421-a1fe-c87943e4198e.png" extracted="true" mimetype="image/png" height="321" width="601" filename="images/image87.png" alt="Analytical instrument context diagram." semx-id="_cae7fe49-aa51-701c-1a7b-aa4d39e95c70"/></figure>

<clause id="_902bf649-497f-53a5-3fd7-b781967beafe" obligation="normative" semx-id="_902bf649-497f-53a5-3fd7-b781967beafe">
<title id="_20d3f4e7-9823-a50f-6022-8f4fbc196391" semx-id="_7369f730-6a5b-cece-6789-309f76eaa361">type</title><fmt-title depth="5" id="_bb4c1319-95a6-9462-6b18-d55ff757e7e3"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>type</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_2f07d25e-4ab2-802b-2be7-d2b95d624110" semx-id="_2f07d25e-4ab2-802b-2be7-d2b95d624110">The property type:InstrumentTypeTerm reports a term from a controlled vocabulary that describes the category of instrument used in an analytical session (e.g., XRF, ICPMS, SHRIMP, etc.).</p>
</clause>

<clause id="_3c106e05-21ed-d1a9-56dc-34cfe516901d" obligation="normative" semx-id="_3c106e05-21ed-d1a9-56dc-34cfe516901d">
<title id="_1e330af5-d96b-f6b1-39f5-05decd0a8c0d" semx-id="_79ee6c30-32bb-a3a1-aa50-d07e8fa8724a">model</title><fmt-title depth="5" id="_d6415021-67c3-d0be-a455-71003fdd3849"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>model</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_2883297c-852b-2b91-a20d-40aa64889b66" semx-id="_2883297c-852b-2b91-a20d-40aa64889b66">The property mode:Primitive::CharacterString contains a string identifying the model of instrument used. (e.g., instrument type = XRD, model = Siemens Diffraktometer D500).</p>
</clause>

<clause id="_a8ffeb61-944c-9822-0453-ef2dcf2b0256" obligation="normative" semx-id="_a8ffeb61-944c-9822-0453-ef2dcf2b0256">
<title id="_3f831950-ac94-4c00-0bf3-44d2e8395e89" semx-id="_0140959b-07ab-3dae-a028-28d7e8a94319">serialNumber</title><fmt-title depth="5" id="_34f7f52b-7466-5ca0-48ae-188f905018d0"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>serialNumber</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_7098c742-e5a9-3e67-465e-ae1bf20942a0" semx-id="_7098c742-e5a9-3e67-465e-ae1bf20942a0">The property serialNumber:Primitive::CharacterString contains a string that contains the serial number of the machine used in an analytical session.</p>
</clause>

<clause id="_fee2ff45-54e4-0a0d-3220-59ac7deb8ff4" obligation="normative" semx-id="_fee2ff45-54e4-0a0d-3220-59ac7deb8ff4">
<title id="_c46afe3b-b234-ee14-8d30-929708dcc5a8" semx-id="_0e59e780-b0c3-7343-ecfc-39e065609f37">commissionDate</title><fmt-title depth="5" id="_c6d272bd-873a-8de7-89dc-28bd7fcbac86"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>commissionDate</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_bb3bd245-a5c1-a706-d415-7e36ef85dfe2" semx-id="_bb3bd245-a5c1-a706-d415-7e36ef85dfe2">The property commissionDate is an association between an AnalyticalInstrument and a TM_Instant corresponding to the date of the commissioning of an instrument.</p>
</clause>

<clause id="_eaee397e-b22f-2506-db40-fbe43d49f9fd" obligation="normative" semx-id="_eaee397e-b22f-2506-db40-fbe43d49f9fd">
<title id="_da03539b-efe3-0842-2e5c-a4316912bebf" semx-id="_c3db60b0-2f30-5938-7d69-089ade179365">location</title><fmt-title depth="5" id="_4fde6765-3273-ad59-b0f1-43b7d49f7690"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>location</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_ce08362f-2fd9-2775-207f-fc74e3a58992" semx-id="_ce08362f-2fd9-2775-207f-fc74e3a58992">The property location is an association between an AnalyticalInstrument and a CIT:Responsibility describing the owner and the location of an instrument.</p>
</clause>

<clause id="_d9c1b28b-6c59-f456-89eb-77163bf56111" obligation="normative" semx-id="_d9c1b28b-6c59-f456-89eb-77163bf56111">
<title id="_9f7fd654-b3c2-4e89-066b-1b8522cef45f" semx-id="_c8ef95e9-b437-ca30-3bd7-be986dd4fc6e">usedIn</title><fmt-title depth="5" id="_c6e730d4-03c2-a8fb-c4c2-098daf03514e"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>usedIn</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_6dd1d9c8-5d94-3d99-df0f-f991996372a4" semx-id="_6dd1d9c8-5d94-3d99-df0f-f991996372a4">The property usedIn is an association between an AnalyticalInstrument and an AnalyticalSession identifying an analytical sessions which used this instrument.</p>
</clause>
</clause>

<clause id="_5f9d6feb-2f40-c9f7-4c60-2e842641b6df" obligation="normative" semx-id="_5f9d6feb-2f40-c9f7-4c60-2e842641b6df">
<title id="_95e780fa-b923-8cb1-b4e8-e8481c4e3e39" semx-id="_29814168-3191-48df-a059-3f19c8b8cea5">AnalyticalSession</title><fmt-title depth="4" id="_26aff3e7-10e6-59f0-01ba-73484da128e3"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>AnalyticalSession</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_7bf8509a-20de-d02a-397d-ba2d103514ca" semx-id="_7bf8509a-20de-d02a-397d-ba2d103514ca">This feature type describes the time and operator of a particular laboratory analytical session. AnalyticalSession also has associated links to the type of instrument and analytical method used, processing steps applied to data collected during a session, and instrument parameters unique to that session.</p>

<figure id="_8a41f0ef-d633-fb98-8e31-b5c42fc57eed" width="601" semx-id="_8a41f0ef-d633-fb98-8e31-b5c42fc57eed" autonum="86">
<name id="_159ad363-5778-9351-27d6-1903ecfb6487" semx-id="_6a57893c-bc1c-9fc6-a3b3-c18b4b444a8e">Analytical session context diagram</name><fmt-name id="_53c34821-235d-c39b-cbaf-0e6dfb8cc0d0"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 86</span><span class="fmt-caption-delim"> — </span>Analytical session context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 86</fmt-xref-label>
<image id="_ea44a836-7492-acc8-dc7c-03fb634126db" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/299363f8-fc0f-4df6-a909-5f4c341ab340.png" extracted="true" mimetype="image/png" height="475" width="601" filename="images/image88.png" alt="Analytical session context diagram." semx-id="_ea44a836-7492-acc8-dc7c-03fb634126db"/></figure>

<clause id="_76a37778-b48a-953c-be78-0f9325e4a828" obligation="normative" semx-id="_76a37778-b48a-953c-be78-0f9325e4a828">
<title id="_d636b331-4afd-5ae8-1deb-b24325cb926d" semx-id="_163f94d2-43a2-b920-c5b5-1084554acbb7">time</title><fmt-title depth="5" id="_49533c08-0cc8-a510-2de9-80ffe71fffc5"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>time</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_94955d46-0c60-9c86-6b45-c3e272cb151e" semx-id="_94955d46-0c60-9c86-6b45-c3e272cb151e">The property time is an association between an AnalyticalSession and a TM_Period describing the time period during which the analysis was performed.</p>
</clause>

<clause id="_7ed8d7ee-7c88-32cc-4d2d-b017f9f9c151" obligation="normative" semx-id="_7ed8d7ee-7c88-32cc-4d2d-b017f9f9c151">
<title id="_2305edf6-c5a3-e704-e9b8-a182398fbca1" semx-id="_3b4e374d-a7f3-b7a0-a450-cf3583b40dde">operator</title><fmt-title depth="5" id="_eed749c5-543e-60f0-49de-f43ae185ab61"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>operator</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_ed4e0e24-4715-416c-5614-07d7b1fa9d04" semx-id="_ed4e0e24-4715-416c-5614-07d7b1fa9d04">The property operator is an association between an AnalyticalSession and a CIT:CI_Responsability describing the operator or organisation responsible for the analytical session.</p>
</clause>

<clause id="_08beb238-69a7-f315-4ceb-09067c1cdd33" obligation="normative" semx-id="_08beb238-69a7-f315-4ceb-09067c1cdd33">
<title id="_b4ea97ff-ebba-225e-25fe-1844f274b8d3" semx-id="_a849741b-74d0-3d9a-b953-da828f99566f">parameter</title><fmt-title depth="5" id="_69f4829a-3edc-e940-d101-80f1b02a5079"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>parameter</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_418fabb3-6494-bdd5-95ce-c4957ef6cbbf" semx-id="_418fabb3-6494-bdd5-95ce-c4957ef6cbbf">The property parameter (OM::NamedValue) contains a name/value pair to describe arbitrary environmental or instrument setting parameters that apply to an entire analytical session (e.g., voltage, current, temperature, vacuum). The “name” attribute of NamedValue is a term from a controlled vocabulary.</p>
</clause>

<clause id="_55f48d53-0dfc-47eb-94e1-cee8c44c8ca1" obligation="normative" semx-id="_55f48d53-0dfc-47eb-94e1-cee8c44c8ca1">
<title id="_4c78b0bb-b815-8521-6533-25d89bad8488" semx-id="_6315012c-66eb-587f-a348-51957dadd372">instrument</title><fmt-title depth="5" id="_876e70a4-4046-f666-91a5-bd92c90c6464"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>instrument</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_7b1346c5-9a7f-1c6f-e119-60777fb6b470" semx-id="_7b1346c5-9a7f-1c6f-e119-60777fb6b470">The property instrument is an association between an AnalyticalSession and an AnalyticalInstrument that describes the instrument used in the analytical session.</p>
</clause>

<clause id="_23ff1c20-9519-7e12-a42e-22aeb088bec9" obligation="normative" semx-id="_23ff1c20-9519-7e12-a42e-22aeb088bec9">
<title id="_f80a9606-2aa5-b883-5c79-25be9dcbe585" semx-id="_8db16afb-e64d-bc62-6150-d63df12d417a">referenceAnalysis</title><fmt-title depth="5" id="_cfd00fd6-544e-c717-dca1-43fab5d6895b"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>referenceAnalysis</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_6a94fe17-9a6d-b0c8-39a3-45813edf3334" semx-id="_6a94fe17-9a6d-b0c8-39a3-45813edf3334">The property referenceAnalysis is an association between an AnalyticalSession and a ReferenceSpecimen that describes a reference specimen (i.e., standards, blanks) used in the analytical session.</p>
</clause>
</clause>

<clause id="_6704e8f5-84bd-3b78-801e-d001f8910e16" obligation="normative" semx-id="_6704e8f5-84bd-3b78-801e-d001f8910e16">
<title id="_e8e843de-f993-b209-694a-584a80ef541f" semx-id="_c8238008-8d75-2245-103a-6ada02f1f437">AnalyticalProcess</title><fmt-title depth="4" id="_daa203fa-ed25-59e3-42c4-0c69e0be3c8d"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>AnalyticalProcess</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_b04520b2-47df-14dc-81f2-0d54ea8f7937" semx-id="_b04520b2-47df-14dc-81f2-0d54ea8f7937">An analytical process is a concrete implementation of OM::OM_Process and describes the steps and methods used in an analytical session.  It links to an analytical session (data acquisition) or a computational process which produce analytical results.</p>

<figure id="_68daffff-7ee6-f030-062d-02d8b47c60fa" width="601" semx-id="_68daffff-7ee6-f030-062d-02d8b47c60fa" autonum="87">
<name id="_c4a31c96-a3ac-5860-2db4-b383b063724f" semx-id="_cc98d9db-2755-fc14-3da0-52be2250ad9a">Analytical process</name><fmt-name id="_ce036236-651e-e219-7450-a4deae0c04ad"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 87</span><span class="fmt-caption-delim"> — </span>Analytical process</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 87</fmt-xref-label>
<image id="_053c0837-983a-5219-3c9e-66586df33ec6" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/3ab0f9cd-e36e-48db-ab3b-4ee591f62939.png" extracted="true" mimetype="image/png" height="558" width="601" filename="images/image89.png" alt="Analytical process" semx-id="_053c0837-983a-5219-3c9e-66586df33ec6"/></figure>

<clause id="_c1cb7305-3636-7c2e-6c22-247d2a8f8a85" obligation="normative" semx-id="_c1cb7305-3636-7c2e-6c22-247d2a8f8a85">
<title id="_f6b5ef2b-305f-a300-3d25-fdcb4bdf92b4" semx-id="_b71c191c-d673-2ff5-a89c-fc23b7b3fd89">method</title><fmt-title depth="5" id="_542914bd-7fec-62a0-973d-2fa6bbab1eda"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>method</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_b6ae9500-d632-8d4e-0ebc-a486331f4ffa" semx-id="_b6ae9500-d632-8d4e-0ebc-a486331f4ffa">The property method is an association that links an AnalyticalProcess to an AnalyticalMethod that describes the type of analytical method used to make an observation.</p>
</clause>

<clause id="_5e8b404a-120d-be8f-16f1-306eb6466077" obligation="normative" semx-id="_5e8b404a-120d-be8f-16f1-306eb6466077">
<title id="_05021a57-38cc-b14e-75ec-995eca6d5e25" semx-id="_12b27928-1c89-78f8-3c27-819c897bf864">acquisition</title><fmt-title depth="5" id="_12896dbd-40d1-3172-d3f3-02ac4e2c730b"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>acquisition</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_70d077ba-eac4-1cae-2db3-b95e6a9b86cc" semx-id="_70d077ba-eac4-1cae-2db3-b95e6a9b86cc">The property acquisition is an association that links an AnalyticalProcess to an AnalyticalSession that describes the analytical session (e.g., laboratory session) in which an observation was made and data acquired.</p>
</clause>

<clause id="_bef7ec4b-1f8a-19b9-744f-d1dc1bb6bcfb" obligation="normative" semx-id="_bef7ec4b-1f8a-19b9-744f-d1dc1bb6bcfb">
<title id="_edf776f0-571f-f6ee-ae0f-64beba85036d" semx-id="_7a158a0d-68ae-06ce-ce6c-5263c487119d">computation</title><fmt-title depth="5" id="_7fad4a7f-6915-c012-c22c-9308dc08c849"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>computation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_4ffd1f52-92cf-b627-a5c8-2d3295bed4d7" semx-id="_4ffd1f52-92cf-b627-a5c8-2d3295bed4d7">The computation property is an association between an AnalyticalProcess and a CIT:ProcessStep that describes the computational process associated with the process.</p>
</clause>
</clause>

<clause id="_591fe887-abf8-83e5-53ee-bfa926a5a8c4" obligation="normative" semx-id="_591fe887-abf8-83e5-53ee-bfa926a5a8c4">
<title id="_0f48332f-7376-8014-efde-366927e00012" semx-id="_372c37c3-cce9-afcb-235b-1dd8b3c0b7e4">AnalyticalMethod</title><fmt-title depth="4" id="_343cf5c7-cf4b-6162-8597-cc4eb5cc7e90"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>AnalyticalMethod</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7</fmt-xref-label>
<p id="_c03873e5-a204-b47a-c076-42ed860fafa2" semx-id="_c03873e5-a204-b47a-c076-42ed860fafa2">The AnalyticalMethod provides the name, and published citation, of the analytical method used in an analytical session.</p>

<figure id="_6fc5afd4-c9c0-23d3-e311-b6c8a05b3ebb" width="526" semx-id="_6fc5afd4-c9c0-23d3-e311-b6c8a05b3ebb" autonum="88">
<name id="_b23c783a-23ed-e620-652c-cfc4c6e8df8c" semx-id="_c51d819b-5d12-6bc2-0ee0-9bf1e4c1ab53">Analytical method</name><fmt-name id="_f555703d-6714-feaf-581b-4617dfaeac16"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 88</span><span class="fmt-caption-delim"> — </span>Analytical method</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 88</fmt-xref-label>
<image id="_1485b292-5cf4-ef21-8783-68b051c2eb3a" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/25d3b9c6-fc31-4a1a-ba2e-bb0ddbda906f.png" extracted="true" mimetype="image/png" height="352" width="526" filename="images/image90.png" alt="Analytical method" semx-id="_1485b292-5cf4-ef21-8783-68b051c2eb3a"/></figure>

<clause id="_b8c0e399-9c9c-0d8f-d65a-f72a23c2ef59" obligation="normative" semx-id="_b8c0e399-9c9c-0d8f-d65a-f72a23c2ef59">
<title id="_e1636425-a965-464b-2509-3b36a7d2e5a6" semx-id="_5ae7130f-c745-fa35-51de-a7dd4bf79575">methodName</title><fmt-title depth="5" id="_691fe6ee-f77f-b43b-a19e-837bbc2021b2"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>methodName</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_3e9887f2-01e4-6e7b-c9a8-e9f27d931751" semx-id="_3e9887f2-01e4-6e7b-c9a8-e9f27d931751">The property methodName:AnalyticalMethodTerm contains a term from a controlled vocabulary that describes an analytical method used in a session (e.g., XRF mass spectrometry, ICPMS, SHRIMP geochronology).</p>
</clause>

<clause id="_a461ccc2-2c63-9217-4222-584beb49c5ec" obligation="normative" semx-id="_a461ccc2-2c63-9217-4222-584beb49c5ec">
<title id="_93938cc3-ecdb-f393-7361-0ae9b4fca9bf" semx-id="_547415ae-aabb-0299-380d-34bc87021a3a">citation</title><fmt-title depth="5" id="_f4d45570-19b6-8459-cc26-4033ed37629c"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>citation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_62c89d66-a947-dd70-79c5-96a8ddc916ff" semx-id="_62c89d66-a947-dd70-79c5-96a8ddc916ff">The citation property is an association between an AnalyticalMethod and a CIT:CI_Citation describing a published description of a particular analytical method (e.g., a standard operating procedure document).</p>
</clause>
</clause>

<clause id="_cb84ff96-02f9-4c05-d4ad-144b094925e3" obligation="normative" semx-id="_cb84ff96-02f9-4c05-d4ad-144b094925e3">
<title id="_bf7195ad-68dc-efe2-46c3-bbfb80ed4eec" semx-id="_863147c0-ca7d-feea-6211-c8cf6bfb5d67">Image</title><fmt-title depth="4" id="_d31b6b30-bae6-c7b6-8432-fac776e1ee21"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Image</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>8</fmt-xref-label>
<p id="_6cadb447-823b-fd1d-8414-b9af733d4b69" semx-id="_6cadb447-823b-fd1d-8414-b9af733d4b69">The Image feature type is used to describe images of sampling features, for example, photographs of ion microprobe grain mounts.</p>

<figure id="_0b22b9be-cac2-8d22-b796-c8af2bc603b4" width="305" semx-id="_0b22b9be-cac2-8d22-b796-c8af2bc603b4" autonum="89">
<name id="_c31fbab1-744d-9cb6-6e73-bbcc887d4865" semx-id="_405732a3-78ad-16df-ea35-c96a179c10a5">Image</name><fmt-name id="_cadec874-aac9-41ec-f273-0cfb85773086"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 89</span><span class="fmt-caption-delim"> — </span>Image</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 89</fmt-xref-label>
<image id="_9362b3cc-e394-fccb-db8d-5d1684d15574" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/0addce8b-1250-452f-b8c5-54b1194280ef.png" extracted="true" mimetype="image/png" height="353" width="305" filename="images/image91.png" alt="Image" semx-id="_9362b3cc-e394-fccb-db8d-5d1684d15574"/></figure>

<p id="_579c434f-759e-1da6-eb23-502bf224814a" semx-id="_579c434f-759e-1da6-eb23-502bf224814a">When the image is available online, the identifier of the image, a HTTP URI, should point to one or more representation of that image.</p>

<recommendation id="_c745c686-345d-4ca7-aa45-a0440c9e4e17" anchor="rec_gsml-lab-analysis_image-url" model="ogc" semx-id="_26ae200e-d357-d941-b5c7-382686c6e00d" autonum="1" original-id="rec_gsml-lab-analysis_image-url"><fmt-xref-label><span class="fmt-element-name">Recommendation</span> 1: <tt><xref style="id" target="rec_gsml-lab-analysis_image-url">/rec/gsml-lab-analysis/image-url</xref></tt></fmt-xref-label> <identifier id="_75da9a84-b4e4-407a-8829-3147ed216fbf">/rec/gsml-lab-analysis/image-url</identifier><component class="part" semx-id="_22fd0657-3fb1-efb8-8009-0e8d995bba66" original-id="_22fd0657-3fb1-efb8-8009-0e8d995bba66"><p semx-id="_d8abb2bb-4591-c876-d38b-69bb5341aa35" original-id="_d8abb2bb-4591-c876-d38b-69bb5341aa35">The identifier of the image should be a HTTP URI referring to a representation of the image.</p>
</component>
<fmt-provision id="_892252ba-4d0e-75cb-cec1-9b2a307a10f0"><table id="rec_gsml-lab-analysis_image-url" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_86f5813b-f345-08ac-3207-c2302524a1d0"><span class="fmt-caption-label"><span class="fmt-element-name">Recommendation</span> 1</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/rec/gsml-lab-analysis/image-url</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis" id="_ceef7d58-0f61-73e5-0f6e-a4932bc4661f">{spec-part1-uri}/req/gsml-lab-analysis</xref><fmt-xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</fmt-xref></tt></td></tr><tr id="_22fd0657-3fb1-efb8-8009-0e8d995bba66"><th>A</th><td><p id="_d8abb2bb-4591-c876-d38b-69bb5341aa35" semx-id="_d8abb2bb-4591-c876-d38b-69bb5341aa35">The identifier of the image should be a HTTP URI referring to a representation of the image.</p>
</td></tr></tbody></table></fmt-provision></recommendation>

<p id="_9b22cdea-4fa2-243f-11c7-177b287e10d1" semx-id="_9b22cdea-4fa2-243f-11c7-177b287e10d1">The samplingMethod (inherited from OM::SF_SamplingFeature) value for an image should be an identifier for a camera.</p>

<recommendation id="_cad331df-b929-4896-95a0-6325a09d7172" anchor="rec_gsml-lab-analysis_image-process" model="ogc" semx-id="_83d1efdf-890b-4043-a847-b67942fed872" autonum="2" original-id="rec_gsml-lab-analysis_image-process"><fmt-xref-label><span class="fmt-element-name">Recommendation</span> 2: <tt><xref style="id" target="rec_gsml-lab-analysis_image-process">/rec/gsml-lab-analysis/image-process</xref></tt></fmt-xref-label> <identifier id="_275eec34-f34a-4c4b-830b-9456ee31770f">/rec/gsml-lab-analysis/image-process</identifier><component class="part" semx-id="_475b325c-e753-b1cb-69c7-5389a6650ebc" original-id="_475b325c-e753-b1cb-69c7-5389a6650ebc"><p semx-id="_eb338009-a726-aff0-a750-74c82a0f4700" original-id="_eb338009-a726-aff0-a750-74c82a0f4700">The image om:procedure SHOULD make reference to a camera.</p>
</component>
<fmt-provision id="_c68b49ae-98c8-2fdc-9cb3-70a11c7d2aa3"><table id="rec_gsml-lab-analysis_image-process" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_ecdf8f28-d018-aa9e-742a-726498f6d06d"><span class="fmt-caption-label"><span class="fmt-element-name">Recommendation</span> 2</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/rec/gsml-lab-analysis/image-process</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis" id="_f9fd0627-18bd-5e9a-db98-29d495024f2e">{spec-part1-uri}/req/gsml-lab-analysis</xref><fmt-xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</fmt-xref></tt></td></tr><tr id="_475b325c-e753-b1cb-69c7-5389a6650ebc"><th>A</th><td><p id="_eb338009-a726-aff0-a750-74c82a0f4700" semx-id="_eb338009-a726-aff0-a750-74c82a0f4700">The image om:procedure SHOULD make reference to a camera.</p>
</td></tr></tbody></table></fmt-provision></recommendation>
</clause>
</clause>

<clause id="_5778af36-91f6-5e96-9733-e36cfe2bf092" obligation="normative" semx-id="_5778af36-91f6-5e96-9733-e36cfe2bf092">
<title id="_5b81232a-55a9-be5d-4d7c-b3d9e92b4e98" semx-id="_89e1d703-57e4-b5e6-5233-b2da59e2400f">Geochronology</title><fmt-title depth="3" id="_26589074-e585-ef2b-d46a-cb5a7aefaeb3"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Geochronology</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_e417b565-a2cd-12ea-997d-fcf65dd71d96" semx-id="_e417b565-a2cd-12ea-997d-fcf65dd71d96">The Geochronology model allows the delivery of geochronological interpretations by describing:</p>

<ol id="_4c7eae2d-eeca-0af9-4e65-e0285a23dcd3" type="arabic" semx-id="_4c7eae2d-eeca-0af9-4e65-e0285a23dcd3"><li id="_e330bc6d-195b-0702-2244-1fc26c161feb"><fmt-name id="_eeb02c1f-dd9c-c62c-9b15-a4c4422fa2b3">1<span class="fmt-label-delim">.</span></fmt-name><p id="_e1e7901e-8c88-3c8c-c046-fbc112ebddad" semx-id="_e1e7901e-8c88-3c8c-c046-fbc112ebddad">a OM::SF_Specimen (e.g., a rock sample)</p>
</li>
<li id="_7d47aa13-fbfb-8976-e164-29211e7fed0f"><fmt-name id="_51cb6f93-10cc-e833-4b61-21a50ffdb2a6">2<span class="fmt-label-delim">.</span></fmt-name><p id="_a343eb13-9b7b-6985-26bb-d7d181077bc8" semx-id="_a343eb13-9b7b-6985-26bb-d7d181077bc8">a related collection of sampling features within that specimen (e.g., ion probe burn spots, mineral separates),</p>
</li>
<li id="_157f0d20-c760-bc80-e5ee-29f68f369f0d"><fmt-name id="_9c615f82-c40e-9bfe-e198-d122f44984ed">3<span class="fmt-label-delim">.</span></fmt-name><p id="_014f9297-d58d-f52a-cb6d-b63f96889356" semx-id="_014f9297-d58d-f52a-cb6d-b63f96889356">and a GeochronologicInterpretation related to that sampling collection.</p>
</li>
</ol>

<p id="_03ae7983-b995-3281-df47-360bb06da6ca" semx-id="_03ae7983-b995-3281-df47-360bb06da6ca">Each member of the sampling collection has a related OM_Observation/result(s).</p>

<figure id="_387b7143-06be-1c3c-c3a1-68f3c780bb9e" width="601" semx-id="_387b7143-06be-1c3c-c3a1-68f3c780bb9e" autonum="90">
<name id="_e420d843-6f6d-99d3-71da-f0c1c65eaa31" semx-id="_3eb1fd5b-b15f-c62c-15f4-09452162ce58">Summary diagram of geochronology</name><fmt-name id="_e46c4593-693d-e9e2-e5a0-e19d6abaec88"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 90</span><span class="fmt-caption-delim"> — </span>Summary diagram of geochronology</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 90</fmt-xref-label>
<image id="_ad0ac04d-b756-22f8-ab15-df586fe6e298" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/2f17bddb-a65b-433d-9db2-2d4f415dad4b.png" extracted="true" mimetype="image/png" height="365" width="601" filename="images/image92.png" alt="Summary diagram of geochronology." semx-id="_ad0ac04d-b756-22f8-ab15-df586fe6e298"/></figure>

<clause id="_70635666-242c-25f2-21fb-f831b98dd3a5" obligation="normative" semx-id="_70635666-242c-25f2-21fb-f831b98dd3a5">
<title id="_e7866f0e-d6dc-ffab-c324-987537ef41ab" semx-id="_4870f9ee-c0cd-4e53-4948-9487224d21d8">GeochronologicInterpretation</title><fmt-title depth="4" id="_d01be1df-e42d-6182-4061-e23d0bf160d8"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeochronologicInterpretation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_d104c794-8e76-1e8c-5e55-fedf9301a346" semx-id="_d104c794-8e76-1e8c-5e55-fedf9301a346">A GeochronologicInterpretation is an interpretation made by a geologist of the age of a specimen made by statistical analysis of a collection of observations.  A geologic specimen may have multiple geochronological interpretations made on it, each related to a different observation/result collection.</p>

<figure id="_aff4d2fe-c91e-81ec-9c8b-daa6927ff342" width="596" semx-id="_aff4d2fe-c91e-81ec-9c8b-daa6927ff342" autonum="91">
<name id="_009e383b-838e-c2e5-2484-6027918cfcf6" semx-id="_a0faa964-393c-560c-5aca-8b04c68f3654">Geochronologic interpretation context diagram</name><fmt-name id="_7d1ed70b-41f7-3ac1-8c5a-f70cbec18a39"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 91</span><span class="fmt-caption-delim"> — </span>Geochronologic interpretation context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 91</fmt-xref-label>
<image id="_b1968361-4f47-8129-b606-feb90f5c72d1" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/001ac621-b0bf-4b3d-b1ce-68b73f682cb8.png" extracted="true" mimetype="image/png" height="556" width="596" filename="images/image93.png" alt="Geochronologic interpretation context diagram." semx-id="_b1968361-4f47-8129-b606-feb90f5c72d1"/></figure>

<clause id="_be6fe946-91de-0c3d-5fbb-99bf3162a9c2" obligation="normative" semx-id="_be6fe946-91de-0c3d-5fbb-99bf3162a9c2">
<title id="_8d41c2e2-dc7e-5b6f-e088-1f3d66dc1cea" semx-id="_e21e7a7b-b5ff-4242-fc32-805ff7237afa">interpretedAge</title><fmt-title depth="5" id="_50fbe140-b49f-e8cd-de40-ce82fdb34deb"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>interpretedAge</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_75a89d7e-1d3e-2a29-b185-4155fea11e8b" semx-id="_75a89d7e-1d3e-2a29-b185-4155fea11e8b">The interpretedAge property is an association between a GeochronologicInterpretation and a GeologicEvent that describes the dated event, process and environment.</p>

<p id="_e757d47f-3761-43f4-38f9-a16971a4c97b" semx-id="_e757d47f-3761-43f4-38f9-a16971a4c97b">For example:</p>

<ul id="_20a4962f-e7fa-8516-452a-dba50ffaea9d" semx-id="_20a4962f-e7fa-8516-452a-dba50ffaea9d"><li id="_e6423acf-27ae-7efa-5909-f03c9dc330d0"><fmt-name id="_da559f2f-92c6-506e-a480-61dcd5e86b35">•</fmt-name><p id="_a41ee65b-ecbb-dd69-65ec-29dadd8f88de" semx-id="_a41ee65b-ecbb-dd69-65ec-29dadd8f88de">Event age = 350 Ma +/- 3 Ma.</p>
</li>
<li id="_32d1a67a-3347-59c2-8c53-7078ac741fc4"><fmt-name id="_4b395558-c37e-9377-b654-3f24cc7bb547">•</fmt-name><p id="_dcc9334a-3f61-5dfc-b919-43b505820003" semx-id="_dcc9334a-3f61-5dfc-b919-43b505820003">Event process = intrusion, extrusion, metamorphism, etc.</p>
</li>
<li id="_285acdf0-b6e0-068f-7e85-58596f726a7c"><fmt-name id="_7ed8138e-3504-dd80-d67a-f76a8413d243">•</fmt-name><p id="_1622c399-2b93-aa0b-494a-544d275fd2f7" semx-id="_1622c399-2b93-aa0b-494a-544d275fd2f7">Event environment = plutonic, subaerial, marine, etc.</p>
</li>
</ul>
</clause>

<clause id="_f915f1aa-0989-3199-c305-2227cdbac688" obligation="normative" semx-id="_f915f1aa-0989-3199-c305-2227cdbac688">
<title id="_e00f0c62-a263-a58f-fadd-7a52ae8cf18f" semx-id="_d3c2a4ab-3e59-1d0d-ac0f-1d3eeb37cae6">isotopicEvent</title><fmt-title depth="5" id="_bd474af6-4e58-1dc8-223e-20e49e07156a"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>isotopicEvent</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_94419d82-d0d3-7fad-61d3-bfa110cf6ffd" semx-id="_94419d82-d0d3-7fad-61d3-bfa110cf6ffd">The isotopicEvent:IsotopicEventType contains a term from a controlled vocabulary that describes any isotopic events that are relevant to the interpretation. e.g., closure, isotopic mixing, Pb loss, etc.</p>
</clause>

<clause id="_f8a030b6-5db3-1af8-b021-c5ced570e462" obligation="normative" semx-id="_f8a030b6-5db3-1af8-b021-c5ced570e462">
<title id="_602ff21e-e27b-14f7-4a16-73e9ea11b08e" semx-id="_42bb1e97-ee6a-6e6e-e116-5dd75da9994e">isotopicSystem</title><fmt-title depth="5" id="_293aac0a-9c8c-da8f-801e-0761a7f11950"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>isotopicSystem</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_8cb76f6d-b082-3de8-cf0a-3476f6b8b51a" semx-id="_8cb76f6d-b082-3de8-cf0a-3476f6b8b51a">The property isotopicSystem:IsotopicSystemName contains a term from a controlled vocabulary that describes the isotopic system used to calculate geochronological age. A vocabulary would contain values such as: Ar-Ar, K-Ar, Nd-Sm, Pb-Pb, Rb-Sr, Re-Os, U-Pb, etc.</p>
</clause>

<clause id="_0f41c24c-5206-ce90-ec1c-5be63f730e86" obligation="normative" semx-id="_0f41c24c-5206-ce90-ec1c-5be63f730e86">
<title id="_ef137366-0732-01dd-3e3b-14e72e7e5268" semx-id="_3accea6d-5080-b672-c607-5ec75da2de51">statisticalMethod</title><fmt-title depth="5" id="_b7b0a2b7-57ec-f1ac-9181-71a6b221d027"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>statisticalMethod</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_b3ac5a98-3770-e721-dd17-dcb818acc00c" semx-id="_b3ac5a98-3770-e721-dd17-dcb818acc00c">The property statisticalMethod:StatisticalMethodTerm contains a term from a controlled vocabulary that describes the statistical method used to interpret the results.  (e.g., weighted mean, median, concordia, discordia, etc)</p>
</clause>

<clause id="_441829d2-cd6b-5d01-cd5b-12be32846f01" obligation="normative" semx-id="_441829d2-cd6b-5d01-cd5b-12be32846f01">
<title id="_2139280e-b417-7769-cde0-d5314c50b4b7" semx-id="_bb08d1a7-d5b0-32e6-cffe-789a2f4ee2be">interpretedBy</title><fmt-title depth="5" id="_0b369f05-b482-d007-8c98-9e6c78fedf0b"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>interpretedBy</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_7ec50373-3197-b3a7-6b93-7aff1ba3b195" semx-id="_7ec50373-3197-b3a7-6b93-7aff1ba3b195">The property interpretedBy is an association between a GeochronologicInterpretation and a CIT:CI_Responsability describing the party responsible for this interpretation.</p>
</clause>

<clause id="_8459db67-860a-7c92-8245-0d0ba6cc14cf" obligation="normative" semx-id="_8459db67-860a-7c92-8245-0d0ba6cc14cf">
<title id="_bc436633-2521-e5a7-63fb-a276b03827aa" semx-id="_865f2ba4-f6db-d1c6-198c-3014b6fd6c73">citation</title><fmt-title depth="5" id="_32cb26e9-35c7-1104-b641-0679ff5ef495"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>citation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_8009f20c-10ae-5be7-1eb1-7553bfbe086b" semx-id="_8009f20c-10ae-5be7-1eb1-7553bfbe086b">The citation property is an association between a GeochronologicInterpretation and a CIT:CI_Citation that describes authors and other reference information for an interpreted age.</p>
</clause>

<clause id="_42248a98-4ea4-9136-9b72-d804b3c5e03b" obligation="normative" semx-id="_42248a98-4ea4-9136-9b72-d804b3c5e03b">
<title id="_79590303-6701-5e54-5e21-26addf0c0dc8" semx-id="_4b78d2c3-4341-0a42-b99d-b20883a2ac2b">preferredInterpretation</title><fmt-title depth="5" id="_09d06e72-7095-cb68-aa0e-da5724db9cb5"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>preferredInterpretation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>7</fmt-xref-label>
<p id="_046365e4-69d9-e267-60eb-f3505f0188e9" semx-id="_046365e4-69d9-e267-60eb-f3505f0188e9">The property preferredInterpretation:Primitive::Boolean indicates whether this interpretation is the preferred interpretation (i.e., the analytical data may be reinterpreted).</p>
</clause>

<clause id="_db65502c-2e78-3184-4189-7c099c993e55" obligation="normative" semx-id="_db65502c-2e78-3184-4189-7c099c993e55">
<title id="_56d31904-e677-bed8-19cf-1f21c95643b3" semx-id="_a970bcc0-d202-09ba-aa24-d7e490116284">sourceCollection</title><fmt-title depth="5" id="_51daaaf8-73a4-9f7c-8f13-84de36c8bebe"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>sourceCollection</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>8</fmt-xref-label>
<p id="_aba58776-3c7c-fc5f-8159-e4e09da7fbe3" semx-id="_aba58776-3c7c-fc5f-8159-e4e09da7fbe3">The property sourceCollection is an association between a GeochronologicInterpretation and an OM::SF_SamplingFeatureCollection that lists a collection of OM::SF_SamplingFeature (e.g., a collection of burn spots or craters from a SHRIMP analytical session).  When legacy published data for which the SamplingFeatureCollection is unknown, it may be delivered with SamplingFeatureCollection = ‘unknown’.</p>
</clause>
</clause>
</clause>

<clause id="_26a15d28-e83b-d568-05fe-c86bd4eca0f8" obligation="normative" semx-id="_26a15d28-e83b-d568-05fe-c86bd4eca0f8">
<title id="_393db3d8-cfe8-9c1d-cca5-5da1481857a9" semx-id="_b43b6d17-4b91-831f-4b8e-ca7e5ec7a882">GeologicSpecimen</title><fmt-title depth="3" id="_6ae6dbb1-78df-3bc8-449a-bf0fc9e2b47b"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeologicSpecimen</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_447cca83-5002-ef3f-f5c6-4035714314cd" semx-id="_447cca83-5002-ef3f-f5c6-4035714314cd">The GeologicSpecimen package extends the ISO19156 O&amp;M model, and describes processes relevant to the sampling, preparation, and analysis of geologic specimens.</p>

<figure id="_620710df-21ac-111b-8b08-01cad4a12b0a" width="601" semx-id="_620710df-21ac-111b-8b08-01cad4a12b0a" autonum="92">
<name id="_86fed917-2d7a-9883-83a9-a6d6c0a113f2" semx-id="_5010aa9c-dffe-a340-9879-953b7db4e0bf">Geologic specimen summary diagram</name><fmt-name id="_313dacdd-2661-b25f-f5b2-4b81a9350494"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 92</span><span class="fmt-caption-delim"> — </span>Geologic specimen summary diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 92</fmt-xref-label>
<image id="_0d31eacb-9e23-e9c0-33f7-e49657f61e1f" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/5fff1ae4-26c4-4669-aca0-e18205a8d2fb.png" extracted="true" mimetype="image/png" height="534" width="601" filename="images/image94.png" alt="Geologic specimen summary diagram." semx-id="_0d31eacb-9e23-e9c0-33f7-e49657f61e1f"/></figure>

<clause id="_fef5a971-701a-6c51-a89b-a8cc4497b420" obligation="normative" semx-id="_fef5a971-701a-6c51-a89b-a8cc4497b420">
<title id="_11cd304f-a8a4-f762-2c0e-dd94668850b9" semx-id="_5f2bfcb2-f17b-775d-aa73-1367636a02ed">ReferenceSpecimen</title><fmt-title depth="4" id="_9a1d8ef1-5037-cc38-ef9f-4b14bbbcd9c9"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>ReferenceSpecimen</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_d03a2adb-18e8-8925-3e43-5eaf41611d7c" semx-id="_d03a2adb-18e8-8925-3e43-5eaf41611d7c">A reference specimen is a specimen with known or accepted values of some property.  The citation property describes the location of a published description of these values.  Reference specimens include analytical blanks.  ReferenceSpecimens are used in quality control procedures to assess method reproducibility.</p>

<p id="_1509cc5a-9826-7ddd-f9f9-03e555197128" semx-id="_1509cc5a-9826-7ddd-f9f9-03e555197128">Analytical results from a reference specimen analysed during an AnalyticalSession are delivered in the same way as the results of other specimens analysed in that session.</p>

<figure id="_a1e7dec2-0d44-3b96-a1a6-be9db4c03918" width="326" semx-id="_a1e7dec2-0d44-3b96-a1a6-be9db4c03918" autonum="93">
<name id="_cf3da4d7-611f-8cfc-2bdc-75fa861fc5cc" semx-id="_bc22c2ac-9938-5004-7f3e-9734a8b56ffe">Reference specimen context diagram</name><fmt-name id="_064094aa-7c41-063b-86d0-2a81aff2fd2b"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 93</span><span class="fmt-caption-delim"> — </span>Reference specimen context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 93</fmt-xref-label>
<image id="_428f356a-4dfa-78eb-70b5-05c702f0dad3" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/c8a123f0-2e0d-4755-b9ea-b207cf04b509.png" extracted="true" mimetype="image/png" height="497" width="326" filename="images/image95.png" alt="Reference specimen context diagram." semx-id="_428f356a-4dfa-78eb-70b5-05c702f0dad3"/></figure>

<clause id="_fb4be845-aef3-f848-d1fe-8055f3e6630e" obligation="normative" semx-id="_fb4be845-aef3-f848-d1fe-8055f3e6630e">
<title id="_04e9c98e-1a73-abad-0fd0-874fd79dd7cf" semx-id="_29142482-e32b-65d9-1232-d631bef20cef">referenceDescription</title><fmt-title depth="5" id="_36f1484f-f03a-09ff-1306-7d1da3f07096"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>referenceDescription</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_9dace2c8-c6d0-849a-4bd6-6a3b566bfb9c" semx-id="_9dace2c8-c6d0-849a-4bd6-6a3b566bfb9c">The property referenceDescription is an association between a ReferenceSpecimen and a CIT:CI_Citation that references a citation of published analytical results for this standard reference specimen.</p>
</clause>

<clause id="_d151e3c3-aaf2-b233-c1fe-d423fb57a2da" obligation="normative" semx-id="_d151e3c3-aaf2-b233-c1fe-d423fb57a2da">
<title id="_6eb7982e-19b1-2735-f284-f7ee1da04590" semx-id="_7a0a4a88-a1bd-0ebb-4304-09eeef5f1e46">usedIn</title><fmt-title depth="5" id="_636fc3f4-051b-4a37-5ac9-803a7c7c7e4a"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>usedIn</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_02957860-604c-4fa9-9858-4d1b368e24e8" semx-id="_02957860-604c-4fa9-9858-4d1b368e24e8">The property usedIn is an association between a ReferenceSpecimen and an AnalyticalSession in which the reference specimen was used.</p>
</clause>
</clause>

<clause id="_068c39ae-f2eb-3604-3a32-aa160eed47e6" obligation="normative" semx-id="_068c39ae-f2eb-3604-3a32-aa160eed47e6">
<title id="_a1b4ac47-ac0c-6caf-2e48-c6a88b96df8f" semx-id="_1934552a-9ad3-56d5-b322-90a8cac9f7d1">GeologicSpecimenPreparation</title><fmt-title depth="4" id="_b156d025-d7a8-4a23-66bc-a6c611546842"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeologicSpecimenPreparation</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_e116d5f3-cc7c-9f8f-23a1-69669a4645d1" semx-id="_e116d5f3-cc7c-9f8f-23a1-69669a4645d1">GeologicSpecimenPreparation is an extension of ISO Specimen::preparationStep to allow details of preparation steps to be delivered (e.g., filtration and mesh size, chemical additives, crushing methods, drying parameters, etc.).</p>

<figure id="_afbe6469-cd75-ec03-e80b-02789bd91ef7" width="601" semx-id="_afbe6469-cd75-ec03-e80b-02789bd91ef7" autonum="94">
<name id="_640e34e7-1e96-2c9a-206e-c2130c166f22" semx-id="_f54eab52-adff-0ed4-782e-e9e9d82a310c">Geologic specimen preparation context diagram</name><fmt-name id="_a60ebb72-59a2-5d4d-1990-21e2d130493a"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 94</span><span class="fmt-caption-delim"> — </span>Geologic specimen preparation context diagram</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 94</fmt-xref-label>
<image id="_d1e6e819-8962-b8a9-4fae-d365817c387a" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/2f5f8ca0-81e6-49a7-8c26-ee0033df2a0f.png" extracted="true" mimetype="image/png" height="497" width="601" filename="images/image96.png" alt="Geologic specimen preparation context diagram." semx-id="_d1e6e819-8962-b8a9-4fae-d365817c387a"/></figure>

<clause id="_113dd19f-97fb-2eb6-209f-cba26f270106" obligation="normative" semx-id="_113dd19f-97fb-2eb6-209f-cba26f270106">
<title id="_96085f08-921d-6aa1-f182-073c7f15dfc8" semx-id="_dcff97ee-6e9e-290b-7a05-139671874618">preparationMethod</title><fmt-title depth="5" id="_94309394-2a6e-a796-ed17-b3a7d08a3d87"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>preparationMethod</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_2ead267d-4270-c143-1c43-873a6184ddc3" semx-id="_2ead267d-4270-c143-1c43-873a6184ddc3">The preparationMethod:GeologicSpecimenPreparationTerm contains a term from a controlled vocabulary that describes the method employed for the preparation of a geologic specimen for further analysis.</p>
</clause>

<clause id="_7989e77a-4627-1779-6279-6f05658826a1" obligation="normative" semx-id="_7989e77a-4627-1779-6279-6f05658826a1">
<title id="_947634e8-619e-f51b-0874-e59f5ef8775a" semx-id="_72768859-17bf-4d8f-1302-6ac10d4d5f06">parameter</title><fmt-title depth="5" id="_d1310331-3018-b516-33b1-3029f0cf2035"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>parameter</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_c3744ac1-ca0f-24ad-420c-cf220471f3ce" semx-id="_c3744ac1-ca0f-24ad-420c-cf220471f3ce">The property parameter (OM::NamedValue) contains name/value pair to describe arbitrary parameters used in this preparation step (e.g., mesh size in a sieving process, type of chemical additives, parameters in a mineral separation process). The “name” attribute of NamedValue shall be a term from a controlled vocabulary.</p>
</clause>
</clause>

<clause id="_bbb80d1d-4ebe-51ca-36e1-66dc31c2da9d" obligation="normative" semx-id="_bbb80d1d-4ebe-51ca-36e1-66dc31c2da9d">
<title id="_ffa504f4-d1fa-2f14-2072-5b6a7c5b67fe" semx-id="_244900b0-835e-aa3a-e87e-b2685eb29958">GeologicSamplingMethod</title><fmt-title depth="4" id="_244cad0a-6891-1f98-a800-e8b593c83956"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeologicSamplingMethod</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<p id="_0324dea1-d65a-294d-fb83-7926e6531339" semx-id="_0324dea1-d65a-294d-fb83-7926e6531339">GeologicSamplingMethod is an implementation of OM::SF_Process to describe the method used to obtain a geologic specimen.</p>

<p id="_d751e8cf-f1b1-dc2c-82f2-b179a2b01bac" semx-id="_d751e8cf-f1b1-dc2c-82f2-b179a2b01bac">Examples include:</p>

<ul id="_8c688f95-adb9-1844-b0c1-784333c9f689" semx-id="_8c688f95-adb9-1844-b0c1-784333c9f689"><li id="_210f33e7-dbdd-72c3-39e2-23459ac0a577"><fmt-name id="_2136df68-2453-780a-76b2-42f2a4230806">•</fmt-name><p id="_8621eb8f-ce38-0aa8-5088-e40d535d1529" semx-id="_8621eb8f-ce38-0aa8-5088-e40d535d1529">diamond drilling</p>
</li>
<li id="_e1ee5d9f-17d2-6b53-3d16-9340c0e1ae98"><fmt-name id="_cd640ae3-b40f-f212-9afa-7a9465909916">•</fmt-name><p id="_c2678e2d-76ff-1b2d-deff-854058466c67" semx-id="_c2678e2d-76ff-1b2d-deff-854058466c67">percussion drilling</p>
</li>
<li id="_aa87351a-fe28-1574-7174-1c117b7fdf10"><fmt-name id="_e6d73a86-319b-3982-e5af-96e9bbf00800">•</fmt-name><p id="_c3ca0f63-45f9-3bb3-58d6-c75d4e7bb397" semx-id="_c3ca0f63-45f9-3bb3-58d6-c75d4e7bb397">piston core drilling</p>
</li>
<li id="_f69e1627-cd2c-0d1f-bc72-2462c70bf1d2"><fmt-name id="_ed85e8a3-9515-9b79-af64-063d685a945a">•</fmt-name><p id="_a4eae51f-5c4f-a01c-9227-e2081abefdf4" semx-id="_a4eae51f-5c4f-a01c-9227-e2081abefdf4">vibro core drilling</p>
</li>
<li id="_430d3a19-296d-d74c-8477-96bde06bbb14"><fmt-name id="_253d2daa-c5ff-d0b5-3a15-b54b6f9f8383">•</fmt-name><p id="_e1711d08-3200-7f02-c812-10f7e0f57c42" semx-id="_e1711d08-3200-7f02-c812-10f7e0f57c42">channel sampling</p>
</li>
<li id="_534ee5e8-80fa-dc5e-3d75-00aa0c035c5c"><fmt-name id="_44b08343-76bb-e528-43c7-feeb1ca3720a">•</fmt-name><p id="_8c5dac97-3377-c71f-ef1b-4bfb7b29bd99" semx-id="_8c5dac97-3377-c71f-ef1b-4bfb7b29bd99">sea floor dredging</p>
</li>
<li id="_525a3893-0949-b66f-ddac-eae432ff6ad3"><fmt-name id="_0a45103f-1657-8fa7-6d25-db16e6102b76">•</fmt-name><p id="_432e12d4-13dc-ca69-0de4-56c6512b2575" semx-id="_432e12d4-13dc-ca69-0de4-56c6512b2575">outcrop sampling</p>
</li>
</ul>

<figure id="_3b5eb619-b3eb-42fb-8d8f-256b1ce559c7" width="524" semx-id="_3b5eb619-b3eb-42fb-8d8f-256b1ce559c7" autonum="95">
<name id="_955386a7-56db-7290-ae9a-40bfaf5901e2" semx-id="_4da48633-2ca3-51f4-afe2-db9f9ec32596">Geologic sampling method</name><fmt-name id="_bc4f752d-6012-206e-b5db-f2b69e091ae6"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 95</span><span class="fmt-caption-delim"> — </span>Geologic sampling method</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 95</fmt-xref-label>
<image id="_618d27ae-92f8-725b-4779-1e6514b3a9c2" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/c94fd726-9b78-47e2-a2b5-41da10bc3c26.png" extracted="true" mimetype="image/png" height="484" width="524" filename="images/image97.png" alt="Geologic sampling method" semx-id="_618d27ae-92f8-725b-4779-1e6514b3a9c2"/></figure>

<clause id="_47dd6614-2e66-720b-76d8-86f3d4c9e638" obligation="normative" semx-id="_47dd6614-2e66-720b-76d8-86f3d4c9e638">
<title id="_a65f9ded-debf-c28e-568e-bb1d7b19265e" semx-id="_de7c4fdc-3cbb-14f9-c359-abbcb36c6387">method</title><fmt-title depth="5" id="_cd6a1c24-a42f-e83d-beda-ac63a6e76f0d"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>method</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<p id="_88f8244e-6c62-801f-514a-5b990cfba703" semx-id="_88f8244e-6c62-801f-514a-5b990cfba703">The property method:GeologicSamplingMethodTerm is a term from a controlled vocabulary that describes the process used to obtain or create a geologic specimen. e.g., diamond drilling, percussion drilling, piston core drilling, vibro core drilling, channel sampling, sea floor dredging, crushing, mineral separation, melting, outcrop sampling.</p>
</clause>

<clause id="_0c56ad84-6831-e12d-6cbf-838dc9e40291" obligation="normative" semx-id="_0c56ad84-6831-e12d-6cbf-838dc9e40291">
<title id="_3fc2a50f-531f-02c8-a9dc-89afbadec6ac" semx-id="_3d9d5b81-c518-07af-259e-90b2c5c068c8">parameter</title><fmt-title depth="5" id="_fb6d7ad4-0444-9f45-f984-6eefb8fdc62c"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>parameter</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_519c56f8-5648-7fea-7ee5-66cd6f3ac262" semx-id="_519c56f8-5648-7fea-7ee5-66cd6f3ac262">The property parameter (OM::NamedValue) contains a name/value pair to describe arbitrary parameters used in the sampling process.  The “name” attribute of NamedValue shall be a term from a controlled vocabulary.</p>
</clause>
</clause>
</clause>

<clause id="_a3b09579-ce80-1df6-2b27-ecfae373469a" obligation="normative" semx-id="_a3b09579-ce80-1df6-2b27-ecfae373469a">
<title id="_c20b6e0a-1721-11aa-39c7-3d0201374889" semx-id="_fcc4646d-9de5-4cd5-26aa-4445dd7e4787">GeoSciML LaboratoryAnalysis-Specimen vocabularies</title><fmt-title depth="3" id="_57dda74d-9436-0bc7-1989-70b3e0e0d1c4"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeoSciML LaboratoryAnalysis-Specimen vocabularies</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<p id="_d3f717e6-b881-8b13-313b-7cc11d8ecff6" semx-id="_d3f717e6-b881-8b13-313b-7cc11d8ecff6">Vocabularies used in the LaboratoryAnalysis-Specimen package are listed <xref target="tbl_lab_analysis_and_specimen_vocabularies" id="_588cf37f-c33d-0b46-14f3-3e461d6937d3"/><fmt-xref target="tbl_lab_analysis_and_specimen_vocabularies"><span class="fmt-element-name">Table</span> 8</fmt-xref>:</p>

<table id="tbl_lab_analysis_and_specimen_vocabularies" anchor="tbl_lab_analysis_and_specimen_vocabularies" width="100%" semx-id="_fed4a47a-6eab-4e1e-6b2b-eb792478b250" autonum="8"><colgroup><col width="38%"/><col width="62%"/></colgroup>
<name id="_418128d2-23aa-e28f-1a2a-b27a28affc11" semx-id="_b38ff345-ad45-d552-b945-c26016db7711">Laboratory analysis and specimen vocabularies</name><fmt-name id="_a4faac53-e7f4-f9ff-0473-1831ef68dd31"><span class="fmt-caption-label"><span class="fmt-element-name">Table</span> 8</span><span class="fmt-caption-delim"> — </span>Laboratory analysis and specimen vocabularies</fmt-name><fmt-xref-label><span class="fmt-element-name">Table</span> 8</fmt-xref-label>
<thead><tr id="_9d5aa619-9d22-0fc4-9d41-953ac4fe4768" semx-id="_9d5aa619-9d22-0fc4-9d41-953ac4fe4768"><th id="_5c0fb224-68a7-41f3-cfd1-84b1c21ac232" valign="middle" align="center" semx-id="_5c0fb224-68a7-41f3-cfd1-84b1c21ac232"><strong>Vocabulary</strong></th>
<th id="_57a2c47d-a0bc-8e6b-156f-9013e809800e" valign="middle" align="center" semx-id="_57a2c47d-a0bc-8e6b-156f-9013e809800e"><strong>Description</strong></th>
</tr></thead>
<tbody><tr id="_a49bc586-6db2-6431-4806-fc779056a39e" semx-id="_a49bc586-6db2-6431-4806-fc779056a39e"><td id="_cb6ebbf9-e1ce-2b28-2cab-0066e19b0713" valign="middle" align="center" semx-id="_cb6ebbf9-e1ce-2b28-2cab-0066e19b0713"><strong>AnalyticalMethodTerm</strong></td>
<td id="_2f8a0b41-ee94-a977-e6cc-26979987811f" valign="middle" align="center" semx-id="_2f8a0b41-ee94-a977-e6cc-26979987811f">Refers to a vocabulary of terms describing the analytical method used in an analytical session (e.g., XRF mass spectrometry, ICPMS, SHRIMP geochronology).</td>
</tr><tr id="_e9552edd-b05b-4bf3-61ba-7aef61680b61" semx-id="_e9552edd-b05b-4bf3-61ba-7aef61680b61"><td id="_7d9c6fb4-0378-4f96-bd17-3dfe0bf755c9" valign="middle" align="center" semx-id="_7d9c6fb4-0378-4f96-bd17-3dfe0bf755c9"><strong>InstrumentTypeTerm</strong></td>
<td id="_99b53cd2-f98e-9e61-3f1b-15de34815f05" valign="middle" align="center" semx-id="_99b53cd2-f98e-9e61-3f1b-15de34815f05">Refers to a vocabulary of Instrument types (e.g., XRF, ICPMS, SHRIMP, etc.).</td>
</tr><tr id="_7e28e5dd-9de6-0124-0b29-695089be11ec" semx-id="_7e28e5dd-9de6-0124-0b29-695089be11ec"><td id="_3c1b0582-9139-6dff-9431-c40a3c79f1d2" valign="middle" align="center" semx-id="_3c1b0582-9139-6dff-9431-c40a3c79f1d2"><strong>IsotopicEventType</strong></td>
<td id="_5ef9312b-2430-8ada-62ac-08cd82064252" valign="middle" align="center" semx-id="_5ef9312b-2430-8ada-62ac-08cd82064252">Refers to a vocabulary of terms to describe any isotopic processes relevant to the geochronologic interpretation. E.g. closure, isotopic mixing, Pb loss, etc.</td>
</tr><tr id="_fd2734f8-8402-2774-212d-efb85cb90f79" semx-id="_fd2734f8-8402-2774-212d-efb85cb90f79"><td id="_c01c0dbf-c2fb-dbd2-0e59-0f8383fba565" valign="middle" align="center" semx-id="_c01c0dbf-c2fb-dbd2-0e59-0f8383fba565"><strong>IsotopicSystemName</strong></td>
<td id="_d9e48b59-5a6a-28e7-f9c2-c36d08cd725a" valign="middle" align="center" semx-id="_d9e48b59-5a6a-28e7-f9c2-c36d08cd725a">Refers to a vocabulary of isotopic systems such as Ar-Ar, K-Ar, Nd-Sm, U-Pb, Pb-Pb, Re-Os, etc.</td>
</tr><tr id="_c38010dc-01fe-748e-0dc1-18fb61ff5b0b" semx-id="_c38010dc-01fe-748e-0dc1-18fb61ff5b0b"><td id="_05438c42-bbe8-a51b-b01c-2558114feecb" valign="middle" align="center" semx-id="_05438c42-bbe8-a51b-b01c-2558114feecb"><strong>StatisticalMethodTerm</strong></td>
<td id="_4b8aa077-2ecb-8936-fec9-ffe2c0d2281d" valign="middle" align="center" semx-id="_4b8aa077-2ecb-8936-fec9-ffe2c0d2281d">Refers to a vocabulary describing statistical methods used in interpret geochronologic data.</td>
</tr><tr id="_f0c50988-66d6-589d-8992-ef39a94439df" semx-id="_f0c50988-66d6-589d-8992-ef39a94439df"><td id="_241b7692-7229-faed-7dec-ef49e5687033" valign="middle" align="center" semx-id="_241b7692-7229-faed-7dec-ef49e5687033"><strong>GeologicSamplingMethodTerm</strong></td>
<td id="_c3de4e36-ad63-6028-2dfa-102e0c912e40" valign="middle" align="center" semx-id="_c3de4e36-ad63-6028-2dfa-102e0c912e40">Refers to a vocabulary of terms describing the samplingProcess used to obtain or create the Specimen. e.g., diamond drilling, percussion drilling, piston core drilling, vibro core drilling, channel sampling, sea floor dredging, crushing mineral separation, melting, outcrop sampling.</td>
</tr><tr id="_af0626fa-926a-c6ef-c971-97be9874e849" semx-id="_af0626fa-926a-c6ef-c971-97be9874e849"><td id="_18dc8e01-9fc1-724e-6f4a-03b8ac76dba3" valign="middle" align="center" semx-id="_18dc8e01-9fc1-724e-6f4a-03b8ac76dba3"><strong>GeologicSpecimenPreparationTerm</strong></td>
<td id="_5506536a-d18a-ca44-69d6-60376dd968d8" valign="middle" align="center" semx-id="_5506536a-d18a-ca44-69d6-60376dd968d8">Refers to a vocabulary of terms to describe sample preparation applied to geologic specimens, typically in preparation for analytical processes like geochemistry or microscopy.  e.g., crush, mineral separation, thin section, cut, polish, mount, acid digestion.</td>
</tr></tbody>
</table>
</clause>

<clause id="_80d730c4-57b4-8ff6-e615-e1a61116d165" obligation="normative" semx-id="_80d730c4-57b4-8ff6-e615-e1a61116d165">
<title id="_5ed26603-6a5f-2e62-2ef1-1049e3f458c3" semx-id="_9519dcf4-c12e-4bdf-63fc-b32c81312e32">Outcrop encoding pattern (Informative)</title><fmt-title depth="3" id="_c0120de0-ac1e-de6d-59e6-e54430632ef7"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Outcrop encoding pattern (Informative)</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<p id="_ce6f5c93-ba5b-5dbc-e68b-5edcebc44250" semx-id="_ce6f5c93-ba5b-5dbc-e68b-5edcebc44250">It is suggested to use SamplingFeatureCollection for representing geological field data collected at an outcrop, (i.e., an outcrop is modelled as a collection of sampling points).  At each point at an outcrop, observations may be made on a single geologic feature (sampledFeature), such as a geologic unit description, a fault description, a contact description, or structural measurements on a foliation.  If more than one geologic feature is observed at an outcrop, it is delivered as a separate sampling point.</p>

<figure id="_3d5f076b-cda3-4665-b39a-f9f8e38ae71b" width="601" semx-id="_3d5f076b-cda3-4665-b39a-f9f8e38ae71b" autonum="96">
<name id="_7f1870ff-8b96-d9c5-ad43-1c9c8e68a40f" semx-id="_f5b1b0e4-6ec0-91f2-8c2e-e448a3b55e73">Outcrop encoding pattern using ISO19156</name><fmt-name id="_bda116e4-c1e4-a406-2ac5-bad6e805ef39"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 96</span><span class="fmt-caption-delim"> — </span>Outcrop encoding pattern using ISO19156</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 96</fmt-xref-label>
<image id="_1fd9e1c0-dfc7-a6cf-daf8-aa05af24ffce" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/c72ba22e-4b78-46c1-8fbd-5b851e2f6155.png" extracted="true" mimetype="image/png" height="391" width="601" filename="images/image98.png" alt="Outcrop encoding pattern using ISO19156." semx-id="_1fd9e1c0-dfc7-a6cf-daf8-aa05af24ffce"/></figure>

<p id="_000713a6-83a5-5bf4-b6c7-4414a40b04c1" semx-id="_000713a6-83a5-5bf4-b6c7-4414a40b04c1">SamplingFeatureCollection might also be used to represent dredge hauls, measured sections, and other sorts of sampling features with multiple kinds of associated observations.</p>

<recommendation id="_72d831d7-b605-42a4-9d6a-c862a3027a53" anchor="rec_gsml-lab-analysis_outcrop-pattern" model="ogc" semx-id="_31805381-93d6-cc41-5af0-15b499388784" autonum="3" original-id="rec_gsml-lab-analysis_outcrop-pattern"><fmt-xref-label><span class="fmt-element-name">Recommendation</span> 3: <tt><xref style="id" target="rec_gsml-lab-analysis_outcrop-pattern">/rec/gsml-lab-analysis/outcrop-pattern</xref></tt></fmt-xref-label> <identifier id="_f8d9d316-a963-4c8e-a84e-1f2464c91775">/rec/gsml-lab-analysis/outcrop-pattern</identifier><component class="part" semx-id="_b9c56b0e-248f-5166-0b28-9af5be747846" original-id="_b9c56b0e-248f-5166-0b28-9af5be747846"><p semx-id="_450e86f3-f21e-7a02-de95-06de0d6ebb0b" original-id="_450e86f3-f21e-7a02-de95-06de0d6ebb0b">Observations at outcrop SHOULD be encoded using the pattern described at clause 8.8.5</p>
</component>
<fmt-provision id="_1dcbedbb-c2f8-108f-917d-3d759d06d53a"><table id="rec_gsml-lab-analysis_outcrop-pattern" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_9174a9f5-6fa6-c5e4-4e85-3db5722c4079"><span class="fmt-caption-label"><span class="fmt-element-name">Recommendation</span> 3</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/rec/gsml-lab-analysis/outcrop-pattern</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 8: <tt><xref style="id" target="req_class_gsml-lab-analysis" id="_b32b8fb3-bcdb-77ac-8fe5-28d9aaeda8e4">{spec-part1-uri}/req/gsml-lab-analysis</xref><fmt-xref style="id" target="req_class_gsml-lab-analysis">{spec-part1-uri}/req/gsml-lab-analysis</fmt-xref></tt></td></tr><tr id="_b9c56b0e-248f-5166-0b28-9af5be747846"><th>A</th><td><p id="_450e86f3-f21e-7a02-de95-06de0d6ebb0b" semx-id="_450e86f3-f21e-7a02-de95-06de0d6ebb0b">Observations at outcrop SHOULD be encoded using the pattern described at clause 8.8.5</p>
</td></tr></tbody></table></fmt-provision></recommendation>
</clause>
</clause>

<clause id="_b1a5be74-03a1-0b3b-119c-c1ce9e133b40" obligation="normative" semx-id="_b1a5be74-03a1-0b3b-119c-c1ce9e133b40">
