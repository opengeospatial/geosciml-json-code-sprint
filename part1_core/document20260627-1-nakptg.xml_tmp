<clause id="_33d163f7-ad0a-a583-cef0-9ccb64175a22" obligation="normative" semx-id="_33d163f7-ad0a-a583-cef0-9ccb64175a22">
<title id="_0239dbcc-b646-c022-e9ef-afa30bb18a02" semx-id="_1a55d937-8634-a9d1-2d25-b1c1d45eb834">GeoSciML Core Abstract Requirements Class (Normative)</title><fmt-title depth="2" id="_8faeda9f-7036-d933-a67e-021902ca7525"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>GeoSciML Core Abstract Requirements Class (Normative)</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<requirement id="_f97e0d56-4b2c-44d2-b3b6-5b14f2cd2407" anchor="req_class_a" model="ogc" type="class" semx-id="_bb133fd0-a7ac-a86f-fd03-abe9fd841190" autonum="2" original-id="req_class_a"><fmt-xref-label><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</xref></tt></fmt-xref-label>
