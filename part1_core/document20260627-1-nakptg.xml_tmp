om">/req/gsml-core/quantities-uom</fmt-xref></tt></span><br/><bookmark id="_d4890364-b3bb-3bf1-83cf-259cb7211414"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 7: <tt><xref style="id" target="req_gsml-core_quantities-single-range" id="_aef16446-5766-7f0a-145a-d126df8ba742">/req/gsml-core/quantities-single-range</xref><fmt-xref style="id" target="req_gsml-core_quantities-single-range">/req/gsml-core/quantities-single-range</fmt-xref></tt></span><br/><bookmark id="_bd970c06-bbbd-b5f3-8a66-38a4b41a97c5"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 8: <tt><xref style="id" target="req_gsml-core_codelist" id="_5cf5a21d-f7ea-a386-ac97-5dd76c5ea35b">/req/gsml-core/codelist</xref><fmt-xref style="id" target="req_gsml-core_codelist">/req/gsml-core/codelist</fmt-xref></tt></span></td></tr></tbody></table></fmt-provision></requirement>

<p id="_009627ab-fca6-5d94-c355-ffc64b9b60fb" semx-id="_009627ab-fca6-5d94-c355-ffc64b9b60fb">This section presents requirements to which all target encodings must conform in to order to claim compliance to GeoSciML 4.1.</p>

<clause id="_10bb9412-52dd-e9dc-fbe1-8ea2c39903ce" obligation="normative" semx-id="_10bb9412-52dd-e9dc-fbe1-8ea2c39903ce">
<title id="_52995328-b67b-4144-8caf-830dac75c357" semx-id="_95a7c0ac-fdef-472e-e797-7b5df01ee876">Naming of entities</title><fmt-title depth="3" id="_32e4a0c8-bd61-c3b2-969c-12ee632dc442"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Naming of entities</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<requirement id="_bf3e34bb-be7d-4216-b9c5-09d8a4cefaff" anchor="req_gsml-core_uml-entity-name" model="ogc" semx-id="_2b3564c4-feca-36d7-8ea0-d0a86c9a45e4" autonum="2" original-id="req_gsml-core_uml-entity-name"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 2: <tt><xref style="id" target="req_gsml-core_uml-entity-name">/req/gsml-core/uml-entity-name</xref></tt></fmt-xref-label> <identifier id="_b737beff-2e38-46a2-82d2-b79500e687ef">/req/gsml-core/uml-entity-name</identifier><component class="part" semx-id="_31443e8d-21ea-95ba-3aaf-bd3919bb7f67" original-id="_31443e8d-21ea-95ba-3aaf-bd3919bb7f67"><p semx-id="_a6036f05-5aa7-870c-c8a3-73cdfcdfe372" original-id="_a6036f05-5aa7-870c-c8a3-73cdfcdfe372">When the target implementation allows it, the exact name of the classifier SHALL be used.</p>
</component>
<fmt-provision id="_451119f8-cbb9-d46b-0182-6ff12dcf8174"><table id="req_gsml-core_uml-entity-name" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_e284e390-920e-5bdc-4712-d48d3c0518bc"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 2</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/uml-entity-name</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_a029b8dc-db19-b6d1-2782-88e686d06bab">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_31443e8d-21ea-95ba-3aaf-bd3919bb7f67"><th>A</th><td><p id="_a6036f05-5aa7-870c-c8a3-73cdfcdfe372" semx-id="_a6036f05-5aa7-870c-c8a3-73cdfcdfe372">When the target implementation allows it, the exact name of the classifier SHALL be used.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_817a529a-a81a-f28a-827d-3eb423574346" semx-id="_817a529a-a81a-f28a-827d-3eb423574346">If a target implementation is capable of encoding all the artefacts (classes and properties) using the same names used in UML, it shall do so.  Some target implementations might prevent it; for example, dBase (DBF files) column names are restricted to 10 characters or some RDBMS limits the use of camel case names.  But if the target allows it, the exact names shall be used.</p>
</clause>

<clause id="_87a59997-41dc-6008-a97a-f090bfc08c11" obligation="normative" semx-id="_87a59997-41dc-6008-a97a-f090bfc08c11">
<title id="_aad26fc6-45e1-fb99-27ec-9e7a34505d75" semx-id="_da7d97f4-3741-a648-2101-e527ccc665cb">Cardinality</title><fmt-title depth="3" id="_8058dde8-adcb-a8c5-656c-812d8b323c46"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Cardinality</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<requirement id="_dfe4a359-ecfe-46aa-bf1d-98ec0c2d5e91" anchor="req_gsml-core_uml-cardinality" model="ogc" semx-id="_da3e4640-1d5f-1a74-bf20-571a4adc8b67" autonum="3" original-id="req_gsml-core_uml-cardinality"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 3: <tt><xref style="id" target="req_gsml-core_uml-cardinality">/req/gsml-core/uml-cardinality</xref></tt></fmt-xref-label> <identifier id="_2dcf50bc-a91f-4c91-8c45-71b6665c02c0">/req/gsml-core/uml-cardinality</identifier><component class="part" semx-id="_b8b84078-9fc1-deca-ff06-be924f5db93b" original-id="_b8b84078-9fc1-deca-ff06-be924f5db93b"><p semx-id="_0e616ec7-a2c8-3fd9-eab9-2b4509e47c4a" original-id="_0e616ec7-a2c8-3fd9-eab9-2b4509e47c4a">If the target implementation allows it, it SHALL implement the same cardinality of properties and associations as defined in the UML.</p>
</component>
<fmt-provision id="_92012ee5-b26c-8991-3dbc-7f675e796214"><table id="req_gsml-core_uml-cardinality" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_b935f69a-7f7e-44e8-5a72-963ab27cd201"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 3</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/uml-cardinality</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_e114e315-19d0-7c8c-432d-efe514ee328d">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_b8b84078-9fc1-deca-ff06-be924f5db93b"><th>A</th><td><p id="_0e616ec7-a2c8-3fd9-eab9-2b4509e47c4a" semx-id="_0e616ec7-a2c8-3fd9-eab9-2b4509e47c4a">If the target implementation allows it, it SHALL implement the same cardinality of properties and associations as defined in the UML.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_7b800e5d-72e8-6226-6961-6008079c92ad" semx-id="_7b800e5d-72e8-6226-6961-6008079c92ad">Cardinality shall be the same as defined in UML model.  Since essentially all properties are optional, this clause addresses the upper bounds of cardinality: “1” or “many” in almost all cases.  Therefore, if the UML model limits a property’s maximum cardinality to “1”, then the target implementation cardinality cannot be “many”.</p>
</clause>

<clause id="_ded96440-8eb3-c96d-8b4e-d48ce3e2dedb" obligation="normative" semx-id="_ded96440-8eb3-c96d-8b4e-d48ce3e2dedb">
<title id="_d67462f3-07c5-7cfa-e935-55c24cf80d05" semx-id="_ce22ff50-c294-bfa9-cf2d-ade99b139fde">Abstract classes</title><fmt-title depth="3" id="_bd1929f6-9f62-168b-3f91-3a3f288e19c8"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Abstract classes</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<requirement id="_b729524a-c021-4bf5-9b21-c1a88cf82ccf" anchor="req_gsml-core_uml-abstract" model="ogc" semx-id="_4ac81bb3-3030-15e4-264f-ac7c1ae9c498" autonum="4" original-id="req_gsml-core_uml-abstract"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 4: <tt><xref style="id" target="req_gsml-core_uml-abstract">/req/gsml-core/uml-abstract</xref></tt></fmt-xref-label> <identifier id="_a9d90a06-1775-43db-9167-399b2777f9b8">/req/gsml-core/uml-abstract</identifier><component class="part" semx-id="_f68259ab-0e19-61cd-7363-395019e8a936" original-id="_f68259ab-0e19-61cd-7363-395019e8a936"><p semx-id="_9a840f77-e43d-b577-41c1-31fd4792d7a9" original-id="_9a840f77-e43d-b577-41c1-31fd4792d7a9">Abstract classes SHALL NOT be materialised.</p>
</component>
<fmt-provision id="_6dbb4dcb-b5c8-5918-cd23-424dca49ce00"><table id="req_gsml-core_uml-abstract" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_0ab07104-4b93-7da5-76b9-a543b4c8b272"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 4</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/uml-abstract</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_6f31bda6-c092-fcbc-81ef-041eff42236f">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_f68259ab-0e19-61cd-7363-395019e8a936"><th>A</th><td><p id="_9a840f77-e43d-b577-41c1-31fd4792d7a9" semx-id="_9a840f77-e43d-b577-41c1-31fd4792d7a9">Abstract classes SHALL NOT be materialised.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_6c5023c1-a45a-cc42-abd1-f535bf55f59b" semx-id="_6c5023c1-a45a-cc42-abd1-f535bf55f59b">Not all physical implementations support the concept of an abstract class, or even inheritance and polymorphism.  XSD does support that concept and all its implications, but JSON does not – although JavaScript can somewhat.  This requirement specifies that the encoding specification shall not allow materialisation of an instance of a class stereotyped as abstract.</p>
</clause>

<clause id="_ae4d3517-1229-ca95-b6a9-99f3ecd17ff6" obligation="normative" semx-id="_ae4d3517-1229-ca95-b6a9-99f3ecd17ff6">
<title id="_e76cea6e-fada-2340-ed8b-35f1fdbf6ddf" semx-id="_1c0e9a41-8d61-e392-8912-84363351160d">Polymorphism</title><fmt-title depth="3" id="_bb0cb687-a54a-05c1-e966-657ae39d2aac"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Polymorphism</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>4</fmt-xref-label>
<requirement id="_c7b20e7f-0cca-4a7a-a896-9ff33854fe7f" anchor="req_gsml-core_uml-polymorphism" model="ogc" semx-id="_cd2ca022-ccaa-bda3-dc06-cdd8884513cc" autonum="5" original-id="req_gsml-core_uml-polymorphism"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 5: <tt><xref style="id" target="req_gsml-core_uml-polymorphism">/req/gsml-core/uml-polymorphism</xref></tt></fmt-xref-label> <identifier id="_5b9bf599-3cdb-4cbc-a1e7-bdfd4448091e">/req/gsml-core/uml-polymorphism</identifier><component class="part" semx-id="_2ab4aee7-081d-c170-703d-18b9d854906f" original-id="_2ab4aee7-081d-c170-703d-18b9d854906f"><p semx-id="_71c3a57f-efaf-b2c5-ea08-25219125e24c" original-id="_71c3a57f-efaf-b2c5-ea08-25219125e24c">A target implementation SHALL implement type substitutions inferred from the UML model.</p>
</component>
<fmt-provision id="_38704bca-2a59-61e1-817a-4a845d3f6564"><table id="req_gsml-core_uml-polymorphism" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_6c83157f-a3ee-f908-1cbb-b4e0935c27d7"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 5</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/uml-polymorphism</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_53881b9b-0332-136b-1e7b-7c1b82d8e540">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_2ab4aee7-081d-c170-703d-18b9d854906f"><th>A</th><td><p id="_71c3a57f-efaf-b2c5-ea08-25219125e24c" semx-id="_71c3a57f-efaf-b2c5-ea08-25219125e24c">A target implementation SHALL implement type substitutions inferred from the UML model.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_c0cd2c43-a5b7-a196-4c10-07b7b9966583" semx-id="_c0cd2c43-a5b7-a196-4c10-07b7b9966583">The type hierarchy of the UML model implies type substitutions for property values.  For instance, a property value of type GeologicEvent can be substituted by a value of type DisplacementEvent because DisplacementEvent is a subtype of GeologicEvent.  Many property types are abstract types and only a concrete subtype may be materialised (as per /req/gsml4-core/uml-abstract).  A target implementation shall consider type substitutions using mechanisms available for this implementation.</p>
</clause>

<clause id="_12544db4-349c-1fd7-5b19-9c6c18cffddf" obligation="normative" semx-id="_12544db4-349c-1fd7-5b19-9c6c18cffddf">
<title id="_fb18bd28-ed3a-3022-d518-6c2b54d2d8e3" semx-id="_dd3dd054-56cf-d57c-2e05-0791b61a4b33">Quantities</title><fmt-title depth="3" id="_5f40af57-0f8f-f977-1f6d-200f99917cb7"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Quantities</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>5</fmt-xref-label>
<requirement id="_c80d2bb4-fc13-4e41-9670-4b642ac66146" anchor="req_gsml-core_quantities-uom" model="ogc" semx-id="_3575956e-4b25-d878-50fb-3bbdc71be5e0" autonum="6" original-id="req_gsml-core_quantities-uom"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 6: <tt><xref style="id" target="req_gsml-core_quantities-uom">/req/gsml-core/quantities-uom</xref></tt></fmt-xref-label> <identifier id="_8314d919-aeed-4afe-a1ba-8638b1978db4">/req/gsml-core/quantities-uom</identifier><component class="part" semx-id="_0b451c58-5b1d-50d1-d1d9-59bc27a648ba" original-id="_0b451c58-5b1d-50d1-d1d9-59bc27a648ba"><p semx-id="_95d594d6-47e0-5080-7768-c1f87ed10b5a" original-id="_95d594d6-47e0-5080-7768-c1f87ed10b5a">Quantities and measurements SHALL have explicit units of measure from a governed ontology.</p>
</component>
<fmt-provision id="_b6f9d9d2-9799-7b8e-368b-85052f498617"><table id="req_gsml-core_quantities-uom" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_dc530184-21b0-7314-40d1-4a7adff0c1ad"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 6</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/quantities-uom</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_acfbe44f-3de0-708c-e740-e1a0970ca091">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_0b451c58-5b1d-50d1-d1d9-59bc27a648ba"><th>A</th><td><p id="_95d594d6-47e0-5080-7768-c1f87ed10b5a" semx-id="_95d594d6-47e0-5080-7768-c1f87ed10b5a">Quantities and measurements SHALL have explicit units of measure from a governed ontology.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_8e6d0f7b-6679-95c1-1555-e0a27b874d47" semx-id="_8e6d0f7b-6679-95c1-1555-e0a27b874d47">The quantities and measurements units of measure shall be taken from a standard vocabulary governed by an appropriate community, for example the Unified Code for Units of Measure (UCUM).</p>
</clause>

<clause id="_f6bd5e03-7aac-2a4f-65ea-e4d5bca9d71d" obligation="normative" semx-id="_f6bd5e03-7aac-2a4f-65ea-e4d5bca9d71d">
<title id="_e0b464ff-26bf-cbe7-ab38-5ef2633da474" semx-id="_8432f3f6-5720-1764-b67f-0bfde431646a">QuantityRange</title><fmt-title depth="3" id="_b57d1b97-60ca-bde2-e917-453555e640b7"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>QuantityRange</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_fa3c8561-ec94-c687-9e98-94189d2e0aa5" semx-id="_fa3c8561-ec94-c687-9e98-94189d2e0aa5">A QuantityRange is a quantity formed of a lower and upper value forming a range of values.  If a single value needs to be represented as a QuantityRange, where the single value is assigned to both lower and upper properties.</p>

<requirement id="_09712435-b54a-41f9-a1da-a5beb4946cc8" anchor="req_gsml-core_quantities-single-range" model="ogc" semx-id="_e77c77b5-e60a-3f60-fb69-475195eb67ee" autonum="7" original-id="req_gsml-core_quantities-single-range"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 7: <tt><xref style="id" target="req_gsml-core_quantities-single-range">/req/gsml-core/quantities-single-range</xref></tt></fmt-xref-label> <identifier id="_76d928e7-676b-43e1-b7be-e931c998e30b">/req/gsml-core/quantities-single-range</identifier><component class="part" semx-id="_2490645d-43ad-6574-3528-cf0a895a7c69" original-id="_2490645d-43ad-6574-3528-cf0a895a7c69"><p semx-id="_b75a58ba-a05b-23cf-9d65-7ecbe404da07" original-id="_b75a58ba-a05b-23cf-9d65-7ecbe404da07">QuantityRange properties that must report a single value SHALL assign both lower and upper value as equal to that single value.</p>
</component>
<fmt-provision id="_df61e8ea-039c-297f-59b0-c6ac240c5b3d"><table id="req_gsml-core_quantities-single-range" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_40caa00f-4534-507b-8d43-28ee5ade50d0"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 7</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/quantities-single-range</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_f9d8b263-07ea-01a1-90dd-d153c12f0115">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_2490645d-43ad-6574-3528-cf0a895a7c69"><th>A</th><td><p id="_b75a58ba-a05b-23cf-9d65-7ecbe404da07" semx-id="_b75a58ba-a05b-23cf-9d65-7ecbe404da07">QuantityRange properties that must report a single value SHALL assign both lower and upper value as equal to that single value.</p>
</td></tr></tbody></table></fmt-provision></requirement>
</clause>

<clause id="_3aa25c41-ce09-f624-8e54-3a7213703833" obligation="normative" semx-id="_3aa25c41-ce09-f624-8e54-3a7213703833">
<title id="_0094c52f-054f-a65b-473b-bf73478aa3f0" semx-id="_fa568655-cfbd-09b8-7d33-2d64f4af76df">Code lists</title><fmt-title depth="3" id="_003eda55-0566-b944-e3da-b1b593ef51fc"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>7<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Code lists</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>7</fmt-xref-label>
<requirement id="_80b0d272-d979-45f6-859a-f66039e0b557" anchor="req_gsml-core_codelist" model="ogc" semx-id="_c18c9eab-ef3f-2fe4-2d03-f447fc5b88ec" autonum="8" original-id="req_gsml-core_codelist"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 8: <tt><xref style="id" target="req_gsml-core_codelist">/req/gsml-core/codelist</xref></tt></fmt-xref-label> <identifier id="_9f88da48-9857-4bca-be38-87ac88bd8a39">/req/gsml-core/codelist</identifier><component class="part" semx-id="_3e1a71f3-4b60-358d-77e5-31d996a4538a" original-id="_3e1a71f3-4b60-358d-77e5-31d996a4538a"><p semx-id="_efbed6d3-7424-a147-9542-1c686fe03990" original-id="_efbed6d3-7424-a147-9542-1c686fe03990">Empty classes with stereotype <tt>&lt;&lt;CodeList&gt;&gt;</tt> SHALL be implemented as externally governed vocabularies which terms are encoded as URI (RFC 3986).</p>
</component>
<fmt-provision id="_fec59ca0-0e1d-2ff2-c88e-9f3064dda124"><table id="req_gsml-core_codelist" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_9e2d6cc7-c0a0-a3c0-7a4c-8a0fcdde9562"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 8</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-core/codelist</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 2: <tt><xref style="id" target="req_class_a" id="_de511e32-cffd-a707-af23-781413d67c37">{spec-part1-uri}/req/gsml-core</xref><fmt-xref style="id" target="req_class_a">{spec-part1-uri}/req/gsml-core</fmt-xref></tt></td></tr><tr id="_3e1a71f3-4b60-358d-77e5-31d996a4538a"><th>A</th><td><p id="_efbed6d3-7424-a147-9542-1c686fe03990" semx-id="_efbed6d3-7424-a147-9542-1c686fe03990">Empty classes with stereotype <tt>&lt;&lt;CodeList&gt;&gt;</tt> SHALL be implemented as externally governed vocabularies which terms are encoded as URI (RFC 3986).</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_530a4b53-d080-e1ca-6dba-7795987666c6" semx-id="_530a4b53-d080-e1ca-6dba-7795987666c6">All properties that require formal vocabularies are modelled in the UML as classes having the stereotype &lt;&lt;CodeList&gt;&gt;.  The list of valid terms is either prescribed by this specification, with a list of possible entries (<xref target="img_example_codelists" id="_eb2ea6b7-957b-1d5d-9136-c79e97094729"/><fmt-xref target="img_example_codelists"><span class="fmt-element-name">Figure</span> 9</fmt-xref>) or open (i.e., without any terms).</p>

<figure id="img_example_codelists" anchor="img_example_codelists" width="118" semx-id="_323fe3f1-594e-a1b6-f220-63b7d6d938ab" autonum="9">
<name id="_876eb542-4950-6418-0e41-c0a0d745426f" semx-id="_422bf0e8-a4f5-40b6-fa8e-202b0e02f17a">Example CodeLists, with a) a prescribed list of terms (DescriptionPurpose) and b) &apos;open&apos; with no prescribed terms (GeologicUnitHierarchyRoleTerm)</name><fmt-name id="_d870cae5-131a-601b-510d-6a8f42c4d0f0"><span class="fmt-caption-label"><span class="fmt-element-name">Figure</span> 9</span><span class="fmt-caption-delim"> — </span>Example CodeLists, with a) a prescribed list of terms (DescriptionPurpose) and b) &apos;open&apos; with no prescribed terms (GeologicUnitHierarchyRoleTerm)</fmt-name><fmt-xref-label><span class="fmt-element-name">Figure</span> 9</fmt-xref-label>
<image id="_e0558b9a-4ce0-c1f2-037f-0ecd36aa136f" src="/metanorma/_tmp_images_65b3acdb-36cc-47eb-a666-0bea4272a3cc/cef24337-85e5-4e49-8b10-21ea7aa9f3dc.png" extracted="true" mimetype="image/png" height="96" width="118" filename="images/image9.png" semx-id="_e0558b9a-4ce0-c1f2-037f-0ecd36aa136f"/></figure>

<p id="_ee925d27-6741-c49f-1a87-7e0ef096697d" semx-id="_ee925d27-6741-c49f-1a87-7e0ef096697d">When the list is open, the vocabulary is managed externally over the web where each vocabulary term should be encoded as a resource.  Vocabulary term identifiers are URIs representing concepts from a standard vocabulary governed by an appropriate community — for example, the IUGS CGI Geoscience Terminology Working Group (<link target="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html" id="_1c100f07-c059-a311-8772-acf722cd3d81">http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html</link><fmt-link target="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html">http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html</fmt-link> and <link target="http://resource.geosciml.org/" id="_5089b323-ce36-7406-b25f-14df05078ca8">http://resource.geosciml.org/</link><fmt-link target="http://resource.geosciml.org/">http://resource.geosciml.org/</fmt-link>) or INSPIRE [8].</p>

<p id="_57452394-dc13-a8d9-6315-3a0d138967a3" semx-id="_57452394-dc13-a8d9-6315-3a0d138967a3">This requirement does not require that URIs be actually dereferenceable, but just that a vocabulary term is associated with a syntactically correct URI.</p>
</clause>
</clause>

<clause id="_2436543c-3174-4adc-8932-808b93f180b5" obligation="normative" semx-id="_2436543c-3174-4adc-8932-808b93f180b5">
<title id="_83ef906c-9713-fb1d-776e-8a3996ca8f40" semx-id="_e2b9dc8b-dd31-4bf3-fdf5-adab917718c7">Linked Open Data Requirements Class (Normative)</title><fmt-title depth="2" id="_4cfdbe68-31a0-463e-1586-f98086f61147"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Linked Open Data Requirements Class (Normative)</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<requirement id="_33a4554a-26e6-4f32-a0c5-5b276b4987e8" anchor="req_class_gsml4-lob" model="ogc" type="class" semx-id="_7c0aa6b0-f58b-d3e7-c35e-b4384f4c3d74" autonum="3" original-id="req_class_gsml4-lob"><fmt-xref-label><span class="fmt-element-name">Requirements class</span> 3: <tt><xref style="id" target="req_class_gsml4-lob">{spec-part1-uri}/req/gsml-lod</xref></tt></fmt-xref-label>
<title>Requirements Class ‘Linked Open Data’</title><identifier id="_888f4941-2710-4532-959f-a011e34b1c6d">{spec-part1-uri}/req/gsml-lod</identifier><subject id="_bcd2587c-e3ce-4610-a0a5-bcbc65366d46">Encoding</subject><inherit id="_4846ea5b-831c-46a8-bd01-65213de77379">URI</inherit><inherit id="_3d613a47-26a0-464b-bab0-49f5c8c799d7">HTTP</inherit><requirement model="ogc" type="general" semx-id="_a023fd92-a7c2-9706-63c9-29bdbb92768d" autonum="3-1" original-id="_a023fd92-a7c2-9706-63c9-29bdbb92768d"> <identifier id="_eb9a2a41-bfaf-4f96-a75e-11bddd907ffb">/req/gsml-lod/codelistURI</identifier></requirement><requirement model="ogc" type="general" semx-id="_35f3de1d-38c7-7a2b-9092-a7ba40c70c00" autonum="3-2" original-id="_35f3de1d-38c7-7a2b-9092-a7ba40c70c00"> <identifier id="_dabff2ac-ca74-499a-8226-79a2a70e984b">/req/gsml-lod/identifier</identifier></requirement><requirement model="ogc" type="general" semx-id="_e499fb5c-31a7-5301-5756-8ad4fa15d663" autonum="3-3" original-id="_e499fb5c-31a7-5301-5756-8ad4fa15d663"> <identifier id="_812dc890-9457-4d2c-9b54-4ad12f479699">/req/gsml-lod/gsml-representation</identifier></requirement><requirement model="ogc" type="general" semx-id="_c00d3c62-52c2-35ac-a03d-7de19a2e913a" autonum="3-4" original-id="_c00d3c62-52c2-35ac-a03d-7de19a2e913a"> <identifier id="_3c40f4bb-7524-429a-a9da-1191ff039be0">/req/gsml-lod/byref</identifier></requirement>

<fmt-provision id="_f20e9e8f-a29e-e54f-913f-e441860c66f1"><table id="req_class_gsml4-lob" type="recommendclass" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_267971db-00a4-e867-3e08-87ed4f78908e"><span class="fmt-caption-label"><span class="fmt-element-name">Requirements class</span> 3<span class="fmt-caption-delim">: </span>Requirements Class ‘Linked Open Data’</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>{spec-part1-uri}/req/gsml-lod</tt></td>
</tr><tr><th>Target type</th><td>Encoding</td></tr><tr><th>Prerequisites</th><td>URI<br/>HTTP</td></tr><tr><th>Normative statements</th><td><bookmark id="_a023fd92-a7c2-9706-63c9-29bdbb92768d"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 9: <tt><xref style="id" target="req_gsml-lod_codelistURI" id="_e00ce386-36ba-0c15-d83d-40ef9e1b26db">/req/gsml-lod/codelistURI</xref><fmt-xref style="id" target="req_gsml-lod_codelistURI">/req/gsml-lod/codelistURI</fmt-xref></tt></span><br/><bookmark id="_35f3de1d-38c7-7a2b-9092-a7ba40c70c00"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 10: <tt><xref style="id" target="req_gsml-lod_identifier" id="_28989cae-7813-4de0-64d9-1153390e049f">/req/gsml-lod/identifier</xref><fmt-xref style="id" target="req_gsml-lod_identifier">/req/gsml-lod/identifier</fmt-xref></tt></span><br/><bookmark id="_e499fb5c-31a7-5301-5756-8ad4fa15d663"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 11: <tt><xref style="id" target="req_gsml-lod_gsml-representation" id="_351efd88-1a59-c215-991f-7955c6649c9b">/req/gsml-lod/gsml-representation</xref><fmt-xref style="id" target="req_gsml-lod_gsml-representation">/req/gsml-lod/gsml-representation</fmt-xref></tt></span><br/><bookmark id="_c00d3c62-52c2-35ac-a03d-7de19a2e913a"/><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 12: <tt><xref style="id" target="req_gsml-lod_byref" id="_124e1cc0-7681-21b8-a888-cf60eeb1f122">/req/gsml-lod/byref</xref><fmt-xref style="id" target="req_gsml-lod_byref">/req/gsml-lod/byref</fmt-xref></tt></span></td></tr></tbody></table></fmt-provision></requirement>

<p id="_eda19a39-469c-4bff-332a-ad1a0e39da9c" semx-id="_eda19a39-469c-4bff-332a-ad1a0e39da9c">Although OGC standards are not restricted to a web environment, they are strongly influenced by this environment.  GeoSciML was originally developed specifically for XML, but many other encodings are suitable hypermedia formats (RDF/XML, JSON-LD, HTML).  This requirements class describes extra rules that shall be implemented to turn GeoSciML data instances into hypermedia compatible with Linked Open Data principles.</p>

<p id="_d7da4a4b-5fc1-f677-b0ab-66c9a5243517" semx-id="_d7da4a4b-5fc1-f677-b0ab-66c9a5243517">Linked Open Data is a method to publish structured data on the web.  It leverages existing web technologies such as HTTP (transfer protocol) and URI (addressing over the web) to connect structured resources.  The principle is similar to interconnected web pages through hyperlinks, except that pages are replace with structured information that can be processed by machines.</p>

<p id="_02819430-38ab-01d5-d4c2-32f9cde823dc" semx-id="_02819430-38ab-01d5-d4c2-32f9cde823dc">The following requirements essentially impose that URI used as vocabulary, identifiers and references can be “dereferenced”, which is “<em>The act of retrieving a representation of a resource identified by a URI</em>”https://docs.ogc.org/is/16-008/16-008.html#_ftnref2[<underline>[2]</underline>] from the web.  A resource can have multiple representations (GML, XML, RDF, etc.) and this specification does not impose a particular one, although it is common sense in this context to provide a GeoSciML representation for geological features.</p>

<p id="_404002a2-8e9e-2e1b-2123-7a84f4c2b5f0" semx-id="_404002a2-8e9e-2e1b-2123-7a84f4c2b5f0">It is important to note that a HTTP URI in this context is <underline>both</underline> an identifier and a location.  The same identifier is used to refer to any number of representations.  Therefore, different representations are selected through content negotiation with the server.</p>

<clause id="_998c78f6-d88b-935f-43e4-fc2b86633602" obligation="normative" semx-id="_998c78f6-d88b-935f-43e4-fc2b86633602">
<title id="_9b06fc86-a64b-cb0d-d961-7744ed6dea78" semx-id="_7384691f-29e3-6d5e-194e-4e8b1ccfa11e">Code lists URI</title><fmt-title depth="3" id="_ae147c0f-2fff-4deb-2a66-f2d1fde2c970"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Code lists URI</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>1</fmt-xref-label>
<requirement id="_0b5486da-b3c5-47c0-96e7-b8489345ac8e" anchor="req_gsml-lod_codelistURI" model="ogc" semx-id="_fe58cf64-ada7-e269-a131-71c8d2aa04fc" autonum="9" original-id="req_gsml-lod_codelistURI"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 9: <tt><xref style="id" target="req_gsml-lod_codelistURI">/req/gsml-lod/codelistURI</xref></tt></fmt-xref-label> <identifier id="_8b6389df-ba36-4d4a-8f7d-e1f3798a8171">/req/gsml-lod/codelistURI</identifier><component class="part" semx-id="_4eeb909a-c1f6-0ea7-3bd2-965489906207" original-id="_4eeb909a-c1f6-0ea7-3bd2-965489906207"><p semx-id="_eeb8e5ec-ffcf-d61e-96a5-6f2bd0eb24e4" original-id="_eeb8e5ec-ffcf-d61e-96a5-6f2bd0eb24e4">URI used for vocabulary terms SHALL be dereferenceable to one or more representations of the vocabulary term.</p>
</component>
<fmt-provision id="_93457522-533e-6dc8-404a-73d1afa491b1"><table id="req_gsml-lod_codelistURI" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_b2473cc3-338d-ce86-4367-c3b74387fb0f"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 9</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lod/codelistURI</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 3: <tt><xref style="id" target="req_class_gsml4-lob" id="_e1f32d4f-bae7-de59-2dcd-3932728b14de">{spec-part1-uri}/req/gsml-lod</xref><fmt-xref style="id" target="req_class_gsml4-lob">{spec-part1-uri}/req/gsml-lod</fmt-xref></tt></td></tr><tr id="_4eeb909a-c1f6-0ea7-3bd2-965489906207"><th>A</th><td><p id="_eeb8e5ec-ffcf-d61e-96a5-6f2bd0eb24e4" semx-id="_eeb8e5ec-ffcf-d61e-96a5-6f2bd0eb24e4">URI used for vocabulary terms SHALL be dereferenceable to one or more representations of the vocabulary term.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_b6f15e6e-aac6-aaf0-eef2-7f08a2453a55" semx-id="_b6f15e6e-aac6-aaf0-eef2-7f08a2453a55">The requirement described at 8.2.7  in Abstract Requirements Class demand that a vocabulary reference be encoded as a URI, but does not require that the URI actually resolve to anything (it could, but it is not required).  In this class, the target must ensure that the URI used to identify vocabulary terms SHALL dereference to one or more representations of a definition of the term (eg, RDF/SKOS, HTML, GML Definition, etc.)</p>
</clause>

<clause id="_08896013-ddf5-ea2a-aac7-6283b3be2d05" obligation="normative" semx-id="_08896013-ddf5-ea2a-aac7-6283b3be2d05">
<title id="_6701f924-4f62-02d0-94aa-b413431b3c82" semx-id="_cd4ae77f-5389-dc90-de89-61173f5ea56a">Identifier</title><fmt-title depth="3" id="_48061545-ca5c-df59-78a9-11394c0d077d"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>Identifier</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<requirement id="_d4d97ce0-bea2-42fe-a37f-a6025d2c1448" anchor="req_gsml-lod_identifier" model="ogc" semx-id="_5bf0194b-823f-5ac6-0c26-9e8132b885c9" autonum="10" original-id="req_gsml-lod_identifier"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 10: <tt><xref style="id" target="req_gsml-lod_identifier">/req/gsml-lod/identifier</xref></tt></fmt-xref-label> <identifier id="_2b738359-e04d-4c1e-a778-6a3c2c659c06">/req/gsml-lod/identifier</identifier><component class="part" semx-id="_ec503df9-8133-821a-bfdf-f41fcac3e0c9" original-id="_ec503df9-8133-821a-bfdf-f41fcac3e0c9"><p semx-id="_52ea4dda-e419-2e5a-747d-9f0229a259f9" original-id="_52ea4dda-e419-2e5a-747d-9f0229a259f9">HTTP URI used as entity identifiers SHALL be to one or more representations of that entity.</p>
</component>
<fmt-provision id="_5f8b86f8-f58a-62c6-d30d-e8a2ed3930bb"><table id="req_gsml-lod_identifier" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_cab5bc60-ad08-4931-c483-5b48b65c75c9"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 10</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lod/identifier</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 3: <tt><xref style="id" target="req_class_gsml4-lob" id="_e3ec85e9-1e58-1bda-5078-64c0a70102fe">{spec-part1-uri}/req/gsml-lod</xref><fmt-xref style="id" target="req_class_gsml4-lob">{spec-part1-uri}/req/gsml-lod</fmt-xref></tt></td></tr><tr id="_ec503df9-8133-821a-bfdf-f41fcac3e0c9"><th>A</th><td><p id="_52ea4dda-e419-2e5a-747d-9f0229a259f9" semx-id="_52ea4dda-e419-2e5a-747d-9f0229a259f9">HTTP URI used as entity identifiers SHALL be to one or more representations of that entity.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_0c18a446-9b72-9fe9-8b75-4efa34031e15" semx-id="_0c18a446-9b72-9fe9-8b75-4efa34031e15">This requirement demands that the target ensures that a data instance exposes a URI as a unique identifier for this feature and this identifier SHALL be dereferenceable to one or more representations of that feature.</p>

<requirement id="_6d3a6d9a-786d-4b5c-9187-6c406081acd0" anchor="req_gsml-lod_gsml-representation" model="ogc" semx-id="_44c827ee-65a4-554c-7e82-03f71fc4b3ab" autonum="11" original-id="req_gsml-lod_gsml-representation"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 11: <tt><xref style="id" target="req_gsml-lod_gsml-representation">/req/gsml-lod/gsml-representation</xref></tt></fmt-xref-label> <identifier id="_a5aebcfa-2da6-4a45-8b59-28a067918827">/req/gsml-lod/gsml-representation</identifier><component class="part" semx-id="_d41eadf7-29d3-d36e-16f6-c291530cbcd1" original-id="_d41eadf7-29d3-d36e-16f6-c291530cbcd1"><p semx-id="_9240375e-3cd2-9db2-73cc-464e7a9ca819" original-id="_9240375e-3cd2-9db2-73cc-464e7a9ca819">Dereferenceable HTTP URI used as identifiers SHOULD provide GeoSciML 5.0 as one of its representations.</p>
</component>
<fmt-provision id="_14e3ef71-6a21-6d40-1dd3-c9faf0bf926b"><table id="req_gsml-lod_gsml-representation" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_c7f39bab-96b7-a61e-9851-4196365c1582"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 11</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lod/gsml-representation</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 3: <tt><xref style="id" target="req_class_gsml4-lob" id="_4746faa2-fd78-4e9f-a6af-d5dfe9afb003">{spec-part1-uri}/req/gsml-lod</xref><fmt-xref style="id" target="req_class_gsml4-lob">{spec-part1-uri}/req/gsml-lod</fmt-xref></tt></td></tr><tr id="_d41eadf7-29d3-d36e-16f6-c291530cbcd1"><th>A</th><td><p id="_9240375e-3cd2-9db2-73cc-464e7a9ca819" semx-id="_9240375e-3cd2-9db2-73cc-464e7a9ca819">Dereferenceable HTTP URI used as identifiers SHOULD provide GeoSciML 5.0 as one of its representations.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_6ea6cf05-fb05-d8bf-ec2d-ea417f233ec0" semx-id="_6ea6cf05-fb05-d8bf-ec2d-ea417f233ec0">It is expected that one of the representations should be a XML (GML) or any GeoSciML compliant representations, including any profiles derived from this specification.</p>
</clause>

<clause id="_413548bb-0205-625f-87ac-1ddfc1c97bdd" obligation="normative" semx-id="_413548bb-0205-625f-87ac-1ddfc1c97bdd">
<title id="_ae661167-d7ea-d9fc-cb3b-5bcc0056ecb6" semx-id="_501fe4e7-105c-8dd8-62ae-11676845b036">ByReference associations</title><fmt-title depth="3" id="_c30d2cd2-e808-5d9a-3159-9df8c4e33a25"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span>ByReference associations</fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>3<span class="fmt-autonum-delim">.</span>3</fmt-xref-label>
<requirement id="_916fd20d-1d8f-4037-9e6e-7678ab6f4e24" anchor="req_gsml-lod_byref" model="ogc" semx-id="_160cadc8-1f5b-3bf6-da4a-e573bcc6ec80" autonum="12" original-id="req_gsml-lod_byref"><fmt-xref-label><span class="fmt-element-name">Requirement</span> 12: <tt><xref style="id" target="req_gsml-lod_byref">/req/gsml-lod/byref</xref></tt></fmt-xref-label> <identifier id="_bf107851-d06a-4716-881a-f74c3dca1dd8">/req/gsml-lod/byref</identifier><component class="part" semx-id="_5fb5ec58-d4d0-c334-0905-872407c0eddf" original-id="_5fb5ec58-d4d0-c334-0905-872407c0eddf"><p semx-id="_02a7a200-9316-409a-a0ae-d398dfe913da" original-id="_02a7a200-9316-409a-a0ae-d398dfe913da">External references to an entity conforming to [/req/gsml-lod/identifier] shall be expressed using this entity identifier.</p>
</component>
<fmt-provision id="_d7e1cd1b-e85e-f6ad-67e1-631c5d1ce0e6"><table id="req_gsml-lod_byref" type="recommend" class="modspec"><thead><tr><th scope="colgroup" colspan="2"><p class="RecommendationTitle"><fmt-name id="_1a313dc9-d8bf-12e5-37eb-ce80e83386ce"><span class="fmt-caption-label"><span class="fmt-element-name">Requirement</span> 12</span></fmt-name></p></th></tr></thead>
<tbody><tr><th>Identifier</th>
<td><tt>/req/gsml-lod/byref</tt></td>
</tr><tr><th>Included in</th><td><span class="fmt-element-name">Requirements class</span> 3: <tt><xref style="id" target="req_class_gsml4-lob" id="_e8463fdc-59e4-41ec-a293-0b759af53513">{spec-part1-uri}/req/gsml-lod</xref><fmt-xref style="id" target="req_class_gsml4-lob">{spec-part1-uri}/req/gsml-lod</fmt-xref></tt></td></tr><tr id="_5fb5ec58-d4d0-c334-0905-872407c0eddf"><th>A</th><td><p id="_02a7a200-9316-409a-a0ae-d398dfe913da" semx-id="_02a7a200-9316-409a-a0ae-d398dfe913da">External references to an entity conforming to [/req/gsml-lod/identifier] shall be expressed using this entity identifier.</p>
</td></tr></tbody></table></fmt-provision></requirement>

<p id="_9bf1be93-eb19-a856-7678-150c7477c0a0" semx-id="_9bf1be93-eb19-a856-7678-150c7477c0a0">Serialization of a dataset will often omit the full description of a feature and replace the property value with an external reference.  A reference to this feature is formed by the dereferenceable identifier described in clause 8.3.2. A client ingesting the dataset can use this reference to extract a feature representation if need be.  Over the web, this reference shall be a HTTP URI that can be dereferenced to one or more representations of that feature.</p>
</clause>
</clause>

<clause id="_689d6804-d2c1-ccea-e1c3-53863d7e42df" obligation="normative" semx-id="_689d6804-d2c1-ccea-e1c3-53863d7e42df">
