<title type="title-intro" format="text/plain" language="en" script="Latn">Geographic information</title>

  
<title type="title-main" format="text/plain" language="en" script="Latn">Spatial schema</title>

  
<title type="main" format="text/plain" language="en" script="Latn">Geographic information — Spatial schema</title>

  <uri type="src">https://www.iso.org/standard/26012.html</uri>
