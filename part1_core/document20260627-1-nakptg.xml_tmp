</tr><tr id="_092c5573-4f17-8c0e-27e2-45923b05d4a1" semx-id="_092c5573-4f17-8c0e-27e2-45923b05d4a1"><td id="_a4681e2c-8b4d-7154-70c0-db80106aa4ca" valign="middle" align="center" semx-id="_a4681e2c-8b4d-7154-70c0-db80106aa4ca"><strong>name</strong></td>
<td id="_7b7196f0-d751-f826-2346-9a525d92d3a9" valign="middle" align="center" semx-id="_7b7196f0-d751-f826-2346-9a525d92d3a9">specification:ShearDisplacementStructure::name <sup>1</sup></td>
